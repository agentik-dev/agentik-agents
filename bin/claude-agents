#!/usr/bin/env python3
"""claude-agents -- what every agent on this Mac is doing right now.

    claude-agents status [--json] [--watch N] [--all] [--since MIN]

One row per seat (a Claude Code session the session plugin keeps a dir for),
then one row per helper (a subagent transcript under that seat), and the lane
each one runs in: `seat`, `helper`, or `local` when agentroute's ledger says the
local model answered it.

Sources, all read-only (status writes nothing anywhere):

  the session plugin's dirs   ${XDG_STATE_HOME:-~/.local/state}/agentik-session/sessions/<sid>/
                              (the old claude-code-session/ while it is the one there);
                              (meter.json, measure.json, activity.json, turn-ended.json);
                              CLAUDE_AGENTS_SESSIONS_DIR overrides the sessions dir
  Claude Code's transcripts   the seat's transcript (its first 4 KB, for the cwd) and each
                              helper's subagents/agent-<id>.jsonl (first 4 KB, last 64 KB;
                              the cost scan streams it once) beside agent-<id>.meta.json
  agentroute's ledger         $AGENTROUTE_LOG, else ${AGENTROUTE_STATE_DIR:-…/agentik-agents/route}/requests.jsonl
                              (its last 2 MB)
                              The default folder falls back to its old name (agentroute/)
                              while that is the one that exists.

Only ids, model and tool names, numbers, timestamps and the `what` labels (a cwd
basename, a helper's description) leave this tool: never prompt, result or
tool-input text.

Exit codes: 0 whenever the read works (an empty table included); 1 when the
sessions dir cannot be read; 2 on a usage error. `--watch N` redraws every N
seconds until SIGINT, which exits 0.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import pathlib
import re
import signal
import sys
import time

HEAD_BYTES = 4 * 1024
TAIL_BYTES = 64 * 1024
LEDGER_BYTES = 2 * 1024 * 1024
SEAT_FILES = ("activity.json", "meter.json", "turn-ended.json")
ALL_CAP = 50
SEAT_BUSY_S = 60
SEAT_NOEND_BUSY_S = 120          # no turn-ended.json: busy only while the activity is this fresh
HELPER_BUSY_S = 120
WHAT_MAX = 40
WATCH_MAX = 86400
EPOCH_MIN, EPOCH_MAX = 946684800.0, 4102444800.0      # 2000-01-01 .. 2100-01-01: else not a time
COUNT_MAX = 10 ** 13                                  # a turn or token count past this is not one
FIELDS = ("id", "session_id", "agent_id", "parent", "lane", "model", "started", "elapsed_s",
          "turns", "context", "window", "cost_usd", "last_tool", "last_tool_at", "state", "what")
COLS = (("id", 10), ("lane", 6), ("model", 20), ("elapsed", 7), ("turns", 5), ("context", 11),
        ("cost", 7), ("last tool", 22), ("state", 5), ("what", 0))

# C0, DEL, C1, the line and paragraph separators and the bidi controls: never printed
CTRL_RE = re.compile("[\x00-\x1f\x7f-\x9f\u2028\u2029\u202a-\u202e\u2066-\u2069]")


# -- prices ---------------------------------------------------------------------

# USD per million tokens, (input, output), by canonical model name.
# Source: Anthropic first-party API list pricing.
# The 5.x rows are the claude-api skill's table (cached 2026-10-06, first-party list
# rates; packet a-s3 ruling 9), checked row by row against the Anthropic "Pricing"
# page (platform.claude.com/docs/en/about-claude/pricing) as of 2026-10-14.
# claude-sonnet-5 is the page's $2/$10: its footnote says Sonnet 5's launch price,
# introductory through 2026-08-31, is now its standard price (Pricing page, as of
# 2026-10-14; packet a-s7).
# claude-haiku-5-5 is the tier for prompts up to 100,000 tokens; see LONG_PROMPT_TIERS.
# The table moved here from the cost tool, whole (packet a-s17, ruling 4).
PRICES = {
    "claude-fable-5-1": (10.00, 50.00),
    "claude-opus-5-5": (4.00, 20.00),
    "claude-sonnet-5-5": (2.00, 10.00),
    "claude-haiku-5-5": (0.10, 0.50),
    "claude-fable-5": (10.00, 50.00),
    "claude-mythos-5": (10.00, 50.00),
    "claude-opus-5": (5.00, 25.00),
    "claude-opus-4-8": (5.00, 25.00),
    "claude-opus-4-7": (5.00, 25.00),
    "claude-opus-4-6": (5.00, 25.00),
    "claude-opus-4-5": (5.00, 25.00),
    "claude-sonnet-5": (2.00, 10.00),
    "claude-sonnet-4-6": (3.00, 15.00),
    "claude-sonnet-4-5": (3.00, 15.00),
    "claude-haiku-4-5": (1.00, 5.00),
}

# Cache-read rates in USD per million tokens, where the list names one. In
# predicted_cost such a rate overrides CACHE_READ_MULT below; every other model
# reads cache at the multiplier. (0.05x input on Opus 5.5 and Sonnet 5.5, 0.025x on
# Fable 5.1; Pricing page, as of 2026-10-14.)
CACHE_READ_RATES = {
    "claude-opus-5-5": 0.20,
    "claude-sonnet-5-5": 0.10,
    "claude-fable-5-1": 0.25,
}

# Prompt-length tiers: a request whose prompt (input + cache reads + cache writes)
# is over the threshold pays these (input, output) rates instead. Only Haiku 5.5
# has one (Pricing page, "Long context pricing", as of 2026-10-14: $0.50/$2.50 above
# 100,000, cache reads and writes following that input). Each message is one request,
# priced on its own (packet a-s7).
LONG_PROMPT_TIERS = {
    "claude-haiku-5-5": (100_000, (0.50, 2.50)),
}

# Cache multipliers against the model's input rate. The write is the 5-minute TTL's
# 1.25x; a 1-hour write is 2.0x, and a transcript does not record which it was, so a
# seat's own writes read low here (NICE_TO_HAVE.md). canonical() folds the `[1m]` variant
# into its base model: Claude 4.6 and later bill the whole 1M window at standard rates
# (Pricing page, "Long context pricing", as of 2026-10-14).
CACHE_READ_MULT = 0.10
CACHE_WRITE_MULT = 1.25


def canonical(name: str) -> str:
    """Strip variant and date suffixes: 'claude-opus-5[1m]' -> 'claude-opus-5'."""
    name = name.split("[")[0]
    parts = name.split("-")
    if parts and parts[-1].isdigit() and len(parts[-1]) == 8:  # trailing YYYYMMDD
        name = "-".join(parts[:-1])
    return name


def rates(model: str, prompt: int | None = None) -> tuple[float, float] | None:
    """List rates for a model and, given one request's prompt length (input + cache reads
    + cache writes), its long-prompt tier."""
    model = canonical(model)
    tier = LONG_PROMPT_TIERS.get(model)
    if tier and prompt is not None and prompt > tier[0]:
        return tier[1]
    return PRICES.get(model)


def predicted_cost(model: str, tok: dict, *, one_request: bool = False) -> float | None:
    """What the price table says these tokens cost, cache multipliers applied.

    `one_request` says the tokens are one request's, so a long-prompt tier applies by
    their prompt length; a total over several requests is priced at the base tier,
    since a sum of short requests can pass the threshold while none of them does."""
    prompt = tok["in"] + tok["cr"] + tok["cw"] if one_request else None
    r = rates(model, prompt)
    if r is None:
        return None
    inp, out = r
    # A per-model read rate is its base tier's; above a long-prompt threshold the read
    # follows the tier's input at the multiplier (Haiku 5.5: 0.50 x 0.1 = 0.05).
    cr_rate = (CACHE_READ_RATES.get(canonical(model), inp * CACHE_READ_MULT)
               if r == rates(model) else inp * CACHE_READ_MULT)
    return (tok["in"] * inp
            + tok["cr"] * cr_rate
            + tok["cw"] * inp * CACHE_WRITE_MULT
            + tok["out"] * out) / 1_000_000


# -- paths --------------------------------------------------------------------

def state_home() -> pathlib.Path:
    return pathlib.Path(os.environ.get("XDG_STATE_HOME") or (pathlib.Path.home() / ".local" / "state"))


def migrated(new: pathlib.Path, old: pathlib.Path) -> pathlib.Path:
    """agentik-r1 6.3: the new folder when it exists, else the old one when it exists, else
    the new. The env overrides are read before this and still win."""
    if new.exists():
        return new
    return old if old.exists() else new


def sessions_dir() -> pathlib.Path:
    """The session plugin's state folder (c1): agentik-session, else claude-code-session."""
    over = os.environ.get("CLAUDE_AGENTS_SESSIONS_DIR")
    if over:
        return pathlib.Path(over)
    return migrated(state_home() / "agentik-session", state_home() / "claude-code-session") / "sessions"


def ledger_path() -> pathlib.Path:
    """Found as agentroute finds it (bin/agentroute STATE_DIR / LOG_PATH)."""
    if os.environ.get("AGENTROUTE_LOG"):
        return pathlib.Path(os.environ["AGENTROUTE_LOG"])
    sd = os.environ.get("AGENTROUTE_STATE_DIR") or str(
        migrated(state_home() / "agentik-agents" / "route", state_home() / "agentroute"))
    return pathlib.Path(sd) / "requests.jsonl"


# -- small readers ------------------------------------------------------------

def read_json(path) -> dict:
    try:
        with open(path, "rb") as f:
            obj = json.loads(f.read(1024 * 1024))
    except (OSError, ValueError, TypeError):
        return {}
    return obj if isinstance(obj, dict) else {}


def read_head(path, n: int = HEAD_BYTES) -> bytes:
    try:
        with open(path, "rb") as f:
            return f.read(n)
    except (OSError, ValueError, TypeError):
        return b""


def head_lines(path, n: int = HEAD_BYTES) -> list:
    """The parsed lines wholly inside a file's first n bytes."""
    data = read_head(path, n)
    parts = data.split(b"\n")
    if len(data) >= n:
        parts = parts[:-1]          # the last may be cut
    return parse_lines([ln for ln in parts if ln.strip()])


def top_cwd(objs):
    """The basename of the first top-level `cwd` string among parsed lines; never a nested one."""
    for o in objs:
        c = o.get("cwd")
        if isinstance(c, str) and c.strip():
            b = os.path.basename(c.rstrip("/"))
            if b:
                return b
    return None


def read_tail(path, n: int) -> list:
    """The complete lines in a file's last n bytes, oldest first."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            start = max(0, size - n)
            f.seek(start)
            data = f.read(n)
    except (OSError, ValueError, TypeError):
        return []
    lines = data.split(b"\n")
    if start > 0:
        lines = lines[1:]           # the first may be the cut end of an older line
    return [ln for ln in lines if ln.strip()]


def parse_lines(lines) -> list:
    out = []
    for ln in lines:
        try:
            obj = json.loads(ln)
        except ValueError:
            continue
        if isinstance(obj, dict):
            out.append(obj)
    return out


def num(v):
    """A finite int or float, else None (bools, strings, NaN and infinities are not numbers)."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    if isinstance(v, float) and not math.isfinite(v):
        return None
    return v


def as_count(v):
    """A whole count in range, else None."""
    v = num(v)
    return int(v) if v is not None and 0 <= v < COUNT_MAX else None


def as_usd(v):
    v = num(v)
    return float(v) if v is not None and 0 <= v < 1e9 else None


def in_range(t):
    return t if t is not None and EPOCH_MIN <= t <= EPOCH_MAX else None


def to_epoch(v):
    """An epoch number or an ISO-8601 string (Z or offset; naive is local) -> epoch, else None."""
    if num(v) is not None:
        return in_range(float(v))       # milliseconds, 1e20 and the like are not times
    if not isinstance(v, str) or not v.strip():
        return None
    s = v.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    m = re.match(r"^(.*T\d\d:\d\d:\d\d)\.(\d+)(.*)$", s)
    if m:                            # 3.9's fromisoformat takes 3 or 6 fraction digits only
        s = f"{m.group(1)}.{(m.group(2) + '000000')[:6]}{m.group(3)}"
    try:
        d = dt.datetime.fromisoformat(s)
        if d.tzinfo is None:
            d = d.astimezone()
        return in_range(d.timestamp())
    except (ValueError, OverflowError, OSError):
        return None


def iso(t):
    if in_range(num(t)) is None:
        return None
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).isoformat(timespec="seconds")


def name_of(v):
    return v if isinstance(v, str) and v else None


# -- the ledger ---------------------------------------------------------------

def read_ledger(path) -> tuple:
    """(seats, helpers): the session ids whose every no-agent row took a local route, and the
    (session id, agent id) pairs with a `route: local` row, each with its newest model_out.
    Its last 2 MB only."""
    seat_rows, helpers = {}, {}
    for r in parse_lines(read_tail(path, LEDGER_BYTES)):
        sid = name_of(r.get("session_id"))
        if not sid:
            continue
        route = name_of(r.get("route")) or ""
        mo = name_of(r.get("model_out"))
        aid = name_of(r.get("agent_id"))
        if aid:
            if route != "local":
                continue
            aid = aid[len("agent-"):] if aid.startswith("agent-") else aid
            helpers[(sid, aid)] = mo or helpers.get((sid, aid))
        else:
            s = seat_rows.setdefault(sid, {"local": True, "model": None})
            if not route.startswith("local"):
                s["local"] = False
            elif mo:
                s["model"] = mo
    seats = {sid: s["model"] for sid, s in seat_rows.items() if s["local"]}
    return seats, helpers


# -- the cost scan --------------------------------------------------------------

class CostScan:
    """Streams a helper's transcript once and keeps each distinct message.id's usage
    (the last line that carries it wins). Under --watch it resumes from its offset."""

    def __init__(self):
        self.files = {}

    def scan(self, path) -> dict:
        try:
            st = os.stat(path)
        except (OSError, ValueError):
            return {"turns": None, "cost": None}
        c = self.files.get(path)
        if c is None or c["ino"] != st.st_ino or st.st_size < c["off"]:
            c = {"ino": st.st_ino, "off": 0, "rest": b"", "msgs": {}}
            self.files[path] = c
        try:
            with open(path, "rb") as f:
                f.seek(c["off"])
                while True:
                    chunk = f.read(1 << 20)
                    if not chunk:
                        break
                    c["off"] += len(chunk)
                    lines = (c["rest"] + chunk).split(b"\n")
                    c["rest"] = lines.pop()
                    for ln in lines:
                        self._line(c["msgs"], ln)
        except OSError:
            pass
        return self._sum(c["msgs"])

    @staticmethod
    def _line(msgs: dict, ln: bytes) -> None:
        if b'"assistant"' not in ln:
            return
        try:
            obj = json.loads(ln)
        except ValueError:
            return
        msg = obj.get("message") if isinstance(obj, dict) and obj.get("type") == "assistant" else None
        if not isinstance(msg, dict) or not name_of(msg.get("id")):
            return
        model = name_of(msg.get("model"))
        if model == "<synthetic>":
            return
        u = msg.get("usage") if isinstance(msg.get("usage"), dict) else {}
        tok = {"in": as_count(u.get("input_tokens")) or 0, "out": as_count(u.get("output_tokens")) or 0,
               "cr": as_count(u.get("cache_read_input_tokens")) or 0,
               "cw": as_count(u.get("cache_creation_input_tokens")) or 0}
        msgs[msg["id"]] = (model, tok)

    def _sum(self, msgs: dict) -> dict:
        total, known = 0.0, True
        for model, tok in msgs.values():
            if not any(tok.values()) or not known:
                continue
            # a message.id is one request, so a long-prompt tier applies by its prompt
            p = predicted_cost(model, tok, one_request=True) if model else None
            if p is None:
                known = False
                continue
            total += p
        return {"turns": len(msgs), "cost": round(total, 6) if known else None}


# -- rows -----------------------------------------------------------------------

def row(**kw) -> dict:
    r = dict.fromkeys(FIELDS)
    r.update(kw)
    return r


def subagents_dir(tpath):
    tp = pathlib.Path(tpath)
    return tp.parent / tp.stem / "subagents"


def helper_files(tpath) -> list:
    """[(mtime, agent id, path)] for a seat's subagent transcripts."""
    if not tpath:
        return []
    found = []
    try:
        with os.scandir(subagents_dir(tpath)) as it:
            for e in it:
                if not (e.name.startswith("agent-") and e.name.endswith(".jsonl")):
                    continue
                try:
                    found.append((e.stat().st_mtime, e.name[len("agent-"):-len(".jsonl")], pathlib.Path(e.path)))
                except OSError:
                    continue
    except (OSError, ValueError):
        return []
    return found


def list_seats(sdir: pathlib.Path, now: float, since_s: float, every: bool) -> list:
    """[(mtime, sid, path, meter, tpath, helpers)] newest first. A seat is live when any of its
    three files or any of its subagent transcripts changed within the window. Raises OSError
    when sdir cannot be read."""
    found = []
    with os.scandir(sdir) as it:
        for e in it:
            try:
                if not e.is_dir(follow_symlinks=False):
                    continue
            except OSError:
                continue
            mt = None
            for f in SEAT_FILES:
                try:
                    m = os.stat(os.path.join(e.path, f)).st_mtime
                except OSError:
                    continue
                mt = m if mt is None else max(mt, m)
            try:
                meter, tpath = seat_sources(pathlib.Path(e.path))
            except Exception:                           # noqa: BLE001
                meter, tpath = {}, None
            helpers = helper_files(tpath)
            if helpers:
                hm = max(h[0] for h in helpers)
                mt = hm if mt is None else max(mt, hm)
            if mt is None and every:
                try:
                    mt = e.stat(follow_symlinks=False).st_mtime
                except OSError:
                    mt = 0.0
            if mt is None or (not every and now - mt > since_s):
                continue
            found.append((mt, e.name, pathlib.Path(e.path), meter, tpath, helpers))
    found.sort(key=lambda x: (-x[0], x[1]))
    return found[:ALL_CAP] if every else found


def seat_sources(sdir: pathlib.Path) -> tuple:
    """A seat's meter.json and its transcript's path (None when unknown)."""
    meter = read_json(sdir / "meter.json")
    tr = meter.get("transcript") if isinstance(meter.get("transcript"), dict) else {}
    return meter, name_of(tr.get("path"))


def seat_row(sid: str, sdir: pathlib.Path, now: float, ledger: tuple, meter: dict, tpath) -> dict:
    measure = read_json(sdir / "measure.json")
    act = read_json(sdir / "activity.json")
    ended = read_json(sdir / "turn-ended.json")
    started = to_epoch(meter.get("started"))
    act_at = to_epoch(act.get("at"))
    ended_at = to_epoch(ended.get("at"))
    if ended_at is None:            # no turn has ended: busy only while the activity is fresh
        state = "busy" if act_at is not None and now - act_at < SEAT_NOEND_BUSY_S else "quiet"
    else:
        busy = act_at is not None and (act_at > ended_at or now - act_at < SEAT_BUSY_S)
        state = "busy" if busy else "idle"
    what = None
    if tpath:                       # the head first, then the tail's newest line that has one
        what = top_cwd(head_lines(tpath)) or top_cwd(reversed(parse_lines(read_tail(tpath, TAIL_BYTES))))
    cost = as_usd(measure.get("cost").get("usd")) if isinstance(measure.get("cost"), dict) else None
    model = name_of(meter.get("model"))
    lane = "seat"
    if sid in ledger[0]:            # the cost stays measure.json's: the whole session's
        lane, model = "local", ledger[0][sid] or model
    r = row(id=sid, session_id=sid, lane=lane, model=model, started=iso(started),
            elapsed_s=int(now - started) if started is not None else None,
            turns=as_count(meter.get("turns")), context=as_count(meter.get("context")),
            window=as_count(meter.get("window")),
            cost_usd=cost,
            last_tool=name_of(act.get("tool")), last_tool_at=iso(act_at),
            state=state, what=what)
    return r


def helper_row(sid: str, aid: str, path: pathlib.Path, mtime: float, now: float, meter: dict,
               ledger: tuple, scanner: CostScan) -> dict:
    meta = read_json(path.with_name(f"agent-{aid}.meta.json"))
    started = next((t for t in (to_epoch(o.get("timestamp")) for o in head_lines(path)) if t is not None), None)
    if started is None:              # a first line longer than 4 KB: the file's birth time
        try:
            started = in_range(num(getattr(os.stat(path), "st_birthtime", None)))
        except (OSError, ValueError):
            started = None
    lines = parse_lines(read_tail(path, TAIL_BYTES))
    newest = to_epoch(lines[-1].get("timestamp")) if lines else None
    if newest is None:
        newest = mtime
    model = newest_id = last_tool = tool_at = usage = None
    stops = set()
    for obj in reversed(lines):
        msg = obj.get("message")
        if obj.get("type") != "assistant" or not isinstance(msg, dict):
            continue
        if name_of(msg.get("model")) == "<synthetic>":
            continue
        if newest_id is None:
            newest_id = msg.get("id")
            model = name_of(msg.get("model"))
            usage = msg.get("usage") if isinstance(msg.get("usage"), dict) else None
        if msg.get("id") == newest_id:
            stops.add(msg.get("stop_reason"))
        if last_tool is None:
            blocks = msg.get("content") if isinstance(msg.get("content"), list) else []
            names = [b.get("name") for b in blocks if isinstance(b, dict) and b.get("type") == "tool_use"]
            if names and name_of(names[-1]):
                last_tool, tool_at = names[-1], to_epoch(obj.get("timestamp"))
        if newest_id is not None and last_tool is not None:
            break
    if "end_turn" in stops or last_tool == "SubagentHandback":
        state = "done"
    elif now - newest < HELPER_BUSY_S:
        state = "busy"
    else:
        state = "quiet"
    scan = scanner.scan(path)
    builders = meter.get("builders") if isinstance(meter.get("builders"), list) else []
    b = next((x for x in builders if isinstance(x, dict) and x.get("agent") == aid), None)
    if b is not None:
        turns, context = as_count(b.get("turns")), as_count(b.get("max_context"))
    else:
        turns = scan["turns"]
        context = None
        if usage is not None:
            context = as_count(sum(as_count(usage.get(k)) or 0 for k in
                                   ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")))
    lane, cost = "helper", scan["cost"]
    if (sid, aid) in ledger[1]:
        lane, model, cost = "local", ledger[1][(sid, aid)] or model, 0
    what = name_of(meta.get("description"))
    return row(id=aid, session_id=sid, agent_id=aid, parent=sid, lane=lane, model=model,
               started=iso(started), elapsed_s=int(now - started) if started is not None else None,
               turns=turns, context=context, window=None, cost_usd=cost, last_tool=last_tool,
               last_tool_at=iso(tool_at), state=state, what=what[:WHAT_MAX] if what else None)


def helpers_of(sid: str, files: list, now: float, since_s: float, every: bool, meter: dict,
               ledger: tuple, scanner: CostScan) -> list:
    found = [h for h in files if every or now - h[0] <= since_s]
    found.sort(key=lambda x: (-x[0], x[1]))
    rows = []
    for mt, aid, p in found:
        try:
            rows.append(helper_row(sid, aid, p, mt, now, meter, ledger, scanner))
        except Exception:                               # noqa: BLE001 -- one bad helper is one '-' row
            rows.append(row(id=aid, session_id=sid, agent_id=aid, parent=sid, lane="helper"))
    return rows


def collect(args, scanner: CostScan) -> dict:
    """The table. Raises OSError when the sessions dir cannot be read."""
    now = time.time()
    since_s = args.since * 60
    ledger = read_ledger(ledger_path())
    seats = list_seats(sessions_dir(), now, since_s, args.all)
    agents = []
    for _mt, sid, sdir, meter, tpath, files in seats:
        try:
            seat = seat_row(sid, sdir, now, ledger, meter, tpath)
        except Exception:                               # noqa: BLE001 -- one bad seat is one '-' row
            seat = row(id=sid, session_id=sid, lane="seat")
        agents.append(seat)
        try:
            agents.extend(helpers_of(sid, files, now, since_s, args.all, meter, ledger, scanner))
        except Exception:                               # noqa: BLE001
            pass
    agents = [sanitise(r) for r in agents]
    return {"generated": iso(now), "since_min": None if args.all else args.since, "agents": agents,
            "_now": now}


def sanitise(r: dict) -> dict:
    """Every field is null, a finite number or a string; nothing else leaves the tool."""
    out = {}
    for k in FIELDS:
        v = r.get(k)
        if isinstance(v, bool) or not isinstance(v, (int, float, str)):
            v = None
        elif isinstance(v, str):
            v = CTRL_RE.sub("?", v)
        else:
            v = num(v)
        out[k] = v
    return out


# -- the text form --------------------------------------------------------------

def fmt_age(s):
    if s is None:
        return "-"
    s = max(0, int(s))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}m"
    return f"{s // 86400}d{s % 86400 // 3600:02d}h"


def fmt_tokens(n):
    if n is None:
        return "-"
    if n < 1000:
        return str(n)
    if n < 1_000_000:
        return f"{n / 1000:.0f}k"
    return f"{n / 1e6:.1f}".rstrip("0").rstrip(".") + "M"


def fmt_cost(r):
    v = r["cost_usd"]
    if v is None:
        return "-"
    if r["lane"] == "local" and r["agent_id"]:
        return "0"
    if 0 < v < 0.005:
        return "<$0.01"
    return f"${v:.2f}"


def cells(r, now: float) -> list:
    rid = (r["id"] or "-")[:8]
    if r["agent_id"]:
        rid = "  " + rid
    model = r["model"] or "-"
    if model.startswith("claude-"):
        model = model[len("claude-"):]
    tool = "-"
    if r["last_tool"]:
        age = fmt_age(now - to_epoch(r["last_tool_at"])) if r["last_tool_at"] else "-"
        room = COLS[7][1] - len(age) - 1
        tool = f"{r['last_tool'][:room]} {age}"
    return [rid, r["lane"] or "-", model, fmt_age(r["elapsed_s"]),
            "-" if r["turns"] is None else str(r["turns"]),
            f"{fmt_tokens(r['context'])}/{fmt_tokens(r['window'])}",
            fmt_cost(r), tool, r["state"] or "-", r["what"] or "-"]


def line(vals) -> str:
    out = []
    for (name, w), v in zip(COLS, vals):
        out.append(v[:w].ljust(w) if w else v)
    return " ".join(out).rstrip()


def render_text(table: dict, args) -> str:
    out = [line([name for name, _w in COLS])]
    for r in table["agents"]:
        out.append(line(cells(r, table["_now"])))
    if not table["agents"]:
        out.append("no agents" if args.all else f"no agents in the last {args.since} min")
    return "\n".join(out)


def render_json(table: dict, indent) -> str:
    return json.dumps({k: v for k, v in table.items() if not k.startswith("_")}, indent=indent,
                      allow_nan=False)


def positive_int(s: str, top: int = 10 ** 9) -> int:
    try:
        v = int(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a whole number: {s!r}")
    if not 1 <= v <= top:
        raise argparse.ArgumentTypeError(f"must be 1 to {top}: {s!r}")
    return v


def watch_secs(s: str) -> int:
    return positive_int(s, WATCH_MAX)


def parse(argv) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog="claude-agents",
                                 description="What every agent on this Mac is doing right now.")
    sub = ap.add_subparsers(dest="verb", metavar="VERB")
    sub.required = True
    st = sub.add_parser("status", help="one row per seat, helper and local agent")
    st.add_argument("--json", action="store_true", help="print the table as one JSON object")
    st.add_argument("--watch", type=watch_secs, metavar="N",
                    help=f"redraw every N seconds (1 to {WATCH_MAX}) until ^C")
    st.add_argument("--all", action="store_true",
                    help=f"every session dir, newest first, at most {ALL_CAP}, and all their helpers")
    st.add_argument("--since", type=positive_int, default=30, metavar="MIN",
                    help="the window, in minutes (default 30)")
    return ap.parse_args(argv)


def draw(args, scanner: CostScan, clear: bool) -> int:
    try:
        table = collect(args, scanner)
    except OSError as e:
        print(f"claude-agents: cannot read the sessions dir {sessions_dir()}: {e.strerror or e}",
              file=sys.stderr)
        return 1
    if args.json:
        text = render_json(table, None if args.watch else 2)
    else:
        text = render_text(table, args)
        if clear:
            text = "\033[H\033[2J" + text
    print(text, flush=True)
    return 0


def main(argv=None) -> int:
    args = parse(sys.argv[1:] if argv is None else argv)
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    scanner = CostScan()
    if not args.watch:
        return draw(args, scanner, False)
    clear = sys.stdout.isatty() and not args.json
    try:
        while True:
            rc = draw(args, scanner, clear)
            if rc:
                return rc
            if not clear:
                print("", flush=True)
            time.sleep(args.watch)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
