#!/usr/bin/env bash
#
# claude-api-agent — run Claude Code headless, billed to an Anthropic API key
# (Claude Console project) instead of an interactive Team Premium seat.
#
# Design notes:
#   * Uses `claude --bare`, whose Anthropic auth is strictly ANTHROPIC_API_KEY
#     (or an apiKeyHelper supplied via --settings). OAuth and the keychain are
#     never read, so this cannot silently fall back to the subscription seat.
#   * Subscription credentials (CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_AUTH_TOKEN)
#     are unset in this process only. The parent shell is untouched, so the
#     plain `claude` command keeps using the Team Premium login.
#   * The key is stored SOPS-encrypted (age) and decrypted in memory per run.
#     It is never printed, echoed, logged, written to disk in plaintext, or
#     passed on any command line.
#
# Usage:
#   claude-api-agent [claude args...]         # forwards everything unchanged
#   claude-api-agent --profile <name> [...]   # apply a read-only role profile
#   claude-api-agent --no-stdin [...]         # don't wait on stdin
#   claude-api-agent --list-profiles          # show role profiles
#   claude-api-agent --setup-key              # secure entry, writes encrypted file
#   claude-api-agent --key-status             # report presence/permissions only
#   claude-api-agent --edit-key               # sops interactive edit of the secret
#   claude-api-agent --remove-key             # delete the encrypted secret
#   claude-api-agent --wrapper-help           # this wrapper's own help
#
# Key-management subcommands are recognized only as the SOLE argument, so they
# can never shadow a real prompt. Under --profile the wrapper parses the whole
# argument list against an allow-list (see "Caller-argument model" below), so
# wrapper options are recognized in any position; the prompt is delivered on
# stdin and never enters the child's argv.
#
# SECURITY NOTE: --add-dir does NOT confine the Read tool -- a delegated run can
# read any file this user can read. Profiles ship a credential deny-list, but a
# deny-list is defense in depth, not a boundary. Never delegate a run over
# untrusted content: instructions embedded in a file the delegate reads are
# an exfiltration path. See README.md.

set -euo pipefail

# Defensive: never let inherited shell tracing echo the secret.
set +x
unset -v BASH_XTRACEFD 2>/dev/null || true
export PS4=''

PROG="$(basename -- "$0")"

# Resolve the repo root through any symlink (e.g. ~/bin/claude-api-agent).
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
    SELF="$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")"
fi
REPO_ROOT="$(cd -- "$(dirname -- "$SELF")/.." && pwd)"

# The SOPS-encrypted secret lives outside the repo, in the secrets directory:
# $AGENTIK_AGENTS_SECRETS, else ${XDG_CONFIG_HOME:-$HOME/.config}/agentik/agents/secrets.
# Override the file itself with CLAUDE_API_AGENT_SECRET_FILE.
SECRETS_DIR="${AGENTIK_AGENTS_SECRETS:-${XDG_CONFIG_HOME:-$HOME/.config}/agentik/agents/secrets}"
SECRET_FILE="${CLAUDE_API_AGENT_SECRET_FILE:-${SECRETS_DIR%/}/anthropic-api-key.sops.yaml}"
SECRET_KEY_NAME='anthropic_api_key'

# Optional plaintext fallback, used only if the SOPS file is absent.
PLAIN_DIR="${HOME}/.config/claude-code"
PLAIN_FILE="${PLAIN_DIR}/api-key"

# Records the known-good proxy on the key's egress path. Not a secret -- it is
# infrastructure configuration, and it is meant to be reviewed in diffs.
# The proxy pin names one machine's network, so it lives outside the repo, in the config
# home; CLAUDE_API_AGENT_PROXY_PIN_FILE overrides it. A missing file is "no pin".
PROXY_PIN_FILE="${CLAUDE_API_AGENT_PROXY_PIN_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/agentik/agents/proxy-pin.conf}"

# stat(1) differs: GNU takes -c, BSD/macOS takes -f. Without this, --key-status and
# `make doctor` print "stat: illegal option -- c" instead of a permission mode.
file_mode() {
    stat -f '%Lp' -- "$1" 2>/dev/null || stat -c '%a' -- "$1" 2>/dev/null || printf ''
}

die() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    exit "${2:-1}"
}

warn() {
    printf '%s: %s\n' "$PROG" "$1" >&2
}

need_tool() {
    command -v "$1" >/dev/null 2>&1 \
        || die "'$1' is required but not on PATH. Install it, then retry." 127
}

# ---------------------------------------------------------------------------
# Locate the claude executable.
# CLAUDE_API_AGENT_CLAUDE_BIN overrides discovery (useful for pinned installs).
# ---------------------------------------------------------------------------
find_claude() {
    local candidate
    if [[ -n "${CLAUDE_API_AGENT_CLAUDE_BIN:-}" ]]; then
        if [[ -x "$CLAUDE_API_AGENT_CLAUDE_BIN" ]]; then
            printf '%s' "$CLAUDE_API_AGENT_CLAUDE_BIN"
            return 0
        fi
        die "CLAUDE_API_AGENT_CLAUDE_BIN is set but not executable: ${CLAUDE_API_AGENT_CLAUDE_BIN}"
    fi

    if candidate="$(command -v claude 2>/dev/null)"; then
        printf '%s' "$candidate"
        return 0
    fi

    for candidate in "${HOME}/.local/bin/claude" /usr/local/bin/claude; do
        if [[ -x "$candidate" ]]; then
            printf '%s' "$candidate"
            return 0
        fi
    done

    die "cannot find the 'claude' executable on PATH. Install Claude Code, or set CLAUDE_API_AGENT_CLAUDE_BIN=/path/to/claude." 127
}

# ---------------------------------------------------------------------------
# Decrypt the SOPS secret into the global API_KEY. Never echoes the value.
# sops' own stderr is allowed through: it is diagnostic and contains no
# plaintext (e.g. "no key could decrypt the data").
# ---------------------------------------------------------------------------
read_sops_key() {
    need_tool sops
    API_KEY=''

    [[ -r "$SECRET_FILE" ]] || die "encrypted secret is not readable: ${SECRET_FILE}"

    local value=''
    if ! value="$(sops decrypt --extract "[\"${SECRET_KEY_NAME}\"]" -- "$SECRET_FILE")"; then
        die "could not decrypt ${SECRET_FILE}.
  Check that your age private key is present (default: ~/.config/sops/age/keys.txt)
  or set SOPS_AGE_KEY_FILE to its location."
    fi

    value="${value%$'\r'}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"

    [[ -n "$value" ]] || die "the decrypted ${SECRET_KEY_NAME} is empty.
  Re-enter it with:  ${PROG} --setup-key"

    API_KEY="$value"
}

# ---------------------------------------------------------------------------
# Plaintext fallback (only consulted when the SOPS file does not exist).
# ---------------------------------------------------------------------------
read_plain_key() {
    API_KEY=''
    [[ -r "$PLAIN_FILE" ]] || die "key file exists but is not readable: ${PLAIN_FILE}"

    local perms
    perms="$(file_mode "$PLAIN_FILE")"
    if [[ -n "$perms" && "$perms" != "600" ]]; then
        warn "key file permissions are ${perms}, expected 600. Fix with: chmod 600 ${PLAIN_FILE}"
    fi

    local line
    IFS= read -r line < "$PLAIN_FILE" || line=''
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    [[ -n "$line" ]] || die "key file is empty: ${PLAIN_FILE}
  Store a key with:  ${PROG} --setup-key"

    API_KEY="$line"
}

# ---------------------------------------------------------------------------
# --setup-key : hidden prompt -> SOPS-encrypted file. No plaintext ever
# touches the disk, and the key never appears in argv or shell history.
# ---------------------------------------------------------------------------
setup_key() {
    need_tool sops
    [[ -e /dev/tty ]] || die "--setup-key needs an interactive terminal."

    if [[ -s "$SECRET_FILE" ]]; then
        printf 'An encrypted key already exists at %s\n' "$SECRET_FILE" >&2
        printf 'Replace it? [y/N] ' >&2
        local reply=''
        IFS= read -r reply < /dev/tty || reply=''
        case "$reply" in
            y|Y|yes|YES) : ;;
            *) printf 'Left the existing key unchanged.\n' >&2; return 0 ;;
        esac
    fi

    # The secrets directory is private to this user (0700), like the file (0600).
    (umask 077; mkdir -p -- "$(dirname -- "$SECRET_FILE")") \
        || die "could not create $(dirname -- "$SECRET_FILE")"

    local key1='' key2=''
    printf 'Paste the Anthropic API key (input hidden): ' >&2
    IFS= read -rs key1 < /dev/tty || true
    printf '\n' >&2
    printf 'Re-enter to confirm: ' >&2
    IFS= read -rs key2 < /dev/tty || true
    printf '\n' >&2

    # Trim whitespace that commonly rides along with a paste.
    key1="${key1#"${key1%%[![:space:]]*}"}"; key1="${key1%"${key1##*[![:space:]]}"}"
    key2="${key2#"${key2%%[![:space:]]*}"}"; key2="${key2%"${key2##*[![:space:]]}"}"

    if [[ -z "$key1" ]]; then
        unset -v key1 key2; die "no key entered; nothing written."
    fi
    if [[ "$key1" != "$key2" ]]; then
        unset -v key1 key2; die "the two entries did not match; nothing written."
    fi
    if [[ "$key1" != sk-ant-* ]]; then
        warn "the value entered does not start with 'sk-ant-'; encrypting it anyway."
    fi

    # Single-quoted YAML scalar with internal quotes doubled.
    local escaped="${key1//\'/\'\'}"

    local tmp
    tmp="$(umask 077; mktemp -- "${TMPDIR:-/tmp}/.cak.XXXXXX")" \
        || { unset -v key1 key2 escaped; die "could not create a temporary file"; }
    # Single-quoted body: $tmp is expanded when the trap fires, not now. A
    # double-quoted body would embed the path literally, so a TMPDIR containing
    # a single quote would break out of the quoting and run arbitrary commands.
    trap 'rm -f -- "$tmp"' EXIT

    # Plaintext reaches sops only through a pipe, and `printf` is a shell
    # builtin -- so the key never appears in any process's argv (i.e. never in
    # `ps` output or /proc/PID/cmdline). Do not "simplify" this to an external
    # printf/echo, and never pass the key as a sops argument.
    if ! printf "%s: '%s'\n" "$SECRET_KEY_NAME" "$escaped" \
        | (cd -- "$REPO_ROOT" && sops encrypt \
              --filename-override "$SECRET_FILE" \
              --input-type yaml --output-type yaml /dev/stdin) > "$tmp"; then
        unset -v key1 key2 escaped
        die "sops failed to encrypt the key; the stored secret was not modified."
    fi
    unset -v key1 key2 escaped

    [[ -s "$tmp" ]] || die "sops produced an empty file; the stored secret was not modified."
    grep -q 'ENC\[' "$tmp" \
        || die "refusing to save: sops output does not look encrypted."

    mv -f -- "$tmp" "$SECRET_FILE"
    chmod 600 -- "$SECRET_FILE"
    trap - EXIT

    printf 'Encrypted key written to %s (mode %s).\n' \
        "$SECRET_FILE" "$(file_mode "$SECRET_FILE")" >&2
    printf 'It lives outside the repo; back it up with your other secrets, never commit it.\n' >&2
}

# ---------------------------------------------------------------------------
# --key-status : metadata only, never the value
# ---------------------------------------------------------------------------
key_status() {
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        printf 'ANTHROPIC_API_KEY: set in environment (takes precedence, %d chars)\n' \
            "${#ANTHROPIC_API_KEY}"
    else
        printf 'ANTHROPIC_API_KEY: not set in environment\n'
    fi

    printf 'repo root:         %s\n' "$REPO_ROOT"

    if [[ -e "$SECRET_FILE" ]]; then
        printf 'sops secret:       %s (mode %s)\n' \
            "$SECRET_FILE" "$(file_mode "$SECRET_FILE")"
        if command -v sops >/dev/null 2>&1; then
            local v=''
            if v="$(sops decrypt --extract "[\"${SECRET_KEY_NAME}\"]" -- "$SECRET_FILE" 2>/dev/null)"; then
                v="${v%$'\r'}"
                v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
                printf 'decrypt check:     OK (%d chars recovered)\n' "${#v}"
                unset -v v
            else
                printf 'decrypt check:     FAILED (age private key missing or wrong?)\n'
            fi
        fi
    else
        printf 'sops secret:       %s (missing)\n' "$SECRET_FILE"
    fi

    if [[ -e "$PLAIN_FILE" ]]; then
        printf 'plain fallback:    %s (mode %s)\n' \
            "$PLAIN_FILE" "$(file_mode "$PLAIN_FILE")"
    else
        printf 'plain fallback:    none (%s absent)\n' "$PLAIN_FILE"
    fi

    if [[ -r "${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}" ]]; then
        local akf="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
        printf 'age key file:      %s (mode %s)\n' "$akf" "$(file_mode "$akf")"
    else
        printf 'age key file:      not found\n'
    fi

    # Assign first: find_claude's die() would only exit a command substitution,
    # leaving --key-status reporting an empty field and still returning 0 on a
    # broken installation.
    local bin=''
    if bin="$(find_claude 2>/dev/null)" && [[ -n "$bin" ]]; then
        printf 'claude binary:     %s\n' "$bin"
    else
        printf 'claude binary:     NOT FOUND\n'
        return 1
    fi
}

# ---------------------------------------------------------------------------
# --edit-key : hand off to `sops edit` (opens $EDITOR on decrypted content)
# ---------------------------------------------------------------------------
edit_key() {
    need_tool sops
    [[ -e "$SECRET_FILE" ]] || die "no encrypted secret at ${SECRET_FILE}
  Create one with:  ${PROG} --setup-key"
    cd -- "$REPO_ROOT"
    exec sops edit -- "$SECRET_FILE"
}

# ---------------------------------------------------------------------------
# --remove-key : confirmed deletion of the encrypted secret
# ---------------------------------------------------------------------------
remove_key() {
    [[ -e "$SECRET_FILE" ]] || {
        printf 'No encrypted secret at %s; nothing to remove.\n' "$SECRET_FILE" >&2
        return 0
    }
    printf 'Delete %s? [y/N] ' "$SECRET_FILE" >&2
    local reply=''
    IFS= read -r reply < /dev/tty || reply=''
    case "$reply" in
        y|Y|yes|YES)
            rm -f -- "$SECRET_FILE"
            printf 'Removed %s\n' "$SECRET_FILE" >&2
            printf 'Note: prior commits still contain the old ciphertext. Rotate the key in the Claude Console.\n' >&2
            ;;
        *) printf 'Kept %s\n' "$SECRET_FILE" >&2 ;;
    esac
}

# ---------------------------------------------------------------------------
# Role profiles — canned flag sets for delegated (agent-style) runs.
#
# Every profile is READ-ONLY, enforced by --tools "Read Grep Glob", which
# restricts the built-in toolset so Bash/Edit/Write are NOT PRESENT (the model
# reports no such tool). Verified against real claude.
#
# --tools is load-bearing; the others are not sufficient on their own.
# --allowedTools + --permission-mode dontAsk was the original design and it did
# NOT restrict anything: dontAsk means "proceed without prompting the human",
# and --allowedTools PRE-APPROVES a set rather than restricting to it, so Bash
# ran freely with an empty permission_denials array (a red-team caught this;
# reproduced here). --allowedTools/--disallowedTools/dontAsk are kept as
# defense in depth -- they pre-approve the intended tools, suppress prompts,
# and deny-list credential paths for whatever Read/Grep/Glob access remains --
# but the actual boundary is --tools. Because a tool absent from --tools cannot
# be invoked at all, the deny-list is now a genuine second layer rather than
# the only (and, it turned out, illusory) one.
#
# Each profile also sets --max-budget-usd as a runaway ceiling, and
# --exclude-dynamic-system-prompt-sections so repeated calls reuse the prompt
# cache (cache reads bill at ~0.1x input vs ~1.25x for a write).
#
# Claude Code resolves a repeated flag first-wins, so simply emitting profile
# flags ahead of the caller's would make the profile unoverridable. Instead,
# drop_overridden_profile_args() removes any profile flag the caller also
# passes, so an explicit command-line flag genuinely takes precedence.
# ---------------------------------------------------------------------------
PROFILE_BUDGET_USD="${CLAUDE_API_AGENT_BUDGET_USD:-10}"
# Validated so a malformed env value fails here with a clear message rather
# than being handed to claude as an opaque --max-budget-usd argument.
[[ "$PROFILE_BUDGET_USD" =~ ^[0-9]+([.][0-9]+)?$ ]] \
    || die "CLAUDE_API_AGENT_BUDGET_USD must be a non-negative number, got: ${PROFILE_BUDGET_USD}"

READONLY_TOOLS='Read Grep Glob'

# Appended to every role prompt.
#
# Measured: 3 of 4 delegated runs that attempted a denied tool went on to return
# schema-valid placeholder output, having burned full cost first -- one spent
# $2.15 across 14 turns and 653 seconds before giving up. Those runs were not
# asked to do anything impossible. They were asked for evidence, reached for
# Bash to get it, were refused by the harness, and had no better move, because
# nothing had ever told them what they could actually do.
#
# A second measured failure (2026-08-19, analyze run): the old text promised
# Grep and Glob, which claude --bare drops silently, so the delegate burned
# turns discovering "No such tool available" and then worked blind. The text
# now states the real toolset: Read, alone.
#
# So tell them. The last sentence carries most of the value: without an explicit
# way to report "this cannot be settled from source alone", a model treats the
# dead end as an obstacle to route around rather than a result to report, and
# thrashing to a placeholder is what that looks like from outside.
TOOL_LIMITS='
Your one working tool is Read, by exact file path. The profile allow-lists Read,
Grep and Glob, but this session runs under claude --bare, where Grep and Glob do
not exist -- the harness drops the names silently, and a Read on a directory
fails. There is no shell, no test run, no way to invoke a binary or observe
runtime behaviour; Bash and Edit are refused, so attempting any of these spends
budget and returns nothing.
Navigate by Reading the exact paths the prompt names, and the paths those files
name in turn (imports, links, includes). When you need a file you cannot locate,
or a listing only a shell could produce, say so in your report and name the
paths or globs you needed: reporting the limit is a useful answer, and it beats
guessing or abandoning the task.'

# --add-dir does NOT confine Read: a delegated run can otherwise read any file
# this user can read, anywhere on the filesystem. Verified by probe. That makes
# prompt injection inside reviewed content an exfiltration path, so deny the
# highest-value credential targets explicitly.
#
# This is defense in depth, NOT a security boundary -- a deny-list is
# inherently incomplete. For genuinely untrusted input, run the delegate as a
# separate Unix user or in a container that cannot see $HOME.
#
# Path syntax is Claude Code's: '~/...' for home-relative, '//...' for
# absolute. A single leading slash matches nothing and fails silently.
# Under `--bare` the delegate's actual toolset is Bash, Edit, Read (verified by
# probe -- Grep and Glob are NOT present). Bash/Edit are contained by not being
# allow-listed. Deny rules are still emitted for Grep and Glob so the list does
# not silently become bypassable if those tools appear in a future version or
# without --bare: Grep in content mode returns file contents, Glob leaks listings.
DENY_PATHS=(
    '~/.ssh/**'
    '~/.gnupg/**'
    '~/.aws/**'
    '~/.config/gh/**'
    '~/.kube/**'
    '~/.docker/**'
    '~/.netrc'
    '~/.config/claude-code/**'
    '~/.claude/**'
    # ~/.claude.json is a FILE, so ~/.claude/** does not match it -- and it
    # holds oauthAccount identifiers plus per-project mcpServers definitions
    # whose env/headers blocks routinely carry API tokens.
    '~/.claude.json'
    '~/.config/sops/**'
    # Other common credential stores a delegated run has no reason to read.
    '~/.git-credentials'
    '~/.npmrc'
    '~/.pypirc'
    '~/.config/gcloud/**'
    '~/.password-store/**'
    '~/.local/share/keyrings/**'
    '//proc/**'
)

# The age identity decrypts this repo's secret, so deny it wherever it actually
# lives -- SOPS_AGE_KEY_FILE may point outside the default directory.
_age_key="${SOPS_AGE_KEY_FILE:-}"
# A relative SOPS_AGE_KEY_FILE (`keys.txt`, `./secrets/keys.txt`) matches
# neither branch below, so no deny rule would be emitted at all and the age
# private key -- which decrypts this repo's API key -- would stay readable by a
# delegated run. Resolve it against the current directory first.
if [[ -n "$_age_key" && "$_age_key" != /* ]]; then
    _age_key="${PWD%/}/${_age_key#./}"
fi
if [[ -n "$_age_key" ]]; then
    _age_dir="$(dirname -- "$_age_key")"
    case "$_age_key" in
        "$HOME"/*) DENY_PATHS+=("~/${_age_key#"$HOME"/}" "~/${_age_dir#"$HOME"/}/**") ;;
        /*)        DENY_PATHS+=("/${_age_key}" "/${_age_dir}/**") ;;
    esac
    unset -v _age_dir
fi
unset -v _age_key

DENY_READS=''
for _p in "${DENY_PATHS[@]}"; do
    for _t in Read Grep Glob; do
        DENY_READS+="${DENY_READS:+ }${_t}(${_p})"
    done
done
unset -v _p _t

FINDINGS_SCHEMA='{
  "type": "object",
  "properties": {
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "issue": {"type": "string"},
          "suggestion": {"type": "string"}
        },
        "required": ["file", "severity", "issue"],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "findings"],
  "additionalProperties": false
}'

REVIEW_ROLE='You are reviewing code read-only. Report only actionable defects:
correctness bugs, security issues, resource leaks, incorrect error handling,
race conditions. Do not report style preferences, naming opinions, or
speculative refactors. Cite a file and line for every finding. If nothing is
actionable, return an empty findings array rather than padding the list.'"${TOOL_LIMITS}"

EXPLORE_ROLE='You are investigating a codebase read-only. Answer the question
asked, directly, and cite file:line for every claim you make. Do not propose
changes or write code. If the answer is not in the files you can read, say so
rather than inferring.'"${TOOL_LIMITS}"

ANALYZE_ROLE='You are analyzing a system read-only. Reason carefully before
answering. Cite file:line evidence for load-bearing claims, and state
uncertainty explicitly rather than guessing. Do not propose changes unless
asked.'"${TOOL_LIMITS}"

# Record the proxy currently on the key's egress path, so a later change is
# reported. Writes the value verbatim; there is nothing secret in it.
pin_proxy() {
    local pv val=''
    for pv in HTTPS_PROXY https_proxy ALL_PROXY all_proxy; do
        if [[ -n "${!pv:-}" ]]; then val="${!pv}"; break; fi
    done

    if [[ -z "$val" ]]; then
        if [[ -e "$PROXY_PIN_FILE" ]]; then
            printf 'No proxy is set. Remove the existing pin (%s)? [y/N] ' "$PROXY_PIN_FILE" >&2
            local reply; read -r reply
            [[ "$reply" == [yY]* ]] || { printf 'Left unchanged.\n' >&2; return 0; }
            rm -f -- "$PROXY_PIN_FILE"
            printf 'Pin removed.\n' >&2
        else
            printf 'No proxy is set and no pin exists; nothing to do.\n' >&2
        fi
        return 0
    fi

    (umask 077; mkdir -p -- "$(dirname -- "$PROXY_PIN_FILE")") \
        || die "could not create $(dirname -- "$PROXY_PIN_FILE")"
    ( umask 077; {
        printf '# Known-good proxy on the API key'"'"'s egress path.\n'
        printf '# A run whose proxy differs from this value prints a warning.\n'
        printf '# Re-pin with: %s --pin-proxy\n' "$PROG"
        printf '%s\n' "$val"
    } > "$PROXY_PIN_FILE" ) || die "could not write ${PROXY_PIN_FILE}"
    chmod 600 -- "$PROXY_PIN_FILE" || die "could not set ${PROXY_PIN_FILE} to mode 600"

    printf 'Pinned proxy: %s\n  written to: %s\n' "$val" "$PROXY_PIN_FILE" >&2
}

list_profiles() {
    cat <<EOF
Read-only role profiles (the Read tool, by exact path; Grep/Glob are absent under --bare):

  review    Structured code review. Sonnet 5, medium effort.
            JSON schema output -> .structured_output.{summary,findings[]}
  explore   Cheap read-only recon ("where is X", "how does Y work").
            Sonnet 5, low effort. Prose result.
  analyze   Hard read-only reasoning. Opus 5, high effort. Prose result.

Per-run spend ceiling: \$${PROFILE_BUDGET_USD} (override with CLAUDE_API_AGENT_BUDGET_USD).
EOF
}

# Populates the global PROFILE_ARGS array for the named profile.
resolve_profile() {
    local name="$1"
    local common=(
        --tools "$READONLY_TOOLS"
        --allowedTools "$READONLY_TOOLS"
        --disallowedTools "$DENY_READS"
        --permission-mode dontAsk
        --max-budget-usd "$PROFILE_BUDGET_USD"
        --exclude-dynamic-system-prompt-sections
        --output-format json
    )
    case "$name" in
        review)
            PROFILE_ARGS=("${common[@]}"
                --model claude-sonnet-5 --effort medium
                --json-schema "$FINDINGS_SCHEMA"
                --append-system-prompt "$REVIEW_ROLE")
            ;;
        explore)
            PROFILE_ARGS=("${common[@]}"
                --model claude-sonnet-5 --effort low
                --append-system-prompt "$EXPLORE_ROLE")
            ;;
        analyze)
            PROFILE_ARGS=("${common[@]}"
                --model claude-opus-5 --effort high
                --append-system-prompt "$ANALYZE_ROLE")
            ;;
        *)
            die "unknown profile: ${name}
  Known profiles: review, explore, analyze
  List them with:  ${PROG} --list-profiles"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Caller-argument model under --profile: ALLOW-LIST with a total parse.
#
# The previous model DENY-listed the caller flags that could dissolve
# containment and forwarded everything else. That model loses by construction,
# and it lost: `claude`'s flag surface is large, versioned, and owned by
# another repo, so any release can add a flag that grants back what the profile
# removed (--dangerously-skip-permissions, --tools, --settings with inline
# JSON, --agents), and the wrapper finds out only when someone reads a
# changelog. It also required a hand-maintained table of which flags take a
# value, in order to find "real" flag positions in `claude`'s grammar -- and a
# single wrong entry shifted scan parity and produced a silently uncapped run.
#
# Inverted here. Under --profile the wrapper does not FILTER the caller's argv;
# it CONSTRUCTS the child's argv. Four invariants hold by construction:
#
#   1. Total parse. Every caller token is a wrapper option, an allow-listed
#      claude flag, or the value of one. There is no "forward the rest" branch.
#   2. No caller free text in argv. The prompt travels on stdin, so nothing the
#      caller types can be re-read as a flag by `claude`'s parser -- and this
#      wrapper never has to know whether `claude` honours a `--` marker.
#   3. A flag value may not begin with '-', so a value cannot smuggle a flag.
#   4. Flag positions are known exactly, because the wrapper wrote them. No
#      scan of another repo's grammar decides anything security-bearing.
#
# A `claude` flag added in a future release is refused until it is deliberately
# added to profile_flag_allowed(). That is the intended failure mode: friction,
# not exposure.
#
# Allow-listed caller flags, and their arity (1 = consumes one value, 0 =
# boolean). An arity error here CANNOT fail open: a flag wrongly marked boolean
# leaves its value unconsumed, which hits the positional branch and refuses;
# a flag wrongly marked value-taking eats the next token, which either begins
# with '-' (rejected) or leaves ITS successor unconsumed (refused). Either way
# the run stops loudly instead of running with a shifted parity. tests/ pins
# each entry against the installed `claude`, so rot fails in CI, not at runtime.
FLAG_ARITY=0
profile_flag_allowed() {
    case "$1" in
        --model|--fallback-model|--effort|--max-budget-usd|--add-dir)
            FLAG_ARITY=1; return 0 ;;
    esac
    FLAG_ARITY=0
    return 1
}

# Validate a flag's value. The leading-dash rule is the load-bearing one: it
# holds for every flag, present and future, and stops a value from being read
# as a flag regardless of how `claude`'s parser treats a '-'-prefixed argument.
validate_flag_value() {
    local flag="$1" val="$2"
    [[ "$val" != -* ]] \
        || die "refusing to run: the value for ${flag} begins with '-' (${val}).
  A value that looks like a flag is refused under --profile, because whether
  claude reads it as a value or as a flag is not this wrapper's to decide."
    [[ -n "$val" ]] || die "${flag} was given an empty value"
    case "$flag" in
        --max-budget-usd)
            [[ "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] \
                || die "--max-budget-usd must be a non-negative number, got: ${val}" ;;
        --model|--fallback-model)
            [[ "$val" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] \
                || die "${flag} must be a model name, got: ${val}" ;;
        --effort)
            [[ "$val" =~ ^(low|medium|high)$ ]] \
                || die "--effort must be low, medium, or high, got: ${val}" ;;
        --add-dir)
            [[ -d "$val" ]] \
                || die "--add-dir must name an existing directory, got: ${val}" ;;
    esac
}

# The caller's parsed flag names, populated by parse_profile_args. Override
# detection is exact set membership over THIS, never a positional scan of an
# argument list whose grammar belongs to claude.
CALLER_FLAGS=()

caller_passed() {
    local f
    for f in "${CALLER_FLAGS[@]+"${CALLER_FLAGS[@]}"}"; do
        [[ "$f" == "$1" ]] && return 0
    done
    return 1
}

# Profile flags that take no value. Any valueless flag used in a profile MUST
# be listed here, or the pair-walk below mis-reads the array and silently
# corrupts the argument list.
PROFILE_VALUELESS_FLAGS=(
    --exclude-dynamic-system-prompt-sections
)

is_valueless_flag() {
    local f
    for f in "${PROFILE_VALUELESS_FLAGS[@]}"; do
        [[ "$1" == "$f" ]] && return 0
    done
    return 1
}

# Exact set membership over the profile's own array, walked in pairs. Used by
# the drop and by the post-assembly invariant, so neither depends on scanning a
# flattened argument list whose grammar is claude's.
profile_args_have() {
    local i=0 n=${#PROFILE_ARGS[@]} flag width
    while (( i < n )); do
        flag="${PROFILE_ARGS[i]}"
        if is_valueless_flag "$flag"; then width=1; else width=2; fi
        [[ "$flag" == "$1" ]] && return 0
        (( i += width ))
    done
    return 1
}

# Remove profile flags the caller also passed, so caller flags win.
# caller_passed() is exact -- the caller's flags were parsed, not guessed --
# so the old positional heuristic and its fail-open parity bug are gone.
drop_overridden_profile_args() {
    local -a kept=()
    local i=0 n=${#PROFILE_ARGS[@]} flag width
    while (( i < n )); do
        flag="${PROFILE_ARGS[i]}"
        if is_valueless_flag "$flag"; then
            width=1
        else
            width=2
        fi

        # Effort support is model-specific (Haiku 4.5 rejects --effort with a
        # hard API error), so a caller-supplied --model invalidates the
        # profile's --effort. Drop it and let the caller set their own.
        if [[ "$flag" == "--effort" ]] && caller_passed "--model" && ! caller_passed "--effort"; then
            (( i += width ))
            continue
        fi
        if ! caller_passed "$flag"; then
            kept+=("${PROFILE_ARGS[@]:i:width}")
        fi
        (( i += width ))
    done
    PROFILE_ARGS=("${kept[@]+"${kept[@]}"}")
}

wrapper_help() {
    cat <<EOF
${PROG} — headless Claude Code billed to an Anthropic API key.

  ${PROG} [claude args...]   Run 'claude --bare' with the API key applied.
                                   Arguments and stdin pass through with one
                                   addition: a SANDBOX FACTS note is merged into
                                   --append-system-prompt so the delegate knows
                                   its real toolset and write limits
                                   (--no-sandbox-note passes argv untouched).

  ${PROG} --profile <name> [args...]
                                   Apply a read-only role profile. Accepts only
                                   --model --fallback-model --effort
                                   --max-budget-usd --add-dir (each replaces the
                                   profile's copy) plus the wrapper options
                                   below; anything else is refused. The prompt
                                   (-p / --prompt-file / stdin) is delivered on
                                   stdin and never enters claude's argv.

  ${PROG} --no-sandbox-note [...]  Skip the SANDBOX FACTS merge on a
                                   pass-through run (env:
                                   CLAUDE_API_AGENT_NO_SANDBOX_NOTE=1).
  ${PROG} --no-stdin [...]   Redirect stdin from /dev/null. Use for delegated
                                   runs that pipe nothing — otherwise Claude
                                   Code waits 3s for stdin and warns on stderr.

  ${PROG} --list-profiles    Show the available role profiles.
  ${PROG} --tag key=value    Attribute this run in the usage log (repeatable).
                             Any key works; 'id' and 'phase' are the two the
                             reporting rolls up. Also settable for a whole
                             shell with CLAUDE_API_AGENT_TAGS="id=x,phase=y".
  ${PROG} --pin-proxy        Record the current proxy as known-good, so a
                             later change to the key's egress path warns.
  ${PROG} --usage            Summarize the usage log: spend per profile,
                                   errored runs, and runs where the delegate
                                   attempted a disallowed tool.
  ${PROG} --setup-key        Store the key via a hidden prompt (SOPS-encrypted).
  ${PROG} --key-status       Show key presence and permissions (never the key).
  ${PROG} --edit-key         Edit the encrypted secret with 'sops edit'.
  ${PROG} --remove-key       Delete the encrypted secret.
  ${PROG} --wrapper-help     This message.

Key resolution order:
  1. ANTHROPIC_API_KEY, if exported non-empty for this invocation.
  2. ${SECRET_FILE}
     (SOPS + age; decrypted in memory per run)
  3. ${PLAIN_FILE}
     (plaintext fallback, mode 600, only if the SOPS file is absent)

Subscription credentials (CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_AUTH_TOKEN) are
unset for the child process only. Interactive 'claude' is unaffected.
EOF
}

# ---------------------------------------------------------------------------
# Usage log — metadata only, appended after a run whose output we can parse.
#
# Deliberately NOT logged: the prompt, the model's result/structured_output, and
# tool_input from permission denials (which can contain paths derived from the
# prompt). Denials are recorded as tool NAMES plus a count, which is the audit
# signal -- did the delegate try to escape its allow-list -- without content.
#
# Disable with CLAUDE_API_AGENT_NO_LOG=1. Override the path with
# CLAUDE_API_AGENT_LOG. Logging failure never fails the run.
# ---------------------------------------------------------------------------
USAGE_LOG="${CLAUDE_API_AGENT_LOG:-${XDG_STATE_HOME:-${HOME}/.local/state}/claude-api-agent/usage.jsonl}"

append_usage_log() {
    local envelope="$1" profile="${2:-}"
    [[ -z "${CLAUDE_API_AGENT_NO_LOG:-}" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    (umask 077; mkdir -p -- "$(dirname -- "$USAGE_LOG")") 2>/dev/null || return 0
    # Scrub the key from the logger's environment: it parses an envelope and
    # never needs credentials, so there is no reason for the plaintext key to
    # be visible in this subprocess's /proc/<pid>/environ, or reachable by a
    # PATH-shadowed python3 or a tampered sitecustomize.py.
    # Tag key/value pairs are appended as raw trailing argv (key, value, key,
    # value, ...) and turned into a dict INSIDE the scrubbed python3. No
    # python3 runs with the key exported, and the values are never
    # shell-interpreted.
    env -u ANTHROPIC_API_KEY python3 - "$envelope" "$profile" "$USAGE_LOG" \
        "${TAG_KV[@]+"${TAG_KV[@]}"}" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
env_path, profile, log_path = sys.argv[1], sys.argv[2], sys.argv[3]
tags = {}
_tag_argv = sys.argv[4:]
for _i in range(0, len(_tag_argv) - 1, 2):
    tags[_tag_argv[_i]] = _tag_argv[_i + 1]
try:
    raw = open(env_path).read()
    start = raw.find("{")
    if start < 0:
        sys.exit(0)
    d = json.loads(raw[start:], strict=False)
except Exception:
    sys.exit(0)
# Only a --output-format json envelope carries these; anything else is skipped.
if not isinstance(d, dict) or "total_cost_usd" not in d:
    sys.exit(0)
u = d.get("usage") or {}
denials = d.get("permission_denials") or []

# Per-model token counts and cost, keyed by canonical model name. Token counts
# and dollars are metadata, not content -- but they are what makes spend
# attributable to a model rather than to a run, which is the only way to see
# where a fan-out's money actually went.
by_model = {}
for raw_name, mu in (d.get("modelUsage") or {}).items():
    if not isinstance(mu, dict):
        continue
    name = mu.get("canonicalModel") or raw_name
    slot = by_model.setdefault(name, {"in": 0, "out": 0, "cr": 0, "cw": 0, "usd": 0.0})
    slot["in"] += mu.get("inputTokens") or 0
    slot["out"] += mu.get("outputTokens") or 0
    slot["cr"] += mu.get("cacheReadInputTokens") or 0
    slot["cw"] += mu.get("cacheCreationInputTokens") or 0
    slot["usd"] += mu.get("costUSD") or 0.0

# Substance metadata. A measured fan-out produced runs that cost real money,
# reported is_error false, validated against --json-schema, and returned
# placeholder content ({"summary":"test",...}). Sizes and a verdict are
# metadata, not content, so they can be recorded without logging the answer.
#
# This is a COARSE single-run hint for --usage, not a gate. claude-fanout's
# per-shard status is the authoritative verdict: it can resolve cited file
# paths against the reviewed roots, which this logger has no knowledge of. The
# two are kept as consistent as a rootless check allows -- both strip before
# measuring, and both treat a filler token as thin -- but where they can
# differ, the fan-out status wins.
so = d.get("structured_output")
summary_chars = findings_count = None
summary_txt = ""
if isinstance(so, dict):
    summary_txt = str(so.get("summary") or "").strip()
    summary_chars = len(summary_txt)
    if isinstance(so.get("findings"), list):
        findings_count = len(so["findings"])
result_txt = str(d.get("result") or "").strip()
result_chars = len(result_txt)

# A filler token is thin regardless of length; otherwise fall back to a length
# floor. Mirrors claude-fanout._looks_placeholder without importing it (this
# heredoc runs under a bare `python3 -`, so it cannot rely on sys.path).
_PLACEHOLDER = {"test", "todo", "tbd", "example", "placeholder", "foo", "bar",
                "n/a", "none", "sample", "dummy", "xxx", "summary", "string"}


def _thin(txt: str, floor: int) -> bool:
    t = txt.lower().rstrip(".!?")
    if not t or t in _PLACEHOLDER or len(t) <= 2:
        return True
    return len(txt) < floor


if d.get("is_error"):
    quality = "error"
elif summary_chars is not None:
    quality = "thin" if _thin(summary_txt, 40) else "ok"
elif so is not None:
    quality = "thin"
else:
    quality = "thin" if _thin(result_txt, 80) else "ok"

rec = {
    "ts": datetime.datetime.now(datetime.timezone.utc)
            .isoformat(timespec="seconds").replace("+00:00", "Z"),
    "profile": profile or None,
    "tags": tags or None,
    "session_id": d.get("session_id"),
    "models": sorted((d.get("modelUsage") or {}).keys()),
    "cost_usd": d.get("total_cost_usd"),
    "turns": d.get("num_turns"),
    "duration_ms": d.get("duration_ms"),
    "is_error": d.get("is_error"),
    "subtype": d.get("subtype"),
    "terminal_reason": d.get("terminal_reason"),
    "denied_tools": sorted({x.get("tool_name") for x in denials if x.get("tool_name")}),
    "denial_count": len(denials),
    "input_tokens": u.get("input_tokens"),
    "cache_write_tokens": u.get("cache_creation_input_tokens"),
    "cache_read_tokens": u.get("cache_read_input_tokens"),
    "output_tokens": u.get("output_tokens"),
    "by_model": by_model or None,
    "quality": quality,
    "summary_chars": summary_chars,
    "findings_count": findings_count,
    "result_chars": result_chars,
}
fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
with os.fdopen(fd, "a") as fh:
    fh.write(json.dumps(rec, separators=(",", ":")) + "\n")
PY
}

# ---------------------------------------------------------------------------
# The run dir (packet a-s5) -- what `claude-agents status` reads for lane api.
#
# One dir per run beside the usage log: <dirname of the log>/runs/<id>/, mode
# 0700, the id <UTC yyyymmddThhmmss>-<pid>. run.json is written before the
# child starts and rewritten at exit; under --profile, `claude-agents fold`
# keeps progress.json beside it. Same rule as the usage log: names, numbers,
# ids and times only -- never the prompt, the result, thinking or tool text.
# Every write goes to a temp file and is renamed into place. Skipped with
# CLAUDE_API_AGENT_NO_LOG; a failure here never fails the run.
# ---------------------------------------------------------------------------
RUNS_DIR="$(dirname -- "$USAGE_LOG")/runs"
RUN_DIR=''
FOLD_BIN="${REPO_ROOT}/bin/claude-agents"

# The model a profile run asks for: the last --model in the argv this script
# built (the profile's, or the caller's validated override). A pass-through
# argv may carry free text (`-p --model <text>`), so it names no model.
run_model() {
    (( PROFILE_MODE )) || return 0
    local i n=${#FINAL_ARGS[@]} tok m='' re='^[][A-Za-z0-9._:@/-]{1,80}$'
    for (( i = 0; i < n; i++ )); do
        tok="${FINAL_ARGS[i]}"
        case "$tok" in
            --model)   m="${FINAL_ARGS[i+1]:-}"; i=$(( i + 1 )) ;;
            --model=*) m="${tok#--model=}" ;;
        esac
    done
    if [[ "$m" =~ $re ]]; then
        printf '%s' "$m"
    fi
    return 0
}

# Prunes, makes the run dir and writes run.json; prints the dir. Prints
# nothing when any step fails.
run_start() {
    local model="$1"
    env -u ANTHROPIC_API_KEY python3 - "$RUNS_DIR" "$$" "$ACTIVE_PROFILE" "$model" \
        "${TAG_KV[@]+"${TAG_KV[@]}"}" <<'PY' 2>/dev/null || return 0
import datetime, json, os, re, shutil, sys
runs, pid, profile, model = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
tags = {}
_kv = sys.argv[5:]
for _i in range(0, len(_kv) - 1, 2):
    tags[_kv[_i]] = _kv[_i + 1]
ID_RE = re.compile(r"^\d{8}T\d{6}-\d+$")
KEEP_S = 7 * 86400
now = datetime.datetime.now(datetime.timezone.utc)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def when(v):
    try:
        return datetime.datetime.strptime(v, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None


def env_id(name):
    v = os.environ.get(name) or None
    return v[:128] if v else None


os.umask(0o077)
os.makedirs(runs, mode=0o700, exist_ok=True)
# Ruling 6: a run that ended more than 7 days ago goes, and so does a `running`
# one that started more than 7 days ago and whose pid is gone (a killed wrapper
# never rewrote it). status shows a dead running dir as failed until then.


def pid_gone(v):
    if isinstance(v, bool) or not isinstance(v, int) or v <= 0:
        return False
    try:
        os.kill(v, 0)
    except ProcessLookupError:
        return True
    except (OSError, OverflowError):
        return False
    return False


try:
    names = os.listdir(runs)
except OSError:
    names = []
for name in names:
    d = os.path.join(runs, name)
    if not ID_RE.match(name) or os.path.islink(d) or not os.path.isdir(d):
        continue
    try:
        with open(os.path.join(d, "run.json")) as f:
            rj = json.load(f)
    except (OSError, ValueError):
        continue
    if not isinstance(rj, dict):
        continue
    if rj.get("state") in ("done", "failed"):
        ended = when(rj.get("ended"))
        old = ended is not None and (now - ended).total_seconds() > KEEP_S
    elif rj.get("state") == "running":
        started = when(rj.get("started"))
        old = started is not None and (now - started).total_seconds() > KEEP_S and pid_gone(rj.get("pid"))
    else:
        old = False
    if old:
        shutil.rmtree(d, ignore_errors=True)

rid = now.strftime("%Y%m%dT%H%M%S") + "-" + str(pid)
d = os.path.join(runs, rid)
os.mkdir(d, 0o700)
rec = {"id": rid, "pid": pid, "profile": profile or None, "tags": tags or None,
       "model": model or None, "started": iso(now),
       "parent_session": env_id("CLAUDE_CODE_SESSION_ID"), "fanout": env_id("CLAUDE_FANOUT_RUN"),
       "state": "running"}
tmp = os.path.join(d, ".run.json.tmp")
with open(tmp, "w") as f:
    f.write(json.dumps(rec, separators=(",", ":")) + "\n")
os.replace(tmp, os.path.join(d, "run.json"))
sys.stdout.write(d)
PY
    return 0
}

# Rewrites run.json at exit: state done (rc 0, and under the fold a result
# event seen) or failed, plus rc and ended.
run_end() {
    local rc="$1" ok="$2"
    [[ -n "$RUN_DIR" ]] || return 0
    env -u ANTHROPIC_API_KEY python3 - "$RUN_DIR" "$rc" "$ok" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
d, rc, ok = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "1"
os.umask(0o077)                     # every file in the run dir is 0600
path = os.path.join(d, "run.json")
with open(path) as f:
    rec = json.load(f)
rec["state"] = "done" if ok else "failed"
rec["rc"] = rc
rec["ended"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
tmp = os.path.join(d, ".run.json.tmp")
with open(tmp, "w") as f:
    f.write(json.dumps(rec, separators=(",", ":")) + "\n")
os.replace(tmp, path)
PY
    return 0
}

usage_summary() {
    if [[ ! -s "$USAGE_LOG" ]]; then
        printf 'No usage log at %s\n' "$USAGE_LOG" >&2
        return 0
    fi
    command -v python3 >/dev/null 2>&1 || die "python3 is required for --usage"
    python3 - "$USAGE_LOG" <<'PY'
import collections, json, sys
rows = []
for line in open(sys.argv[1]):
    line = line.strip()
    if line:
        try: rows.append(json.loads(line))
        except Exception: pass
if not rows:
    print("log is empty or unparseable"); sys.exit(0)
total = sum(r.get("cost_usd") or 0 for r in rows)
print(f"runs: {len(rows)}   total: ${total:.4f}   log: {sys.argv[1]}")
by = collections.defaultdict(lambda: [0, 0.0])
for r in rows:
    k = r.get("profile") or "(no profile)"
    by[k][0] += 1; by[k][1] += r.get("cost_usd") or 0
print("\nby profile:")
for k, (n, c) in sorted(by.items(), key=lambda kv: -kv[1][1]):
    print(f"  {k:14} {n:4} runs  ${c:.4f}")
errs = [r for r in rows if r.get("is_error")]
if errs:
    print(f"\nerrored runs: {len(errs)}")
    for r in errs[-5:]:
        # terminal_reason, not subtype: an API error still reports
        # subtype "success", so subtype alone hides the failure.
        print(f"  {r.get('ts')}  {r.get('terminal_reason') or r.get('subtype')}"
              f"  ${r.get('cost_usd') or 0:.4f}")

thin = [r for r in rows if r.get("quality") == "thin"]
if thin:
    wasted = sum(r.get("cost_usd") or 0 for r in thin)
    print(f"\nruns that returned almost nothing: {len(thin)}  (${wasted:.4f} spent)")
    print("  Schema-valid but substanceless output. These report success.")
    for r in thin[-5:]:
        print(f"  {r.get('ts')}  {(r.get('profile') or '-'):8} "
              f"${r.get('cost_usd') or 0:.4f}  {r.get('turns')}t  "
              f"summary={r.get('summary_chars')}c findings={r.get('findings_count')}")
den = [r for r in rows if r.get("denial_count")]
if den:
    print(f"\nruns with permission denials: {len(den)}  (delegate attempted a disallowed tool)")
    for r in den[-5:]:
        print(f"  {r.get('ts')}  {','.join(r.get('denied_tools') or [])}  x{r.get('denial_count')}")
print("\nlast 5 runs:")
for r in rows[-5:]:
    print(f"  {r.get('ts')}  {(r.get('profile') or '-'):8} ${r.get('cost_usd') or 0:.4f}  "
          f"{r.get('turns')}t  cache r/w {r.get('cache_read_tokens')}/{r.get('cache_write_tokens')}")
PY
}

# ---------------------------------------------------------------------------
# Run tags — attribution metadata, recorded verbatim in the usage log.
#
# The point is to make spend answerable at the level work is actually organised
# at: which investigation, which phase of it. A triage run and the fix runs it
# hands off to are separate processes with separate ceilings, and without a
# shared key there is no way afterwards to ask what the whole thing cost, or how
# much of it went on deciding rather than doing.
#
# Nothing enforces any particular key -- grouping works on whatever you set.
# Two keys are conventional only because the tooling knows how to roll them up:
#   id      whatever identifier the caller already has for this unit of work:
#           a CI job, an incident, a ticket, an experiment. This repo has no
#           opinion about what it means; it is a correlation key.
#   phase   which step of that work this run is: triage | fix | verify | ...
#
# Values are written to the log verbatim. They are for identifiers, not for
# prompt text -- the log deliberately holds no prompt content, and a tag is the
# one field that could smuggle some in.
# ---------------------------------------------------------------------------
TAG_KEYS=()
TAG_VALS=()
TAG_KV=()

add_tag() {
    local kv="$1" k v
    [[ "$kv" == *=* ]] || die "--tag expects key=value, got: ${kv}"
    k="${kv%%=*}"
    v="${kv#*=}"
    [[ "$k" =~ ^[a-z][a-z0-9_]{0,31}$ ]] \
        || die "tag key must be lowercase [a-z][a-z0-9_]* up to 32 chars, got: ${k}"
    [[ -n "$v" ]] || die "tag ${k} has an empty value"
    (( ${#v} <= 64 )) || die "tag ${k} value exceeds 64 characters"
    (( ${#TAG_KEYS[@]} < 8 )) || die "at most 8 tags per run"
    TAG_KEYS+=("$k")
    TAG_VALS+=("$v")
    TAG_KV+=("$k" "$v")
}

# CLAUDE_API_AGENT_TAGS applies tags to every run in a shell, so a whole
# session can be attributed without editing each call site. Explicit --tag
# flags are added after, and win on duplicate keys (last write wins in the
# logger's dict).
if [[ -n "${CLAUDE_API_AGENT_TAGS:-}" ]]; then
    # `set -f` disables pathname expansion for the split: without it, an
    # unquoted expansion glob-matches tag values against filenames in the cwd,
    # so a value of `*` would take its value from a directory listing (or abort
    # every invocation in a directory holding an over-long filename). IFS=','
    # does the intended comma split; `set +f` restores globbing immediately.
    _saved_ifs="$IFS"; IFS=','
    set -f
    for _kv in ${CLAUDE_API_AGENT_TAGS}; do
        [[ -n "$_kv" ]] && add_tag "$_kv"
    done
    set +f
    IFS="$_saved_ifs"
    unset -v _kv _saved_ifs
fi

# ---------------------------------------------------------------------------
# Argument parsing
#
# Two modes. Under --profile the wrapper CONSTRUCTS the child's argv from an
# allow-list (a total parse; the prompt goes to stdin, never argv). Without
# --profile it is a transparent pass-through, with one rule: never SILENTLY
# forward a token spelled like one of the wrapper's own options.
# ---------------------------------------------------------------------------
PROFILE_ARGS=()
CALLER_ARGS=()
CLOSE_STDIN=0
ACTIVE_PROFILE=''
PROMPT=''
PROMPT_SET=0

set_profile() {
    [[ -z "$ACTIVE_PROFILE" ]] || die "--profile was given more than once"
    [[ -n "$1" ]] || die "--profile requires a name (review|explore|analyze)"
    resolve_profile "$1"
    ACTIVE_PROFILE="$1"
}

set_prompt() {
    (( PROMPT_SET == 0 )) || die "the prompt was given more than once"
    PROMPT="$1"
    PROMPT_SET=1
}

# Read a prompt file into the global PROMPT, requiring a REGULAR file and a
# successful read.
#
# This MUST run at statement level, not inside a command substitution: `die`
# (which calls `exit`) inside `$(...)` only terminates the subshell, so the
# parent would continue with an empty prompt and bill for it -- the exact
# swallowed-status trap that `-r`-on-a-directory produced. `-r` alone is true
# for a directory, whose `cat` then fails, so require `-f` and check the read.
read_prompt_file() {
    local path="$1" body
    [[ -f "$path" ]] || die "--prompt-file must name a readable regular file, got: ${path}"
    body="$(cat -- "$path")" || die "could not read prompt file: ${path}"
    set_prompt "$body"
}

# Strict grammar for --profile runs. Wrapper options are accepted at ANY index
# because the parse is total -- no token's role is ambiguous.
parse_profile_args() {
    local -a argv=("$@")
    local i n=$# tok flag val
    for (( i = 0; i < n; i++ )); do
        tok="${argv[i]}"
        case "$tok" in
            --profile)
                (( i + 1 < n )) || die "--profile requires a name (review|explore|analyze)"
                i=$(( i + 1 )); set_profile "${argv[i]}" ;;
            --profile=*)
                set_profile "${tok#*=}" ;;
            --tag)
                (( i + 1 < n )) || die "--tag requires key=value"
                i=$(( i + 1 )); add_tag "${argv[i]}" ;;
            --tag=*)
                add_tag "${tok#*=}" ;;
            --no-stdin)
                CLOSE_STDIN=1 ;;
            --list-profiles)
                list_profiles; exit 0 ;;
            -p|--print|--prompt)
                # The prompt is the next token, taken verbatim, and never enters
                # the child's argv -- it is delivered on stdin. A trailing bare
                # -p means "the prompt arrives on stdin", which is the default.
                if (( i + 1 < n )); then
                    i=$(( i + 1 )); set_prompt "${argv[i]}"
                fi ;;
            --prompt-file)
                (( i + 1 < n )) || die "--prompt-file requires a path"
                i=$(( i + 1 )); read_prompt_file "${argv[i]}" ;;
            --prompt-file=*)
                read_prompt_file "${tok#*=}" ;;
            --)
                die "refusing to run: '--' is not accepted with --profile.
  This wrapper does not rely on claude honouring an end-of-options marker.
  Pass the prompt with -p or --prompt-file; it travels on stdin, so its text
  can never be parsed as a flag." ;;
            --output-format|--output-format=*)
                # The profile already sets --output-format json and the wrapper
                # captures that envelope. Tolerate a redundant caller-supplied
                # json (either spelling) as a NO-OP, so a --profile run that
                # mirrors a pass-through invocation is not refused for a flag that
                # changes nothing -- but still refuse any other value, which would
                # break the capture path.
                if [[ "$tok" == *=* ]]; then
                    val="${tok#*=}"
                else
                    (( i + 1 < n )) || die "--output-format requires a value"
                    i=$(( i + 1 )); val="${argv[i]}"
                fi
                [[ "$val" == json ]] || die "refusing to run: --output-format ${val} is not permitted with --profile.
  A profile always sets --output-format json, and the wrapper captures that
  envelope; only a redundant 'json' is tolerated here. Drop the flag." ;;
            -*)
                flag="${tok%%=*}"
                profile_flag_allowed "$flag" \
                    || die "refusing to run: ${flag} is not permitted with --profile.
  --profile runs accept only: --model --fallback-model --effort --max-budget-usd
  --add-dir  (plus this wrapper's --tag, --no-stdin, -p,
  --prompt-file). Everything else is refused rather than forwarded, because a
  flag this wrapper does not know about may re-grant capability the profile
  removed -- e.g. --dangerously-skip-permissions, --tools, --settings, --agents.
  To run with a different flag: add it to profile_flag_allowed() in this script
  after deciding it is safe, or drop --profile and pass every claude flag
  yourself (in which case no read-only guarantee applies)."
                if [[ "$tok" == *=* ]]; then
                    (( FLAG_ARITY == 1 )) || die "${flag} takes no value, got: ${tok}"
                    val="${tok#*=}"
                elif (( FLAG_ARITY == 1 )); then
                    (( i + 1 < n )) || die "${flag} requires a value"
                    i=$(( i + 1 )); val="${argv[i]}"
                else
                    val=''
                fi
                if (( FLAG_ARITY == 1 )); then
                    validate_flag_value "$flag" "$val"
                    # Normalized to separated form: the child sees argv the
                    # wrapper wrote, in one shape, whichever shape was typed.
                    CALLER_ARGS+=("$flag" "$val")
                else
                    CALLER_ARGS+=("$flag")
                fi
                CALLER_FLAGS+=("$flag") ;;
            *)
                die "refusing to run: unexpected argument '${tok}'.
  --profile runs take no positional arguments. Prompt text goes to -p,
  --prompt-file, or stdin, so it can never be read as a flag." ;;
        esac
    done
}

# Pass-through mode: no profile, no guarantee to protect, arguments reach
# claude unchanged (documented in README). The one rule: never silently
# forward a token spelled like one of the wrapper's own options.
parse_passthrough_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-stdin)      CLOSE_STDIN=1; shift ;;
            --no-sandbox-note) NO_SANDBOX_NOTE=1; shift ;;
            --tag)           [[ $# -ge 2 ]] || die "--tag requires key=value"
                             add_tag "$2"; shift 2 ;;
            --tag=*)         add_tag "${1#*=}"; shift ;;
            --list-profiles) list_profiles; exit 0 ;;
            *) break ;;
        esac
    done
    local a
    for a in "$@"; do
        case "$a" in
            --no-stdin|--no-sandbox-note|--tag|--tag=*|--prompt-file|--prompt-file=*|--list-profiles)
                die "refusing to run: '${a}' is one of this wrapper's own options
  but appears after claude arguments, where the wrapper cannot tell a flag
  position from a value position. Move it in front of the claude arguments." ;;
        esac
    done
    CALLER_ARGS=("$@")
}

# ---------------------------------------------------------------------------
# The sandbox note (pass-through runs).
#
# Measured, twice: a delegate that does not know its real sandbox burns budget
# discovering it. 2026-08-19, one implementation run composed nine files and
# could write none of them -- .claude/ paths are refused under acceptEdits --
# and its work survived only as a summary, because it saved nothing until the
# end. The note below is merged into --append-system-prompt on every
# pass-through run so the delegate starts knowing what this harness verified
# by probe. --no-sandbox-note (or CLAUDE_API_AGENT_NO_SANDBOX_NOTE=1) restores
# the untouched argv contract.
# ---------------------------------------------------------------------------
NO_SANDBOX_NOTE=0

sandbox_note_text() {
    local accept_edits=0 i n=${#CALLER_ARGS[@]}
    for (( i=0; i<n; i++ )); do
        case "${CALLER_ARGS[i]}" in
            --permission-mode=acceptEdits) accept_edits=1 ;;
            --permission-mode) [[ "${CALLER_ARGS[i+1]:-}" == acceptEdits ]] && accept_edits=1 ;;
        esac
    done
    printf '%s' 'SANDBOX FACTS (from the claude-api-agent wrapper, verified by probe):
- This session runs claude --bare. The built-in tools are exactly Bash, Edit and
  Read. Write, Grep and Glob are absent, and unknown --tools names drop silently.
  Create a new file with Edit on a new path; search with Bash grep/rg where Bash
  is permitted.
- In headless (-p) runs there are no permission prompts: a tool call outside your
  permission mode is refused on the spot.'
    if (( accept_edits )); then
        printf '%s' '
- You are running with --permission-mode acceptEdits: file edits are approved
  inside the working directory and any --add-dir, and paths under dot-directories
  (.claude/, .config/, ...) are refused. Stage such files under a plain-named
  directory and say so in your summary. Most Bash commands are refused; sandboxed
  read-only commands may run.'
    fi
    printf '%s' '
- Save every deliverable file to disk as soon as it is composed. Your context
  ends with the run; files on disk survive, and your final message reaches the
  caller only as text.
- Make the final message a compact summary: what you wrote where, and any place
  you were blocked.'
}

inject_sandbox_note() {
    local note; note="$(sandbox_note_text)"
    local i n=${#CALLER_ARGS[@]}
    for (( i=0; i<n; i++ )); do
        case "${CALLER_ARGS[i]}" in
            --append-system-prompt=*)
                CALLER_ARGS[i]="--append-system-prompt=${note}"$'\n\n'"${CALLER_ARGS[i]#--append-system-prompt=}"
                return 0 ;;
            --append-system-prompt)
                if (( i+1 < n )); then
                    CALLER_ARGS[i+1]="${note}"$'\n\n'"${CALLER_ARGS[i+1]}"
                    return 0
                fi ;;
        esac
    done
    CALLER_ARGS+=(--append-system-prompt "$note")
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
if [[ $# -eq 1 ]]; then
    case "$1" in
        --setup-key)     setup_key;     exit 0 ;;
        --key-status)    key_status;    exit 0 ;;
        --edit-key)      edit_key;      exit 0 ;;
        --remove-key)    remove_key;    exit 0 ;;
        --list-profiles) list_profiles; exit 0 ;;
        --pin-proxy)     pin_proxy;     exit 0 ;;
        --usage)         usage_summary; exit 0 ;;
        --wrapper-help)  wrapper_help;  exit 0 ;;
        -h|--help)       wrapper_help;  exit 0 ;;
    esac
fi

# Mode is decided first, by an OVER-matching scan of EVERY token in every
# position: if --profile appears anywhere, either the profile applies or the
# run is refused inside the strict parser. It can never be forwarded to claude
# as ordinary argv, which was the B1 bypass (`-p x --profile review` ran with
# no containment flags at all). A prompt whose text equals --profile now
# reaches the strict parser and is refused there -- the same deliberate
# false positive the old containment scan made.
PROFILE_MODE=0
for _a in "$@"; do
    case "$_a" in
        --profile|--profile=*) PROFILE_MODE=1; break ;;
    esac
done
unset -v _a

if (( PROFILE_MODE )); then
    parse_profile_args "$@"
    [[ -n "$ACTIVE_PROFILE" ]] || die "--profile requires a name (review|explore|analyze)"
    drop_overridden_profile_args
else
    parse_passthrough_args "$@"
    if (( NO_SANDBOX_NOTE == 0 )) && [[ -z "${CLAUDE_API_AGENT_NO_SANDBOX_NOTE:-}" ]]; then
        inject_sandbox_note
    fi
fi

# The prompt owns stdin under --profile. If the caller also redirected stdin
# without --no-stdin, their piped data would be silently dropped -- refuse
# rather than guess which they meant. Exception: stdin that IS /dev/null
# carries nothing that could be dropped, and it is exactly what background
# task harnesses (cron, Claude Code background shells) hand every child --
# refusing it just forces a redundant --no-stdin (measured: it cost the
# queue-mvp integration a full run cycle on 2026-08-13).
stdin_is_dev_null() {
    [[ /dev/stdin -ef /dev/null ]] 2>/dev/null
}
if (( PROFILE_MODE && PROMPT_SET && CLOSE_STDIN == 0 )) && [[ ! -t 0 ]] && ! stdin_is_dev_null; then
    die "refusing to run: a prompt was given AND stdin is redirected.
  --profile runs deliver the prompt on stdin, so the piped data would be
  dropped without a word. Add --no-stdin if the pipe is not meant to be read,
  or drop -p and pipe the prompt itself."
fi

CLAUDE_BIN="$(find_claude)"

# 1. Explicit non-empty ANTHROPIC_API_KEY wins for this run.
# 2. Otherwise the SOPS-encrypted secret.
# 3. Otherwise the plaintext fallback.
if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    API_KEY="$ANTHROPIC_API_KEY"
elif [[ -e "$SECRET_FILE" ]]; then
    read_sops_key
elif [[ -e "$PLAIN_FILE" ]]; then
    read_plain_key
else
    die "no API key found.
  Set one up with:  ${PROG} --setup-key
  (or export ANTHROPIC_API_KEY for a single invocation)"
fi

# Belt and braces: --bare already ignores OAuth/keychain, but make it impossible
# for subscription credentials to reach the child at all.
unset -v CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_AUTH_TOKEN

# Do not let an inherited environment redirect the decrypted key to another
# endpoint. A poisoned shell profile, CI environment, or calling agent setting
# ANTHROPIC_BASE_URL would otherwise exfiltrate the key on the first request
# with no diagnostic. This wrapper exists to bill a Claude Console project, so
# a non-Anthropic endpoint is always wrong here.
#
# NODE_OPTIONS and NODE_EXTRA_CA_CERTS are stripped for the same reason even
# though they are not endpoints. claude is a Node CLI, so NODE_OPTIONS=--require
# injects arbitrary code into the very process that holds the decrypted key,
# and NODE_EXTRA_CA_CERTS lets an attacker-supplied CA turn a proxy into a
# working TLS intercept. NODE_TLS_REJECT_UNAUTHORIZED=0 achieves the same
# intercept with no CA at all, and SSL_CERT_FILE / SSL_CERT_DIR substitute a
# trust store the same way -- all stripped. None has a legitimate use here.
for _var in ANTHROPIC_BASE_URL ANTHROPIC_API_URL CLAUDE_CODE_USE_BEDROCK \
            CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY \
            NODE_OPTIONS NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED \
            SSL_CERT_FILE SSL_CERT_DIR; do
    if [[ -n "${!_var:-}" ]]; then
        if [[ -n "${CLAUDE_API_AGENT_ALLOW_ENDPOINT_OVERRIDE:-}" ]]; then
            warn "${_var} is set and CLAUDE_API_AGENT_ALLOW_ENDPOINT_OVERRIDE permits it; the API key will be sent to a non-default endpoint."
        else
            warn "ignoring inherited ${_var} (set CLAUDE_API_AGENT_ALLOW_ENDPOINT_OVERRIDE=1 to permit it)."
            unset -v "$_var"
        fi
    fi
done
unset -v _var

# ---------------------------------------------------------------------------
# Proxy pinning.
#
# A proxy cannot be stripped the way the endpoint switches are: on a network
# that requires one for egress, stripping it breaks every run. So the proxy is
# left in place and PINNED instead -- the known-good value is recorded once,
# and any later change is reported. That catches an environment poisoned to
# redirect egress without breaking legitimate corporate infrastructure.
#
# This is a change detector, not a boundary. The request is TLS to
# api.anthropic.com, so a plain CONNECT proxy sees a tunnel rather than the
# key; but the proxy is on the credential's network path, and NODE_EXTRA_CA_CERTS
# (stripped above) is what would turn it into a working intercept.
# ---------------------------------------------------------------------------
_expected_proxy="${CLAUDE_API_AGENT_EXPECTED_PROXY:-}"
if [[ -z "$_expected_proxy" && -r "$PROXY_PIN_FILE" ]]; then
    while IFS= read -r _line || [[ -n "$_line" ]]; do
        _line="${_line%%#*}"
        _line="${_line#"${_line%%[![:space:]]*}"}"
        _line="${_line%"${_line##*[![:space:]]}"}"
        [[ -n "$_line" ]] || continue
        _expected_proxy="$_line"
        break
    done < "$PROXY_PIN_FILE"
    unset -v _line
fi

_any_proxy=''
_proxy_mismatch=''
for _pv in HTTPS_PROXY https_proxy ALL_PROXY all_proxy; do
    _pval="${!_pv:-}"
    [[ -n "$_pval" ]] || continue
    _any_proxy=1
    [[ "$_pval" == "$_expected_proxy" ]] \
        || _proxy_mismatch+="${_proxy_mismatch:+, }${_pv}=${_pval}"
done

if [[ -n "$_any_proxy" && -z "$_expected_proxy" ]]; then
    warn "a proxy is set but no pin is configured, so the key's egress path is unverified.
  Pin the current value with:  ${PROG} --pin-proxy
  (or set CLAUDE_API_AGENT_EXPECTED_PROXY for a single run)."
elif [[ -n "$_proxy_mismatch" ]]; then
    warn "PROXY CHANGED -- the API key's egress path does not match the pinned value.
  pinned: ${_expected_proxy}
  active: ${_proxy_mismatch}
  If this is expected, re-pin with:  ${PROG} --pin-proxy"
elif [[ -z "$_any_proxy" && -n "$_expected_proxy" ]]; then
    warn "a proxy is pinned (${_expected_proxy}) but none is set for this run."
fi
unset -v _pv _pval _any_proxy _proxy_mismatch _expected_proxy

export ANTHROPIC_API_KEY="$API_KEY"
unset -v API_KEY

# Assembled from arrays this script wrote. Under --profile the child's argv
# contains NO caller free text: --bare, the profile's flags, --print, then the
# validated caller flag/value pairs. The prompt is delivered on stdin, below.
# Guarded expansion: an unguarded "${arr[@]}" on an empty array aborts under
# `set -u` on bash < 4.4.
if (( PROFILE_MODE )); then
    FINAL_ARGS=(--bare "${PROFILE_ARGS[@]+"${PROFILE_ARGS[@]}"}" --print \
                "${CALLER_ARGS[@]+"${CALLER_ARGS[@]}"}")
else
    FINAL_ARGS=(--bare "${CALLER_ARGS[@]+"${CALLER_ARGS[@]}"}")
fi

# Post-assembly invariant: a profile run always carries the containment flags
# and a spend ceiling. Asserted against STRUCTURED data -- the profile array
# walked in pairs, plus the caller's parsed flag set -- not a flattened argv
# scan, so no caller token can satisfy it by landing at a guessed flag
# position (the old failure). This is a backstop; the allow-list is the
# primary guarantee.
if (( PROFILE_MODE )); then
    # --tools is first because it is the flag that actually enforces read-only;
    # the caller can never supply it (not on the allow-list), so it must come
    # from the profile.
    for _cf in --tools --allowedTools --disallowedTools --permission-mode \
               --max-budget-usd --output-format; do
        if ! profile_args_have "$_cf" && ! caller_passed "$_cf"; then
            die "refusing to start a delegated run: --profile ${ACTIVE_PROFILE} produced no ${_cf}.
  This is a bug in argument handling, not something you did wrong."
        fi
    done
    unset -v _cf
fi

# Envelope routing. Under --profile the answer is known, not inferred: the
# profile sets --output-format json and the caller cannot override it, so the
# run always takes the capture path. In pass-through mode a heuristic still
# routes the run, but it is no longer security-bearing -- the worst outcome is
# a missed log line or a buffered stream.
emits_json_envelope() {
    (( PROFILE_MODE )) && return 0
    local i n=${#FINAL_ARGS[@]} tok
    for (( i = 0; i < n; i++ )); do
        tok="${FINAL_ARGS[i]}"
        [[ "$tok" == "--" ]] && return 1
        case "$tok" in
            --output-format=json) return 0 ;;
            --output-format=*)    return 1 ;;
            --output-format)
                [[ "${FINAL_ARGS[i+1]:-}" == json ]] && return 0
                return 1
                ;;
        esac
    done
    return 1
}

# Deliver the prompt on stdin, never in argv. `printf` is a shell builtin, so
# the text is written by this shell: it appears in no process's command line
# and is never written to disk -- the same reasoning already applied to the
# API key.
#
# A run with a run dir starts the child in the background and waits for it, so
# a SIGTERM, SIGHUP or SIGINT sent to this wrapper reaches the child: the trap
# forwards it to the child's pid, the wait resumes, and the run ends with rc
# 128+signal. `<&0` keeps the caller's stdin (a background child otherwise
# reads /dev/null). Bash starts a background child with SIGINT ignored, so a
# forwarded SIGINT is followed by a SIGTERM after INT_GRACE_S when the child has
# set no handler of its own and is still running.
CHILD_PID=''
GRACE_PID=''
SIG_RC=''
REAP_RC=0
INT_GRACE_S=2

# $1: the child's stdout, a file or a FIFO; empty keeps the wrapper's own.
spawn() {
    local out="$1"
    if [[ -z "$out" ]]; then
        if (( PROMPT_SET )); then
            "$CLAUDE_BIN" "${FINAL_ARGS[@]}" < <(printf '%s' "$PROMPT") &
        elif (( CLOSE_STDIN )); then
            "$CLAUDE_BIN" "${FINAL_ARGS[@]}" < /dev/null &
        else
            "$CLAUDE_BIN" "${FINAL_ARGS[@]}" <&0 &
        fi
    elif (( PROMPT_SET )); then
        "$CLAUDE_BIN" "${FINAL_ARGS[@]}" > "$out" < <(printf '%s' "$PROMPT") &
    elif (( CLOSE_STDIN )); then
        "$CLAUDE_BIN" "${FINAL_ARGS[@]}" > "$out" < /dev/null &
    else
        "$CLAUDE_BIN" "${FINAL_ARGS[@]}" > "$out" <&0 &
    fi
    CHILD_PID=$!
    # A signal that landed before the pid was known is delivered now.
    [[ -z "$SIG_RC" ]] || kill -s TERM "$CHILD_PID" 2>/dev/null || true
}

# $1 the signal's name, $2 its number.
forward() {
    SIG_RC=$(( 128 + $2 ))
    [[ -n "$CHILD_PID" ]] || return 0
    kill -s "$1" "$CHILD_PID" 2>/dev/null || return 0
    if [[ "$1" == INT && -z "$GRACE_PID" ]]; then
        ( sleep "$INT_GRACE_S"; kill -s TERM "$CHILD_PID" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
        GRACE_PID=$!
    fi
    return 0
}

trap_signals() {
    trap 'forward TERM 15' TERM
    trap 'forward HUP 1' HUP
    trap 'forward INT 2' INT
}

# Waits for $1 to exit and sets REAP_RC to its status. A trapped signal wakes
# `wait` early (status > 128) while the process still runs: wait again.
reap() {
    local rc
    while :; do
        wait "$1"
        rc=$?
        if (( rc > 128 )) && kill -0 "$1" 2>/dev/null; then
            continue
        fi
        REAP_RC=$rc
        return 0
    done
}

stop_grace() {
    [[ -z "$GRACE_PID" ]] || kill "$GRACE_PID" 2>/dev/null || true
}

# run.json before the child starts (rulings 1, 2, 5, 6 of packet a-s5).
if [[ -z "${CLAUDE_API_AGENT_NO_LOG:-}" ]] && command -v python3 >/dev/null 2>&1; then
    _model="$(run_model)"
    RUN_DIR="$(run_start "$_model")"
    [[ -n "$RUN_DIR" && -d "$RUN_DIR" ]] || RUN_DIR=''
    unset -v _model
fi

RUN_OUT=''
STREAM_FIFO=''
if [[ -z "${CLAUDE_API_AGENT_NO_LOG:-}" ]] && emits_json_envelope; then
    RUN_OUT="$(umask 077; mktemp -- "${TMPDIR:-/tmp}/.caa-out.XXXXXX")" || RUN_OUT=''
fi
if [[ -n "$RUN_OUT" ]]; then
    trap 'rm -f -- "$RUN_OUT"; [[ -z "$STREAM_FIFO" ]] || rm -f -- "$STREAM_FIFO"' EXIT
fi

# Ruling 3: a profile run streams. `--output-format json` becomes stream-json
# --verbose, and the child's stdout goes through `claude-agents fold`, which
# keeps progress.json and writes only the result event -- the envelope that
# --output-format json printed -- to RUN_OUT, so the usage log and the final
# print read what they always read. Without a run dir or the fold, nothing
# changes.
STREAM=0
if (( PROFILE_MODE )) && [[ -n "$RUN_OUT" && -n "$RUN_DIR" && -x "$FOLD_BIN" ]] \
   && mkfifo -m 600 -- "${RUN_OUT}.fifo" 2>/dev/null; then
    # The child writes the FIFO and the fold reads it: both are background
    # processes, so the child's own pid is known and signals reach it.
    STREAM_FIFO="${RUN_OUT}.fifo"
    _args=()
    _verbose=0
    for (( _i = 0; _i < ${#FINAL_ARGS[@]}; _i++ )); do
        _tok="${FINAL_ARGS[_i]}"
        if [[ "$_tok" == --output-format && "${FINAL_ARGS[_i+1]:-}" == json ]]; then
            _args+=(--output-format stream-json)
            _i=$(( _i + 1 ))
        elif [[ "$_tok" == --output-format=json ]]; then
            _args+=(--output-format=stream-json)
        else
            _args+=("$_tok")
            continue
        fi
        if (( _verbose == 0 )); then
            _args+=(--verbose)
            _verbose=1
        fi
    done
    FINAL_ARGS=("${_args[@]}")
    STREAM=1
    unset -v _args _verbose _i _tok
fi

if [[ -n "$RUN_OUT" ]]; then
    set +e
    trap_signals
    FOLD_RC=0
    if (( STREAM )); then
        env -u ANTHROPIC_API_KEY "$FOLD_BIN" fold --run-dir "$RUN_DIR" < "$STREAM_FIFO" > "$RUN_OUT" &
        FOLD_PID=$!
        spawn "$STREAM_FIFO"
    else
        spawn "$RUN_OUT"
    fi
    reap "$CHILD_PID"
    RUN_RC=$REAP_RC
    stop_grace
    if (( STREAM )); then
        # A child killed before it opened the FIFO leaves the fold waiting for a
        # writer: open and close it once, so the fold reads its end.
        _unblock=''
        if [[ -n "$SIG_RC" ]]; then
            ( exec 3> "$STREAM_FIFO" ) </dev/null >/dev/null 2>&1 &
            _unblock=$!
        fi
        reap "$FOLD_PID"
        FOLD_RC=$REAP_RC
        [[ -z "$_unblock" ]] || kill "$_unblock" 2>/dev/null
    fi
    set -e
    [[ -z "$SIG_RC" ]] || RUN_RC=$SIG_RC
    # A fold that failed lost the result: never report that as a clean run.
    if (( STREAM && FOLD_RC != 0 && RUN_RC == 0 )); then
        warn "the stream fold (${FOLD_BIN} fold) exited ${FOLD_RC}, so the run's result was not captured."
        RUN_RC=1
    fi
    # Under the fold, a run that printed no result event did not finish.
    _ok=0
    if (( RUN_RC == 0 )) && { (( STREAM == 0 )) || [[ -s "$RUN_OUT" ]]; }; then
        _ok=1
    fi
    run_end "$RUN_RC" "$_ok"
    append_usage_log "$RUN_OUT" "$ACTIVE_PROFILE" || true
    # `|| true` because errexit is back on: if the caller's stdout consumer
    # closes early (`claude-api-agent ... | head`), cat dies on SIGPIPE and
    # the script would exit 141, silently replacing the child's real exit
    # code. The run's actual success or failure must survive the plumbing.
    cat -- "$RUN_OUT" || true
    exit "$RUN_RC"
fi

# A run with a run dir is waited for, not exec'd, so run.json can be
# rewritten at exit (ruling 5: pass-through writes run.json, nothing else).
if [[ -n "$RUN_DIR" ]]; then
    set +e
    trap_signals
    spawn ''
    reap "$CHILD_PID"
    RUN_RC=$REAP_RC
    stop_grace
    set -e
    [[ -z "$SIG_RC" ]] || RUN_RC=$SIG_RC
    run_end "$RUN_RC" "$(( RUN_RC == 0 ))"
    exit "$RUN_RC"
fi

# Pure exec path (no logging). Under --profile the prompt still owns stdin, so
# use the process-substitution form rather than exec when a prompt is set.
if (( PROMPT_SET )); then
    exec -- "$CLAUDE_BIN" "${FINAL_ARGS[@]}" < <(printf '%s' "$PROMPT")
elif (( CLOSE_STDIN )); then
    exec -- "$CLAUDE_BIN" "${FINAL_ARGS[@]}" < /dev/null
fi
exec -- "$CLAUDE_BIN" "${FINAL_ARGS[@]}"
