ESCALATION_ETIQUETTE = (
    "Escalation etiquette: if you cannot meet the bar with evidence from the "
    "provided context, status=needs_help with a SPECIFIC question — that is a "
    "correct outcome, not a failure. Naming the exact artifact you are missing is "
    "what lets the next tier succeed. Inventing an answer the context cannot "
    "support is the only real failure mode here."
)

SECRET_PATTERNS = [
    # Naming these here is a scrubber deny-list, which CLAUDE.md explicitly
    # allows; nothing in this file reads, sets or injects any of them.
    (re.compile(r"sk-ant-[A-Za-z0-9_\-]{8,}"), "[REDACTED-KEY]"),
    (re.compile(r"(?i)\b(ANTHROPIC_[A-Z0-9_]*(?:KEY|TOKEN))\s*[=:]\s*\S+"), r"\1=[REDACTED]"),
    (re.compile(r"(?i)(authorization:\s*bearer\s+)\S+"), r"\1[REDACTED]"),
    (re.compile(r"(?i)\b(LABRESY_TOKEN|OPERATOR_TOKEN)\s*[=:]\s*\S+"), r"\1=[REDACTED]"),
]


def scrub(text: str) -> str:
    """Redact anything secret-shaped AT CAPTURE TIME (never at display time)."""
    if not text:
        return text
    out = text
    for pat, repl in SECRET_PATTERNS:
        out = pat.sub(repl, out)
    return out


