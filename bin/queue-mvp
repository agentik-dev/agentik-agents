"""


# ---------------------------------------------------------------------------
# Acceptance verdicts and checks
# ---------------------------------------------------------------------------

@dataclass
class Verdict:
    """Outcome of an acceptance check for one attempt.

    accepted     -> the job may be transitioned done with this response.
    tier_correct -> the attempt did the RIGHT thing for its tier even though the
                    job is not finished (job B's tier-1 "needs_help naming the
                    missing artifact" is the canonical case). Reported, not summed.
    """
    accepted: bool
    reason: str
    tier_correct: bool = False


def _s(v: Any) -> str:
    if v is None:
        return ""
    if isinstance(v, str):
        return v
    return json.dumps(v, ensure_ascii=False)


def _result_of(resp: dict) -> dict:
    r = resp.get("result")
    return r if isinstance(r, dict) else {}


def _mentions(text: str, needles: Iterable[str]) -> bool:
    low = text.lower()
    return any(n in low for n in needles)


def check_triage(resp: dict, attempt: int) -> Verdict:
    if resp.get("status") != "success":
        return Verdict(False, "status=needs_help: " + _s(resp.get("help_request"))[:200])
    res = _result_of(resp)
    skill = _s(res.get("skill_classification")).strip().lower()
    disp = _s(res.get("disposition")).strip().lower()
    if skill == "infra_environment" and disp == "defer":
        return Verdict(True, "skill_classification=infra_environment and disposition=defer")
    return Verdict(
        False,
        f"expected infra_environment/defer, got {skill or '<missing>'}/{disp or '<missing>'}",
    )


def check_debug_oom(resp: dict, attempt: int) -> Verdict:
    status = resp.get("status")
    res = _result_of(resp)
    if attempt == 1:
        # The tier-1 bundle CANNOT prove a root cause. The correct junior answer
        # is needs_help naming the host-level artifact.
        if status == "needs_help":
            hr = resp.get("help_request") or {}
            text = _s(hr.get("missing")) + " " + _s(hr.get("question"))
            if _mentions(text, ("host", "dmesg", "docker", "memory", "oom", "free ", "ram")):
                return Verdict(
                    False,
                    "correct tier-1 escalation: named the missing host-level artifact "
                    f"({_s(hr.get('missing'))[:120]})",
                    tier_correct=True,
                )
            return Verdict(False, "needs_help, but did not name the missing host-level artifact")
        return Verdict(
            False,
            "claimed a root cause the tier-1 bundle cannot prove "
            f"(root_cause={_s(res.get('root_cause'))[:120]})",
        )
    # Tier 2+: the artifacts are attached, so the answer is checkable.
    if status != "success":
        return Verdict(False, "still needs_help with the host artifacts attached: "
                              + _s(resp.get("help_request"))[:200])
    root = _s(res.get("root_cause"))
    ev = _s(res.get("evidence"))
    if not _mentions(root, ("oom", "memory")):
        return Verdict(False, f"root_cause does not name memory/OOM: {root[:120]}")
    if not _mentions(ev, ("dmesg", "out of memory", "oom-kill", "71442")):
        return Verdict(False, "evidence does not cite the dmesg OOM line")
    return Verdict(True, "root cause is host memory exhaustion, cited from the dmesg line")


_ADDED_SLEEP_RE = re.compile(r"time\.sleep\(\s*(\d+(?:\.\d+)?)\s*\)")
_POLL_TOKENS = ("while", "for ", "wait_until", "poll")
_BOUND_TOKENS = ("deadline", "timeout", "monotonic", "elapsed", "max_wait",
                 "time.time()", "range(", "budget", "until=")


def check_code_patch(resp: dict, attempt: int) -> Verdict:
    if resp.get("status") != "success":
        return Verdict(False, "status=needs_help: " + _s(resp.get("help_request"))[:200])
    res = _result_of(resp)
    patch = res.get("patch")
    if not isinstance(patch, str) or not patch.strip():
        return Verdict(False, "result.patch is missing or empty")
    if "--- " not in patch or "+++ " not in patch:
        return Verdict(False, "result.patch is not a unified diff (no ---/+++ headers)")
    added = [ln for ln in patch.splitlines() if ln.startswith("+") and not ln.startswith("+++")]
    if not added:
        return Verdict(False, "unified diff adds no lines")
    added_text = "\n".join(added).lower()
    if not any(tok in added_text for tok in _POLL_TOKENS):
        return Verdict(False, "no poll loop in the added lines (while/for/wait_until/poll)")
    if not any(tok in added_text for tok in _BOUND_TOKENS):
        return Verdict(False, "poll loop has no deadline/timeout bound in the added lines")
    for ln in added:
        for m in _ADDED_SLEEP_RE.finditer(ln):
            if float(m.group(1)) >= 5:
                return Verdict(
                    False,
                    f"added line reintroduces a long fixed sleep as the wait mechanism: {ln.strip()[:120]}",
                )
    if "assert" not in added_text:
        return Verdict(False, "the timeout assertion was not updated (no added assert line)")
    return Verdict(True, "bounded poll replaces the fixed sleeps and the assertion was updated")


_MS_INTERVAL_RE = re.compile(r"interval[^0-9]{0,24}(\d+(?:\.\d+)?)\s*ms", re.I)
_MULT_RE = re.compile(r"multiplier[^0-9]{0,24}(\d+)", re.I)
_DETECT_RE = re.compile(r"detect(?:ion)?[ _\-]?time[^0-9]{0,24}(\d+(?:\.\d+)?)\s*ms", re.I)
_CPU_TOKENS = ("cpu", "pin", "vhost", "softirq", "isol")


def check_bfd_constraint(resp: dict, attempt: int) -> Verdict:
    if resp.get("status") != "success":
        return Verdict(False, "status=needs_help: " + _s(resp.get("help_request"))[:200])
    res = _result_of(resp)
    rec = _s(res.get("recommendation"))
    cc = _s(res.get("constraint_check"))
    if not rec.strip():
        return Verdict(False, "result.recommendation is missing")
    if not cc.strip():
        return Verdict(False, "result.constraint_check is missing (the 200ms bound must be restated)")
    if "200" not in cc:
        return Verdict(False, "result.constraint_check does not restate the 200ms detection bound")

    blob = rec + " " + cc + " " + _s(res.get("rationale"))
    proposes_timer_change = _mentions(rec, ("interval", "multiplier", "timer", "detect"))

    # Numeric guard: any stated detect time (or interval x multiplier) over 200ms
    # violates the quoted SLA, whatever the prose says.
    detects: list[float] = []
    for m in _DETECT_RE.finditer(blob):
        detects.append(float(m.group(1)))
    iv = _MS_INTERVAL_RE.search(rec) or _MS_INTERVAL_RE.search(cc)
    mult = _MULT_RE.search(rec) or _MULT_RE.search(cc)
    if iv:
        m_val = float(mult.group(1)) if mult else 3.0
        detects.append(float(iv.group(1)) * m_val)
    for d in detects:
        if d > 200.0:
            return Verdict(False, f"proposed detection time {d:g}ms exceeds the 200ms SLA bound")

    if not _mentions(blob, _CPU_TOKENS):
        if proposes_timer_change:
            return Verdict(False, "proposes a timer change with no CPU/softirq measure")
        return Verdict(False, "does not address the softirq/CPU starvation (no cpu/pin/vhost/softirq/isol measure)")
    return Verdict(True, "addresses softirq/CPU starvation and keeps detection time within the 200ms bound")


def check_kb(resp: dict, attempt: int) -> Verdict:
    if resp.get("status") != "success":
        return Verdict(False, "status=needs_help: " + _s(resp.get("help_request"))[:200])
    res = _result_of(resp)
    corpus = res.get("corpus_markdown")
    summary = res.get("change_summary")
    if not isinstance(corpus, str) or len(corpus.strip()) < 40:
        return Verdict(False, "result.corpus_markdown is missing or too short to be a corpus")
    if not isinstance(summary, str) or not summary.strip():
        return Verdict(False, "result.change_summary is missing")
    return Verdict(True, f"corpus of {len(corpus)} chars with a change summary")


# ---------------------------------------------------------------------------
# Job specs
# ---------------------------------------------------------------------------

@dataclass
class JobSpec:
    key: str                    # "A".."D", "KB"
    category: str               # triage | debug | code | kb | human-review
    job_class: str              # queue class
    idempotency_key: str
    title: str
    task: str
    context_base: str
    context_extra: str = ""     # appended from attempt >= 2
    check: Callable[[dict, int], Verdict] = lambda r, a: Verdict(False, "no check")
    role_frame: str = "engineer"
    ground_truth: str = ""


