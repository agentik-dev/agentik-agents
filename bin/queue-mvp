# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + f"{dt.microsecond // 1000:03d}Z"


def parse_ts(s: str) -> datetime | None:
    """Parse an RFC3339 timestamp from the API or the DB, tolerantly.

    The store writes exactly "2006-01-02T15:04:05.000Z" (internal/store/time.go),
    but Go marshals time.Time as RFC3339Nano on the wire, which trims trailing
    zeros and can carry 9 fractional digits — more than fromisoformat accepts on
    some inputs. So the fraction is clamped to 6 digits.
    """
    if not s:
        return None
    t = s.strip().replace("Z", "+00:00")
    m = re.match(r"^(.*\.\d{1,6})\d*(\+\d{2}:\d{2}|-\d{2}:\d{2})?$", t)
    if m:
        t = m.group(1) + (m.group(2) or "")
    try:
        dt = datetime.fromisoformat(t)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def truncate(text: str, limit: int) -> str:
    if text is None:
        return ""
    if len(text) <= limit:
        return text
    return text[:limit] + f"\n… [truncated, {len(text)} chars total]"


def one_line(text: str, limit: int = 220) -> str:
    flat = " ".join(str(text or "").split())
    return flat[:limit]


def md_escape(text: str) -> str:
    return str(text or "").replace("|", "\\|").replace("\n", " ")


# ---------------------------------------------------------------------------
# Incremental event log + run ledger (durable, written as they happen)
# ---------------------------------------------------------------------------

class Journal:
    """One JSON line per event, appended AS IT HAPPENS, plus a ledger snapshot.

    A killed session or a budget abort returns nothing; anything that lives only
    in memory is lost. So: log line first, then act.
    """

    def __init__(self, state_dir: Path, echo: bool = True):
        self.state_dir = state_dir
        self.log_path = state_dir / "orchestrator.log"
        self.ledger_path = state_dir / "ledger.json"
        self.echo = echo
        state_dir.mkdir(parents=True, exist_ok=True)
        self.ledger: dict[str, Any] = self._load_ledger()

    def _load_ledger(self) -> dict[str, Any]:
        if self.ledger_path.exists():
            try:
                data = json.loads(self.ledger_path.read_text())
                data.setdefault("attempts", [])
                data.setdefault("jobs", {})
                data.setdefault("runs", [])
                return data
            except (OSError, json.JSONDecodeError):
                pass
        return {"attempts": [], "jobs": {}, "runs": []}

    def event(self, kind: str, **fields: Any) -> None:
        rec = {"ts": iso(utcnow()), "event": kind}
        rec.update(fields)
        line = scrub(json.dumps(rec, ensure_ascii=False, default=str))
        with self.log_path.open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
        if self.echo:
            detail = " ".join(f"{k}={one_line(v, 90)}" for k, v in fields.items() if k != "prompt")
            print(f"[{rec['ts']}] {kind}: {detail}", flush=True)

    def record_attempt(self, rec: dict) -> None:
        self.ledger["attempts"].append(rec)
        self.flush()
        self.event("attempt_result", **{
            k: rec.get(k) for k in
            ("job_id", "job_key", "attempt", "tier", "model", "status", "accepted",
             "tier_correct", "reason", "cost_usd", "session_id", "raw_result_path", "error")
        })

    def set_job(self, key: str, **fields: Any) -> None:
        entry = self.ledger["jobs"].setdefault(key, {})
        entry.update(fields)
        self.flush()

    def flush(self) -> None:
        tmp = self.ledger_path.with_suffix(".json.tmp")
        tmp.write_text(scrub(json.dumps(self.ledger, indent=2, ensure_ascii=False, default=str)))
        tmp.replace(self.ledger_path)

    @property
    def attempts(self) -> list[dict]:
        return self.ledger["attempts"]

    def rotate_if_completed_run(self) -> None:
        """Archive the previous run's record before starting a new one.

        The ledger and log are RUN-scoped: without this, a live run's report
        and KB pass consume the previous (e.g. dry-run) attempts too —
        measured on 2026-08-13, where the first live corpus cited dry-run
        rehearsal events as evidence. Rotation happens only when the current
        ledger holds a COMPLETED run (spend_api_usd recorded), so a crashed
        run's partial record is kept in place for `report` and resume.
        """
        if "spend_api_usd" not in self.ledger and not self.ledger.get("runs"):
            return  # nothing recorded yet
        if "spend_api_usd" not in self.ledger:
            return  # previous run did not complete; keep its record current
        stamp = utcnow().strftime("%Y%m%dT%H%M%SZ")
        if self.log_path.exists():
            self.log_path.rename(self.state_dir / f"orchestrator-{stamp}.log")
        if self.ledger_path.exists():
            self.ledger_path.rename(self.state_dir / f"ledger-{stamp}.json")
        self.ledger = {"attempts": [], "jobs": {}, "runs": []}
        self.flush()
        self.event("journal_rotated", archived_as=stamp)


# ---------------------------------------------------------------------------
# HTTP client for the job-queue service's REST surface
# ---------------------------------------------------------------------------

class ApiError(RuntimeError):
    def __init__(self, status: int, method: str, url: str, body: str):
        self.status = status
        self.body = body
        super().__init__(f"{method} {url} -> HTTP {status}: {truncate(body, 1200)}")


class Api:
    """Thin stdlib client. Every error carries the response BODY, never just a code."""

    def __init__(self, base_url: str, timeout: int = HTTP_TIMEOUT_S):
        self.base = base_url.rstrip("/")
        self.timeout = timeout

    def request(self, method: str, path: str, body: dict | None = None,
                allow: tuple[int, ...] = ()) -> tuple[int, dict]:
        url = self.base + path
        data = json.dumps(body).encode("utf-8") if body is not None else None
        headers = {"Accept": "application/json"}
        if data is not None:
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                status = resp.status
                raw = resp.read().decode("utf-8", errors="replace")
        except urllib.error.HTTPError as e:
            status = e.code
            raw = e.read().decode("utf-8", errors="replace")
        except urllib.error.URLError as e:
            raise ApiError(0, method, url, f"connection failed: {e.reason}") from e
        except OSError as e:
            raise ApiError(0, method, url, f"connection failed: {e}") from e

        obj: dict = {}
        if raw.strip():
            try:
                parsed = json.loads(raw)
                obj = parsed if isinstance(parsed, dict) else {"body": parsed}
            except json.JSONDecodeError:
                obj = {"_raw": raw}
        if status >= 400 and status not in allow:
            raise ApiError(status, method, url, raw)
        return status, obj

    # --- endpoints ---------------------------------------------------------

    def readyz(self) -> tuple[int, dict]:
        return self.request("GET", "/readyz", allow=(503,))

    def health(self) -> tuple[int, dict]:
        return self.request("GET", "/health", allow=(503,))

    def create_job(self, class_: str, idempotency_key: str, payload: dict,
                   priority: int = PRIORITY, parent_job_id: int | None = None,
                   max_attempts: int | None = None) -> tuple[dict, bool]:
        """Returns (job_view_or_stub, created). 409 -> adopt the existing id."""
        body: dict[str, Any] = {
            "class": class_,
            "idempotency_key": idempotency_key,
            "payload": payload,
            "priority": priority,
            "created_by": CREATED_BY,
        }
        if parent_job_id is not None:
            body["parent_job_id"] = parent_job_id
        if max_attempts is not None:
            body["max_attempts"] = max_attempts
        status, obj = self.request("POST", "/v1/jobs", body, allow=(409,))
        if status == 409:
            job_id = obj.get("job_id")
            if not job_id:
                m = re.search(r"job_id=(\d+)", str(obj.get("detail", "")))
                if m:
                    job_id = int(m.group(1))
            if not job_id:
                # Last resort: find it by class+key through the list filter.
                found = self.find_job(class_, idempotency_key)
                if found is None:
                    raise ApiError(409, "POST", self.base + "/v1/jobs",
                                   json.dumps(obj) + " (and the job could not be located by list)")
                return found, False
            return self.get_job(int(job_id))[0], False
        return obj["job"], True

    def find_job(self, class_: str, idempotency_key: str) -> dict | None:
        _, obj = self.request(
            "GET", f"/v1/jobs?class={class_}&q={urllib.parse.quote(idempotency_key)}&limit=50")
        for j in obj.get("jobs", []):
            if j.get("idempotency_key") == idempotency_key:
                return j
        return None

    def get_job(self, job_id: int) -> tuple[dict, list[dict]]:
        _, obj = self.request("GET", f"/v1/jobs/{job_id}")
        return obj["job"], obj.get("transitions", [])

    def claim_job(self, job_id: int, ttl_s: int = LEASE_TTL_S) -> dict:
        _, obj = self.request("POST", f"/v1/jobs/{job_id}/claim",
                              {"worker": OWNER, "ttl_s": ttl_s})
        return obj

    def claim_next(self, classes: list[str], ttl_s: int = LEASE_TTL_S) -> dict:
        _, obj = self.request("POST", "/v1/jobs/claim-next",
                              {"worker": OWNER, "classes": classes, "ttl_s": ttl_s})
        return obj

    def heartbeat(self, job_id: int, lease_token: str, ttl_s: int = LEASE_TTL_S) -> dict:
        _, obj = self.request("POST", f"/v1/jobs/{job_id}/heartbeat",
                              {"lease_token": lease_token, "ttl_s": ttl_s})
        return obj["job"]

    def transition(self, job_id: int, lease_token: str, to: str, result: dict | None = None,
                   error: str | None = None, retryable: bool = False,
                   detail: str = "", eligible_at: str | None = None) -> dict:
        body: dict[str, Any] = {"lease_token": lease_token, "to": to}
        if result is not None:
            body["result"] = result
        if error:
            body["error"] = error
        if retryable:
            body["retryable"] = True
        if detail:
            body["detail"] = detail
        if eligible_at:
            # The store REQUIRES eligible_at for `deferred` (timed parking).
            body["eligible_at"] = eligible_at
        _, obj = self.request("POST", f"/v1/jobs/{job_id}/transition", body)
        return obj["job"]


import urllib.parse  # noqa: E402  (used by Api.find_job; kept next to its use site)


# ---------------------------------------------------------------------------
# The agent lane
# ---------------------------------------------------------------------------

@dataclass
class AgentOutcome:
    ok: bool                      # the subprocess produced a parseable envelope
    response: dict                # the agent's contract JSON (synthesised on failure)
    cost_usd: float = 0.0
    num_turns: int | None = None
    session_id: str = ""
    is_error: bool = False
    subtype: str = ""
    error: str = ""               # transport/timeout/parse failure, recorded never swallowed
    raw_path: str = ""
    duration_s: float = 0.0


def extract_response_json(text: str) -> tuple[dict | None, str]:
    """Pull the contract object out of the agent's `result` text.

    Strategy: strip markdown fences, try a whole-text parse, then fall back to
    first '{' .. last '}'. Returns (obj_or_None, reason_if_none).
    """
    if not isinstance(text, str) or not text.strip():
        return None, "agent result was empty"
    body = text.strip()
    fence = re.match(r"^```(?:json|JSON)?\s*\n(.*?)\n?```\s*$", body, re.S)
    if fence:
        body = fence.group(1).strip()
    try:
        obj = json.loads(body)
        if isinstance(obj, dict):
            return obj, ""
    except json.JSONDecodeError:
        pass
    start, end = body.find("{"), body.rfind("}")
    if start != -1 and end > start:
        try:
            obj = json.loads(body[start:end + 1])
            if isinstance(obj, dict):
                return obj, ""
        except json.JSONDecodeError as e:
            return None, f"brace-slice parse failed: {e}"
    return None, "no JSON object found in the agent result"


def needs_help_stub(question: str, missing: str, raw_text: str, tier_next: str) -> dict:
    """A parse/transport failure becomes a needs_help response with the raw text kept."""
    return {
        "status": "needs_help",
        "result": {},
        "confidence": 0.0,
        "help_request": {"question": question, "missing": missing, "escalate_to": tier_next},
        "lessons_learned": [{
            "lesson": "An agent response that does not parse as the contract JSON must be treated as needs_help, never as a silent success.",
            "applies_to": "general",
            "evidence": question,
        }],
        "_unparsed_raw": truncate(scrub(raw_text or ""), 4000),
    }


class AgentRunner:
    """Runs one attempt through `claude-api-agent`, or replays a canned response."""

    def __init__(self, state_dir: Path, journal: Journal, dry_run: bool):
        self.state_dir = state_dir
        self.journal = journal
        self.dry_run = dry_run
        self.prompts_dir = state_dir / "prompts"
        self.raw_dir = state_dir / "raw"
        self.prompts_dir.mkdir(parents=True, exist_ok=True)
        self.raw_dir.mkdir(parents=True, exist_ok=True)

    def preflight(self) -> str | None:
        if self.dry_run:
            return None
        if shutil.which(AGENT_BIN) is None:
            return (f"{AGENT_BIN} is not on PATH. Install it, or re-run with --dry-run "
                    f"to exercise the loop with canned responses and zero spend.")
        return None

    def run(self, spec: JobSpec, job_id: int, attempt: int, tier: dict, prompt: str) -> AgentOutcome:
        stem = f"{spec.key}-job{job_id}-attempt{attempt}"
        prompt_path = self.prompts_dir / f"{stem}.prompt.txt"
        prompt_path.write_text(prompt, encoding="utf-8")
        raw_path = self.raw_dir / f"{stem}.envelope.json"

        if self.dry_run:
            canned = CANNED.get((spec.key, attempt))
            if canned is None:
                # No canned answer for this rung means the ladder went somewhere
                # the dry-run script did not model; say so instead of pretending.
                out = needs_help_stub(
                    f"no canned dry-run response exists for {spec.key} attempt {attempt}",
                    "a canned response in CANNED[(key, attempt)]", "", "tech-lead")
                raw_path.write_text(json.dumps({"dry_run": True, "canned": None}, indent=2))
                return AgentOutcome(ok=True, response=out, session_id="dry-run",
                                    subtype="dry_run", raw_path=str(raw_path))
            envelope = {
                "dry_run": True, "is_error": False, "subtype": "success",
                "total_cost_usd": 0.0, "num_turns": 0,
                "session_id": f"dry-run-{spec.key}-{attempt}",
                "result": json.dumps(canned, indent=2),
            }
            raw_path.write_text(json.dumps(envelope, indent=2), encoding="utf-8")
            return AgentOutcome(ok=True, response=json.loads(json.dumps(canned)),
                                cost_usd=0.0, num_turns=0,
                                session_id=envelope["session_id"], subtype="dry_run",
                                raw_path=str(raw_path))

        argv = [
            AGENT_BIN,
            "--profile", "analyze",
            "--model", tier["model"],
            "--effort", tier["effort"],
            "--no-stdin",
            "--tag", "id=queue-mvp",
            "--tag", f"phase={spec.category}",
            "--prompt-file", str(prompt_path),
        ]
        self.journal.event("agent_exec", job_id=job_id, attempt=attempt, tier=tier["tier"],
                           argv=" ".join(argv))
        started = time.monotonic()
        try:
            # stdout and stderr stay SEPARATE: stdout is the JSON envelope and
            # merging stderr into it corrupts every parse.
            proc = subprocess.run(argv, capture_output=True, text=True,
                                  timeout=AGENT_TIMEOUT_S, check=False)
        except subprocess.TimeoutExpired as e:
            elapsed = time.monotonic() - started
            partial = scrub((e.stdout or "") if isinstance(e.stdout, str) else "")
            raw_path.write_text(json.dumps(
                {"timeout_s": AGENT_TIMEOUT_S, "partial_stdout": truncate(partial, 8000)},
                indent=2), encoding="utf-8")
            msg = (f"{AGENT_BIN} exceeded the {AGENT_TIMEOUT_S}s timeout; the attempt is errored "
                   f"and any spend it incurred is FORFEITED (no envelope means no cost to read)")
            self.journal.event("agent_timeout", job_id=job_id, attempt=attempt,
                               tier=tier["tier"], elapsed_s=round(elapsed, 1), detail=msg)
            return AgentOutcome(
                ok=False,
                response=needs_help_stub(msg, "an agent run that completes inside the timeout",
                                         partial, "senior"),
                error=msg, raw_path=str(raw_path), duration_s=elapsed)
        except OSError as e:
            elapsed = time.monotonic() - started
            msg = f"could not execute {AGENT_BIN}: {e}"
            self.journal.event("agent_exec_failed", job_id=job_id, attempt=attempt, detail=msg)
            return AgentOutcome(ok=False,
                                response=needs_help_stub(msg, f"a working {AGENT_BIN} on PATH", "", "senior"),
                                error=msg, raw_path="", duration_s=elapsed)

        elapsed = time.monotonic() - started
        stdout = proc.stdout or ""
        stderr = scrub(proc.stderr or "")
        raw_path.write_text(scrub(stdout), encoding="utf-8")
        if stderr.strip():
            (self.raw_dir / f"{stem}.stderr.txt").write_text(truncate(stderr, 20000), encoding="utf-8")

        envelope, why = extract_response_json(stdout)
        if envelope is None:
            msg = (f"{AGENT_BIN} exit={proc.returncode}: stdout is not a JSON envelope ({why}); "
                   f"stderr tail: {one_line(stderr[-400:], 400)}")
            self.journal.event("agent_envelope_unparseable", job_id=job_id, attempt=attempt,
                               detail=msg, raw_result_path=str(raw_path))
            return AgentOutcome(ok=False,
                                response=needs_help_stub(msg, "a parseable agent envelope", stdout, "senior"),
                                error=msg, raw_path=str(raw_path), duration_s=elapsed)

        cost = float(envelope.get("total_cost_usd") or 0.0)
        session_id = str(envelope.get("session_id") or "")
        is_error = bool(envelope.get("is_error"))
        subtype = str(envelope.get("subtype") or "")
        num_turns = envelope.get("num_turns")

        response, why = extract_response_json(envelope.get("result") or "")
        if response is None:
            msg = f"agent response did not parse as the contract JSON ({why})"
            return AgentOutcome(
                ok=True,
                response=needs_help_stub(msg, "a response that follows the JSON contract",
                                         str(envelope.get("result") or ""), "senior"),
                cost_usd=cost, num_turns=num_turns, session_id=session_id,
                is_error=is_error, subtype=subtype, error=msg,
                raw_path=str(raw_path), duration_s=elapsed)

        if is_error:
            response.setdefault("status", "needs_help")
        return AgentOutcome(ok=True, response=response, cost_usd=cost, num_turns=num_turns,
                            session_id=session_id, is_error=is_error, subtype=subtype,
                            raw_path=str(raw_path), duration_s=elapsed)


# ---------------------------------------------------------------------------
# Prompt assembly
# ---------------------------------------------------------------------------

def digest_of(rec: dict) -> str:
    """One prior attempt, rendered for the next tier."""
    lines = [
        f"### Attempt {rec['attempt']} — {rec['tier']} ({rec['model']})",
        f"reported status: {rec.get('status')}   confidence: {rec.get('confidence')}",
        f"acceptance verdict: {'ACCEPTED' if rec.get('accepted') else 'NOT ACCEPTED'} — {rec.get('reason', '')}",
    ]
    res = rec.get("response_result")
    if res:
        lines.append("their result: " + truncate(json.dumps(res, ensure_ascii=False, indent=2), 1200))
    hr = rec.get("help_request")
    if hr:
        lines.append("their help_request: " + json.dumps(hr, ensure_ascii=False))
    if rec.get("error"):
        lines.append(f"transport/parse note: {rec['error']}")
    lessons = rec.get("lessons") or []
    if lessons:
        lines.append("their lessons: " + "; ".join(one_line(l.get("lesson", ""), 160) for l in lessons))
    return "\n".join(lines)


def build_prompt(spec: JobSpec, job_id: int, attempt: int, tier: dict,
                 prior: list[dict], extra_context: str = "") -> str:
    frame = TIER_FRAMING[tier["tier"]]
    if spec.role_frame != "engineer":
        frame = frame.replace("engineer", spec.role_frame, 1)

    context = spec.context_base
    if attempt >= 2 and spec.context_extra:
        context = context + "\n" + spec.context_extra
    if extra_context:
        context = context + "\n" + extra_context

    parts = [
        f"# queue-mvp job {spec.key} — {spec.title}",
        "",
        f"Queue job id {job_id} (class `{spec.job_class}`, category `{spec.category}`), "
        f"attempt {attempt} of 3, tier: **{tier['tier']}** on model `{tier['model']}` "
        f"at effort `{tier['effort']}`.",
        "",
        "## Who you are",
        frame,
        "",
        ESCALATION_ETIQUETTE,
        "",
        "## Your task",
        spec.task.strip(),
    ]
    if context.strip():
        parts += ["", "## Context (this is all you have; do not assume anything not here)",
                  context.strip()]
    if prior:
        parts += ["", "## Prior attempt digests (read these before you start)"]
        parts += [digest_of(rec) for rec in prior]
    parts += ["", RESPONSE_CONTRACT]
    return "\n".join(parts) + "\n"


def build_kb_task(lessons: list[dict]) -> str:
    payload = json.dumps(lessons, indent=2, ensure_ascii=False)
    return f"""Curate a knowledge corpus from every lesson recorded during this MVP run.

Below are {len(lessons)} raw lessons, each tagged with the queue job id, its
category, the tier that produced it, and whether that attempt was accepted.
Lessons from FAILED and ESCALATED attempts are included on purpose: they are
often the transferable ones.

Do this:
  1. dedupe near-identical lessons (merge them, keep every evidence pointer),
  2. generalize each to something a future agent can apply without this run's
     specifics, but never so far that it stops being actionable,
  3. group by category (triage / debug / code / general),
  4. keep an evidence pointer on every entry: (job <id>, <tier>) plus the
     concrete observation that taught it.

Return result = {{"corpus_markdown": "<the full markdown document>",
"change_summary": "<what you merged, dropped and generalized, with counts>"}}.

Acceptance bar: corpus_markdown is a complete markdown document with per-category
sections and evidence pointers; change_summary states the counts.

## Raw lessons (JSON)

{payload}
"""


# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------

@dataclass
class RunState:
    api: Api
    runner: AgentRunner
    journal: Journal
    max_api_usd: float
    dry_run: bool
    spend: float = 0.0
    budget_stopped: bool = False
    job_ids: dict[str, int] = field(default_factory=dict)


def payload_for(spec: JobSpec) -> dict:
    return {
        "category": spec.category,
        "title": spec.title,
        "task": spec.task.strip(),
        "context": spec.context_base.strip(),
        "context_after_escalation": spec.context_extra.strip() or None,
        "ground_truth_note": spec.ground_truth,
        "source": "queue-mvp",
        "mock": True,
    }


def seed(st: RunState) -> dict[str, int]:
    """Create the four mock jobs. Idempotent: a 409 adopts the existing id."""
    ids: dict[str, int] = {}
    for spec in SEEDED_JOBS:
        job, created = st.api.create_job(spec.job_class, spec.idempotency_key, payload_for(spec))
        ids[spec.key] = int(job["id"])
        st.journal.event("job_seeded" if created else "job_adopted",
                         job_key=spec.key, job_id=job["id"], job_class=spec.job_class,
                         idempotency_key=spec.idempotency_key, status=job.get("status"),
                         attempts=job.get("attempts"))
        st.journal.set_job(spec.key, job_id=int(job["id"]), category=spec.category,
                           job_class=spec.job_class, idempotency_key=spec.idempotency_key,
                           title=spec.title)
    st.job_ids.update(ids)
    return ids


def wait_until_eligible(st: RunState, job_id: int) -> dict:
    """Poll GET /v1/jobs/{id} and sleep out the store's backoff before re-claiming."""
    while True:
        job, _ = st.api.get_job(job_id)
        status = job.get("status")
        if status in TERMINAL_STATUSES:
            return job
        eligible = parse_ts(job.get("eligible_at", ""))
        now = utcnow()
        if status == "pending" and (eligible is None or eligible <= now):
            return job
        if eligible is None:
            time.sleep(1.0)
            continue
        delta = (eligible - now).total_seconds() + 0.5
        if delta <= 0:
            time.sleep(0.5)
            continue
        if delta > MAX_BACKOFF_WAIT_S:
            raise RuntimeError(
                f"job {job_id} is not eligible until {job.get('eligible_at')} "
                f"({delta:.0f}s away), which is beyond this orchestrator's {MAX_BACKOFF_WAIT_S}s "
                f"wait cap; re-run `run` later — the state is durable")
        st.journal.event("backoff_wait", job_id=job_id, seconds=round(delta, 1),
                         eligible_at=job.get("eligible_at"), status=status)
        time.sleep(delta)


def defer_remaining(st: RunState, spec: JobSpec, job_id: int, reason: str) -> None:
    """Budget stop: park a still-pending job for a day. deferred REQUIRES eligible_at."""
    job, _ = st.api.get_job(job_id)
    if job.get("status") in TERMINAL_STATUSES or job.get("status") == "deferred":
        st.journal.event("defer_skipped", job_id=job_id, status=job.get("status"))
        return
    if job.get("status") != "pending":
        st.journal.event("defer_skipped", job_id=job_id, status=job.get("status"),
                         detail="not pending; cannot claim to defer")
        return
    if int(job.get("attempts", 0)) >= int(job.get("max_attempts", 3)):
        st.journal.event("defer_skipped", job_id=job_id, detail="attempts exhausted; cannot claim")
        return
    claim = st.api.claim_job(job_id, ttl_s=120)
    if not claim.get("claimed"):
        st.journal.event("defer_skipped", job_id=job_id, detail="claim returned claimed=false")
        return
    token = claim["lease_token"]
    eligible = iso(utcnow() + timedelta(hours=24))
    st.api.transition(job_id, token, "deferred", error=reason, eligible_at=eligible,
                      detail="queue-mvp budget stop")
    st.journal.event("job_deferred", job_id=job_id, job_key=spec.key,
                     eligible_at=eligible, reason=reason)
    st.journal.set_job(spec.key, final_status="deferred", deferred_until=eligible)


def escalate_to_human(st: RunState, spec: JobSpec, job_id: int, lease_token: str,
                      prior: list[dict], job_cost: float) -> int:
    """Last rung failed. Never transition failed+retryable here — that TOMBSTONES.

    Instead: create a human job carrying the whole history, then close the
    original `done` pointing at it. The work is not lost and the queue is honest.
    """
    digests = [digest_of(r) for r in prior]
    human_payload = {
        "reason": "tier ladder exhausted",
        "category": spec.category,
        "origin_job_id": job_id,
        "origin_idempotency_key": spec.idempotency_key,
        "title": f"[queue-mvp] human decision needed: {spec.title}",
        "task": spec.task.strip(),
        "context": spec.context_base.strip() + ("\n" + spec.context_extra.strip() if spec.context_extra else ""),
        "history": digests,
        "ground_truth_note": spec.ground_truth,
    }
    human_job, created = st.api.create_job(
        "human", f"mvp:human-escalation:{job_id}", human_payload, parent_job_id=job_id)
    human_id = int(human_job["id"])
    st.journal.event("human_escalation" if created else "human_escalation_adopted",
                     origin_job_id=job_id, human_job_id=human_id, job_key=spec.key)
    result = {
        "category": spec.category,
        "tier_resolved": "human",
        "model": None,
        "attempts": len(prior),
        "escalated_to_human_job": human_id,
        "response": prior[-1].get("response") if prior else None,
        "api_cost_usd_total": round(job_cost, 6),
        "note": ("the three-rung tier ladder did not clear the acceptance bar; the job is closed "
                 "done because a poison-pill retry would tombstone it, and the open question now "
                 f"lives in human job {human_id}"),
    }
    st.api.transition(job_id, lease_token, "done", result=result,
                      detail=f"escalated to human job {human_id}")
    st.journal.event("job_done", job_id=job_id, job_key=spec.key, outcome="escalated_to_human",
                     human_job_id=human_id)
    st.journal.set_job(spec.key, final_status="done", outcome="escalated_to_human",
                       human_job_id=human_id, api_cost_usd=round(job_cost, 6))
    return human_id


def run_ladder(st: RunState, spec: JobSpec, job_id: int,
               claim_via_next: bool = False,
               task_override: str = "") -> dict:
    """Work one job up the tier ladder. Returns a small summary dict."""
    if task_override:
        spec = JobSpec(**{**spec.__dict__, "task": task_override})

    job, _ = st.api.get_job(job_id)
    if job.get("status") in TERMINAL_STATUSES:
        st.journal.event("job_skipped_terminal", job_id=job_id, job_key=spec.key,
                         status=job.get("status"))
        st.journal.set_job(spec.key, final_status=job.get("status"), outcome="already_terminal")
        return {"job_id": job_id, "outcome": "already_terminal", "status": job.get("status")}
    if job.get("status") == "leased":
        st.journal.event("job_skipped_leased", job_id=job_id, job_key=spec.key,
                         lease_owner=job.get("lease_owner"),
                         lease_expires_at=job.get("lease_expires_at"),
                         detail="another holder has the lease; the sweeper reclaims it on expiry")
        return {"job_id": job_id, "outcome": "leased_elsewhere", "status": "leased"}
    if job.get("status") == "deferred":
        st.journal.event("job_skipped_deferred", job_id=job_id, job_key=spec.key,
                         eligible_at=job.get("eligible_at"))
        return {"job_id": job_id, "outcome": "deferred", "status": "deferred"}

    prior: list[dict] = [a for a in st.journal.attempts if a.get("job_id") == job_id]
    job_cost = sum(float(a.get("cost_usd") or 0.0) for a in prior)

    while True:
        job = wait_until_eligible(st, job_id)
        if job.get("status") in TERMINAL_STATUSES:
            return {"job_id": job_id, "outcome": "terminal_during_wait", "status": job["status"]}

        attempts_used = int(job.get("attempts", 0))
        max_attempts = int(job.get("max_attempts", 3))
        if attempts_used >= max_attempts:
            # Cannot claim (ClaimJob demands attempts < max_attempts) and cannot
            # transition without a lease. Route it to a human and say so.
            human_payload = {
                "reason": "attempts exhausted before this orchestrator could close the job "
                          "(likely a crashed earlier run)",
                "origin_job_id": job_id,
                "history": [digest_of(r) for r in prior],
            }
            hj, _ = st.api.create_job("human", f"mvp:human-escalation:{job_id}",
                                      human_payload, parent_job_id=job_id)
            st.journal.event("job_unclaimable", job_id=job_id, job_key=spec.key,
                             attempts=attempts_used, human_job_id=hj["id"],
                             detail="attempts >= max_attempts while still non-terminal")
            return {"job_id": job_id, "outcome": "unclaimable", "human_job_id": int(hj["id"])}

        # Budget guard before any dispatch.
        if st.spend > st.max_api_usd:
            st.budget_stopped = True
            st.journal.event("budget_stop", spend_usd=round(st.spend, 6),
                             max_api_usd=st.max_api_usd, job_id=job_id)
            return {"job_id": job_id, "outcome": "budget_stopped"}

        if claim_via_next:
            claim = st.api.claim_next([spec.job_class])
            if not claim.get("claimed"):
                st.journal.event("claim_next_empty", job_class=spec.job_class, job_id=job_id)
                return {"job_id": job_id, "outcome": "claim_failed"}
            claimed_id = int(claim["job"]["id"])
            if claimed_id != job_id:
                st.journal.event("claim_next_mismatch", expected=job_id, got=claimed_id,
                                 detail="claim-next took a different job of this class; "
                                        "releasing it back is not possible without failing it, "
                                        "so it is left leased until the sweeper reclaims it")
                return {"job_id": job_id, "outcome": "claim_mismatch", "claimed_id": claimed_id}
            job = claim["job"]
        else:
            claim = st.api.claim_job(job_id)
            if not claim.get("claimed"):
                st.journal.event("claim_failed", job_id=job_id)
                return {"job_id": job_id, "outcome": "claim_failed"}
            job = claim["job"]

        lease_token = claim["lease_token"]
        attempt = int(job.get("attempts", len(prior) + 1))
        attempt = max(1, min(attempt, len(TIERS)))
        tier = TIERS[attempt - 1]
        st.journal.event("job_claimed", job_id=job_id, job_key=spec.key, attempt=attempt,
                         tier=tier["tier"], model=tier["model"],
                         lease_expires_at=claim.get("lease_expires_at"))

        prompt = build_prompt(spec, job_id, attempt, tier, prior)
        st.journal.event("attempt_start", job_id=job_id, job_key=spec.key, attempt=attempt,
                         tier=tier["tier"], model=tier["model"], effort=tier["effort"],
                         prompt_chars=len(prompt))

        outcome = st.runner.run(spec, job_id, attempt, tier, prompt)
        st.spend += outcome.cost_usd
        job_cost += outcome.cost_usd

        # Slide the lease if the attempt was long, so the transition below cannot
        # lose a race with the sweeper.
        if outcome.duration_s > HEARTBEAT_AFTER_S:
            try:
                st.api.heartbeat(job_id, lease_token)
                st.journal.event("heartbeat", job_id=job_id, attempt=attempt)
            except ApiError as e:
                st.journal.event("heartbeat_failed", job_id=job_id, attempt=attempt, detail=str(e))

        resp = outcome.response
        try:
            verdict = spec.check(resp, attempt)
        except Exception as e:  # a broken check must not eat the attempt
            verdict = Verdict(False, f"acceptance check raised {type(e).__name__}: {e}")

        rec = {
            "job_id": job_id,
            "job_key": spec.key,
            "category": spec.category,
            "idempotency_key": spec.idempotency_key,
            "attempt": attempt,
            "tier": tier["tier"],
            "model": tier["model"],
            "effort": tier["effort"],
            "session_id": outcome.session_id,
            "cost_usd": round(outcome.cost_usd, 6),
            "num_turns": outcome.num_turns,
            "duration_s": round(outcome.duration_s, 1),
            "status": resp.get("status"),
            "confidence": resp.get("confidence"),
            "accepted": verdict.accepted,
            "tier_correct": verdict.tier_correct,
            "reason": verdict.reason,
            "help_request": resp.get("help_request"),
            "lessons": resp.get("lessons_learned") or [],
            "response": resp,
            "response_result": resp.get("result"),
            "raw_result_path": outcome.raw_path,
            "prompt_path": str(st.runner.prompts_dir / f"{spec.key}-job{job_id}-attempt{attempt}.prompt.txt"),
            "error": outcome.error,
            "envelope_is_error": outcome.is_error,
            "envelope_subtype": outcome.subtype,
        }
        st.journal.record_attempt(rec)
        prior = prior + [rec]

        if verdict.accepted:
            result = {
                "category": spec.category,
                "tier_resolved": tier["tier"],
                "model": tier["model"],
                "attempts": attempt,
                "response": resp,
                "api_cost_usd_total": round(job_cost, 6),
                "acceptance": verdict.reason,
            }
            st.api.transition(job_id, lease_token, "done", result=result,
                              detail=f"accepted at tier {tier['tier']} on attempt {attempt}")
            st.journal.event("job_done", job_id=job_id, job_key=spec.key,
                             tier_resolved=tier["tier"], attempts=attempt,
                             api_cost_usd=round(job_cost, 6))
            st.journal.set_job(spec.key, final_status="done", outcome="accepted",
                               tier_resolved=tier["tier"], attempts=attempt,
                               api_cost_usd=round(job_cost, 6))
            return {"job_id": job_id, "outcome": "accepted", "tier": tier["tier"],
                    "attempts": attempt, "response": resp, "cost": job_cost}

        # Not accepted. Last rung -> human, never failed+retryable (tombstone).
        if attempt >= max_attempts or attempt >= len(TIERS):
            human_id = escalate_to_human(st, spec, job_id, lease_token, prior, job_cost)
            return {"job_id": job_id, "outcome": "escalated_to_human",
                    "human_job_id": human_id, "attempts": attempt, "cost": job_cost}

        hr = resp.get("help_request") or {}
        one = one_line(
            f"{'needs_help' if resp.get('status') == 'needs_help' else 'rejected'}: {verdict.reason}"
            + (f" | question: {hr.get('question')}" if hr.get("question") else ""),
            480)
        st.api.transition(job_id, lease_token, "failed", error=one, retryable=True,
                          detail=f"tier {tier['tier']} did not clear the bar; escalating")
        st.journal.event("job_retryable_failed", job_id=job_id, job_key=spec.key,
                         attempt=attempt, tier=tier["tier"], error=one,
                         tier_correct=verdict.tier_correct)

        if st.spend > st.max_api_usd:
            st.budget_stopped = True
            st.journal.event("budget_stop", spend_usd=round(st.spend, 6),
                             max_api_usd=st.max_api_usd, job_id=job_id)
            return {"job_id": job_id, "outcome": "budget_stopped"}
        # loop: wait out the backoff, re-claim, next tier


def collect_lessons(journal: Journal) -> list[dict]:
    out: list[dict] = []
    for rec in journal.attempts:
        if rec.get("job_key") == "KB":
            continue
        for l in rec.get("lessons") or []:
            if not isinstance(l, dict):
                l = {"lesson": str(l), "applies_to": rec.get("category"), "evidence": ""}
            out.append({
                "job_id": rec.get("job_id"),
                "job_key": rec.get("job_key"),
                "category": rec.get("category"),
                "tier": rec.get("tier"),
                "attempt": rec.get("attempt"),
                "attempt_accepted": rec.get("accepted"),
                "lesson": l.get("lesson"),
                "applies_to": l.get("applies_to"),
                "evidence": l.get("evidence"),
            })
    return out


def kb_pass(st: RunState, state_dir: Path) -> dict:
    lessons = collect_lessons(st.journal)
    if not lessons:
        st.journal.event("kb_skipped", detail="no lessons were collected; nothing to curate")
        return {"outcome": "skipped"}

    job, created = st.api.create_job(KB_SPEC.job_class, KB_SPEC.idempotency_key, {
        "category": "kb",
        "title": KB_SPEC.title,
        "lesson_count": len(lessons),
        "source": "queue-mvp",
    })
    kb_id = int(job["id"])
    st.job_ids["KB"] = kb_id
    st.journal.event("job_seeded" if created else "job_adopted", job_key="KB", job_id=kb_id,
                     job_class="kb", idempotency_key=KB_SPEC.idempotency_key,
                     status=job.get("status"))
    st.journal.set_job("KB", job_id=kb_id, category="kb", job_class="kb",
                       idempotency_key=KB_SPEC.idempotency_key, title=KB_SPEC.title)

    # claim-next (class-filtered) here, so both claim paths are exercised.
    summary = run_ladder(st, KB_SPEC, kb_id, claim_via_next=True,
                         task_override=build_kb_task(lessons))

    corpus_path = state_dir / "kb" / "corpus.md"
    if summary.get("outcome") == "accepted":
        res = _result_of(summary["response"])
        corpus = res.get("corpus_markdown", "")
        change_summary = res.get("change_summary", "")
        corpus_path.parent.mkdir(parents=True, exist_ok=True)
        header = (f"<!-- generated by queue-mvp at {iso(utcnow())} "
                  f"from {len(lessons)} raw lessons; kb job {kb_id} -->\n\n")
        corpus_path.write_text(header + corpus.rstrip() + "\n", encoding="utf-8")
        st.journal.event("kb_corpus_written", path=str(corpus_path), chars=len(corpus),
                         lessons_in=len(lessons))
        st.journal.set_job("KB", corpus_path=str(corpus_path), change_summary=change_summary)
        # Record the corpus path on the job result too, so the queue points at the
        # artifact and not just at the prose. (The done transition already
        # happened inside run_ladder; this is the durable pointer for the report.)
        st.journal.ledger.setdefault("kb", {})
        st.journal.ledger["kb"] = {"job_id": kb_id, "corpus_path": str(corpus_path),
                                   "change_summary": change_summary,
                                   "lesson_count": len(lessons)}
        st.journal.flush()
        return {"outcome": "accepted", "job_id": kb_id, "corpus_path": str(corpus_path),
                "change_summary": change_summary}
    st.journal.event("kb_not_accepted", job_id=kb_id, detail=json.dumps(summary, default=str)[:400])
    return {"outcome": summary.get("outcome"), "job_id": kb_id}


def create_human_review(st: RunState, report_path: Path, corpus_path: Path | None) -> int:
    payload = {
        "ask": "review the MVP run",
        "report": str(report_path),
        "corpus": str(corpus_path) if corpus_path else None,
        "what_to_check": [
            "did each acceptance check judge the right thing?",
            "was the escalation at each tier justified by the response?",
            "is the distilled corpus worth keeping?",
        ],
        "source": "queue-mvp",
    }
    job, created = st.api.create_job("human", HUMAN_REVIEW_KEY, payload)
    hid = int(job["id"])
    st.journal.event("human_review_created" if created else "human_review_adopted",
                     job_id=hid, status=job.get("status"),
                     detail="left PENDING on purpose: this is the human lane in the queue")
    st.journal.set_job("HUMAN", job_id=hid, category="human-review", job_class="human",
                       idempotency_key=HUMAN_REVIEW_KEY, final_status=job.get("status"))
    return hid


# ---------------------------------------------------------------------------
# The report
# ---------------------------------------------------------------------------

def db_jobs(db_path: Path) -> list[dict]:
    """Read the MVP's jobs straight from SQLite, read-only."""
    if not db_path.exists():
        raise FileNotFoundError(f"database not found: {db_path}")
    uri = f"file:{urllib.parse.quote(str(db_path))}?mode=ro"
    with sqlite3.connect(uri, uri=True, timeout=10) as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute(
            "SELECT id, class, idempotency_key, status, payload, result, error, parent_job_id,"
            " priority, attempts, max_attempts, eligible_at, created_at, started_at, completed_at,"
            " created_by, total_cost_usd"
            " FROM jobs WHERE idempotency_key LIKE 'mvp:%' ORDER BY id ASC").fetchall()
        return [dict(r) for r in rows]


def db_transitions(db_path: Path, job_id: int) -> list[dict]:
    uri = f"file:{urllib.parse.quote(str(db_path))}?mode=ro"
    with sqlite3.connect(uri, uri=True, timeout=10) as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute(
            "SELECT ts, entity, entity_id, from_status, to_status, actor, detail"
            " FROM transitions WHERE entity = 'job' AND entity_id = ? ORDER BY id ASC",
            (job_id,)).fetchall()
        return [dict(r) for r in rows]


def render_report(args, journal: Journal) -> str:
    db_path = Path(args.db).expanduser()
    state_dir = Path(args.state_dir).expanduser()
    report_path = Path(args.report).expanduser()

    try:
        jobs = db_jobs(db_path)
        db_error = ""
    except (FileNotFoundError, sqlite3.Error) as e:
        jobs, db_error = [], str(e)

    attempts = journal.attempts
    by_job: dict[int, list[dict]] = {}
    for a in attempts:
        by_job.setdefault(int(a.get("job_id", 0)), []).append(a)

    spec_by_key = {s.key: s for s in SEEDED_JOBS}
    spec_by_key["KB"] = KB_SPEC
    key_by_idem = {s.idempotency_key: s.key for s in SEEDED_JOBS}
    key_by_idem[KB_SPEC.idempotency_key] = "KB"

    models_used = sorted({a.get("model") for a in attempts if a.get("model")})
    api_total = sum(float(a.get("cost_usd") or 0.0) for a in attempts)
    by_tier: dict[str, tuple[int, float]] = {}
    for a in attempts:
        n, c = by_tier.get(a.get("tier", "?"), (0, 0.0))
        by_tier[a.get("tier", "?")] = (n + 1, c + float(a.get("cost_usd") or 0.0))

    kb_info = journal.ledger.get("kb", {})
    corpus_path = kb_info.get("corpus_path") or str(state_dir / "kb" / "corpus.md")

    L: list[str] = []
    L.append("# queue-mvp run report")
    L.append("")
    L.append(f"- generated: `{iso(utcnow())}`")
    L.append(f"- base-url: `{args.base_url}`")
    L.append(f"- db: `{db_path}`")
    L.append(f"- state-dir: `{state_dir}`")
    L.append(f"- mode: {'**--dry-run** (canned responses, zero spend)' if args.dry_run else 'live API lane'}")
    L.append(f"- models used: {', '.join(f'`{m}`' for m in models_used) if models_used else '(none recorded)'}")
    L.append(f"- tier ladder: " + " → ".join(f"attempt {t['attempt']} `{t['model']}`/{t['effort']} ({t['tier']})" for t in TIERS))
    L.append(f"- attempts recorded: {len(attempts)} across {len(by_job)} jobs")
    if db_error:
        L.append("")
        L.append(f"> **WARNING** the database could not be read, so job rows and the transition "
                 f"audit trail are missing from this report: `{md_escape(db_error)}`")
    L.append("")
    L.append("This run was orchestrated by `claude-code-agents/bin/queue-mvp`, the interim orchestrator. "
             "A real orchestrator agent is future work; everything below is durable in the "
             "queue database and `<state-dir>/orchestrator.log`.")
    L.append("")

    # --- per job ----------------------------------------------------------
    L.append("## Jobs")
    for job in jobs:
        key = key_by_idem.get(job["idempotency_key"], "")
        spec = spec_by_key.get(key)
        category = (spec.category if spec else
                    ("human-review" if job["idempotency_key"] == HUMAN_REVIEW_KEY else
                     "human-escalation" if job["idempotency_key"].startswith("mvp:human-escalation:")
                     else job["class"]))
        L.append("")
        L.append(f"### job {job['id']} — {category} (`{job['class']}`)")
        L.append("")
        L.append(f"- idempotency key: `{job['idempotency_key']}`")
        L.append(f"- final status: **{job['status']}**")
        L.append(f"- attempts: {job['attempts']}/{job['max_attempts']}   priority: {job['priority']}   "
                 f"created_by: `{job['created_by']}`")
        if job.get("parent_job_id"):
            L.append(f"- parent job: {job['parent_job_id']}")
        L.append(f"- created: `{job['created_at']}`   eligible: `{job['eligible_at']}`   "
                 f"completed: `{job['completed_at'] or '-'}`")
        if job.get("error"):
            L.append(f"- last error: `{md_escape(job['error'])}`")
        if spec and spec.ground_truth:
            L.append(f"- planted ground truth: {spec.ground_truth}")

        recs = sorted(by_job.get(int(job["id"]), []), key=lambda r: r.get("attempt", 0))
        if recs:
            L.append("")
            L.append("| # | tier | model | agent status | accepted | verdict | cost USD | session_id | help question |")
            L.append("|---|------|-------|--------------|----------|---------|----------|------------|---------------|")
            for r in recs:
                hr = r.get("help_request") or {}
                acc = "yes" if r.get("accepted") else ("no (correct escalation)" if r.get("tier_correct") else "no")
                L.append("| {a} | {t} | `{m}` | {s} | {acc} | {v} | {c:.4f} | `{sid}` | {q} |".format(
                    a=r.get("attempt"), t=r.get("tier"), m=r.get("model"),
                    s=md_escape(r.get("status")), acc=acc,
                    v=md_escape(one_line(r.get("reason"), 160)),
                    c=float(r.get("cost_usd") or 0.0),
                    sid=md_escape(r.get("session_id") or "-"),
                    q=md_escape(one_line(hr.get("question", "") if isinstance(hr, dict) else "", 140)) or "-"))
            for r in recs:
                if r.get("error"):
                    L.append("")
                    L.append(f"> attempt {r['attempt']} transport/parse note: `{md_escape(r['error'])}`")
                    L.append(f"> raw envelope: `{r.get('raw_result_path') or '(none)'}`")
        else:
            L.append("")
            L.append("_no agent attempts recorded for this job (it was seeded, adopted, or "
                     "created as a follow-on)._")

        L.append("")
        L.append("**Final result JSON**")
        L.append("")
        L.append("```json")
        if job.get("result"):
            try:
                pretty = json.dumps(json.loads(job["result"]), indent=2, ensure_ascii=False)
            except json.JSONDecodeError:
                pretty = job["result"]
            L.append(truncate(pretty, 2000))
        else:
            L.append(f'{{"note": "no result: job is {job["status"]}"}}')
        L.append("```")

        L.append("")
        L.append("**Transitions (verbatim audit rows from the `transitions` table)**")
        L.append("")
        if db_error:
            L.append("_database unreadable; see the warning above._")
        else:
            trs = db_transitions(db_path, int(job["id"]))
            if not trs:
                L.append("_none_")
            else:
                L.append("| ts | entity | entity_id | from | to | actor | detail |")
                L.append("|----|--------|-----------|------|----|-------|--------|")
                for t in trs:
                    L.append("| `{ts}` | {e} | {eid} | {f} | **{to}** | `{a}` | {d} |".format(
                        ts=t["ts"], e=t["entity"], eid=t["entity_id"],
                        f=t["from_status"] or "-", to=t["to_status"],
                        a=md_escape(t["actor"]), d=md_escape(t["detail"] or "")))

    if not jobs and not db_error:
        L.append("")
        L.append("_no jobs with an `mvp:` idempotency key were found in the database._")

    # --- lessons ----------------------------------------------------------
    lessons = collect_lessons(journal)
    L.append("")
    L.append("## Lessons learned (every attempt, accepted or not)")
    L.append("")
    if lessons:
        L.append("| job | category | tier | attempt accepted | applies_to | lesson | evidence |")
        L.append("|-----|----------|------|------------------|------------|--------|----------|")
        for l in lessons:
            L.append("| {j} | {c} | {t} | {a} | {ap} | {le} | {ev} |".format(
                j=l.get("job_id"), c=l.get("category"), t=l.get("tier"),
                a="yes" if l.get("attempt_accepted") else "no",
                ap=md_escape(l.get("applies_to")),
                le=md_escape(one_line(l.get("lesson"), 220)),
                ev=md_escape(one_line(l.get("evidence"), 160))))
    else:
        L.append("_none recorded._")

    L.append("")
    L.append("## KB pass")
    L.append("")
    if kb_info:
        L.append(f"- kb job: {kb_info.get('job_id')}")
        L.append(f"- raw lessons in: {kb_info.get('lesson_count')}")
        L.append(f"- corpus: `{corpus_path}`")
        L.append("")
        L.append("**change_summary**")
        L.append("")
        L.append("> " + md_escape(kb_info.get("change_summary", "")))
    else:
        L.append(f"_the KB pass did not complete; no corpus was written to `{corpus_path}`._")

    # --- spend: two ledgers, never summed ---------------------------------
    L.append("")
    L.append("## Spend")
    L.append("")
    L.append("**The rule: these two ledgers are never added together.** They are different "
             "currencies of account — one is dollars billed to the Anthropic API key, the other "
             "is capacity consumed on a human's subscription seat. A combined number would be "
             "meaningless and would hide which budget is actually being spent.")
    L.append("")
    L.append(f"- **API lane (actual dollars, from `total_cost_usd` in each agent envelope): "
             f"${api_total:.4f} across {len(attempts)} runs.** By tier:")
    if by_tier:
        for tier, (n, c) in sorted(by_tier.items()):
            L.append(f"  - {tier}: {n} run(s), ${c:.4f}")
    else:
        L.append("  - (no runs recorded)")
    if args.dry_run:
        L.append("  - _this was a `--dry-run`: no agent process was spawned and nothing billed._")
    L.append(f"- **Subscription lane:** this orchestrator ran on the operator's seat. No estimate "
             f"is computed here — see `tools/spend.py`.")
    L.append(f"- budget guard: `--max-api-usd {args.max_api_usd}`"
             + ("  **— TRIPPED: remaining jobs were deferred for 24h with error "
                "'mvp budget stop'.**" if journal.ledger.get("budget_stopped") else ""))

    # --- how to re-run ----------------------------------------------------
    L.append("")
    L.append("## How to re-run")
    L.append("")
    L.append("```sh")
    L.append("# 0. the service must be running against THIS database:")
    L.append(f"#    {serve_cmd(db_path)}")
    L.append(f"curl -s {args.base_url}/readyz | python3 -m json.tool")
    L.append("")
    L.append("# 1. safe rehearsal: no agent processes, no spend, real queue + real acceptance checks")
    L.append(f"queue-mvp all --dry-run --base-url {args.base_url} --db {db_path} \\")
    L.append(f"  --state-dir {state_dir} --report {report_path}")
    L.append("")
    L.append("# 2. live API lane (money): seed, run the ladder, KB pass, report")
    L.append(f"queue-mvp all --base-url {args.base_url} --db {db_path} \\")
    L.append(f"  --state-dir {state_dir} --report {report_path} --max-api-usd {args.max_api_usd}")
    L.append("")
    L.append("# individual phases (seeding adopts existing jobs; terminal jobs are reported, not re-run)")
    L.append("queue-mvp seed")
    L.append("queue-mvp run")
    L.append("queue-mvp report")
    L.append("")
    L.append("# validate the agent argv before the first live run (unknown flags are silently ignored)")
    L.append(f"uv run tools/flagcheck.py refresh {AGENT_BIN}")
    L.append(f"uv run tools/flagcheck.py check {AGENT_BIN} --context queue-mvp -- \\")
    L.append("  --profile analyze --model claude-sonnet-5 --effort medium --no-stdin \\")
    L.append("  --tag id=queue-mvp --tag phase=triage --prompt-file /tmp/p.txt")
    L.append("uv run tools/flagcheck.py report")
    L.append("```")
    L.append("")
    L.append("## How to query the queue afterwards")
    L.append("")
    L.append("```sh")
    L.append("# every MVP job, newest first")
    L.append(f"curl -s '{args.base_url}/v1/jobs?q=mvp:&limit=50' | python3 -m json.tool")
    L.append("")
    L.append("# just the human lane (the review job is left PENDING on purpose)")
    L.append(f"curl -s '{args.base_url}/v1/jobs?class=human&status=pending' | python3 -m json.tool")
    L.append("")
    L.append("# one job, with the transition history the API does expose on GET")
    L.append(f"curl -s '{args.base_url}/v1/jobs/1' | python3 -m json.tool")
    L.append("")
    L.append("# follow-on lineage: whatever a job escalated into")
    L.append(f"curl -s '{args.base_url}/v1/jobs?parent_id=1' | python3 -m json.tool")
    L.append("")
    L.append("# the audit trail has no REST route of its own; read it from SQLite (read-only)")
    L.append(f"sqlite3 -readonly '{db_path}' \\")
    L.append("  \"SELECT ts, entity_id, from_status, to_status, actor, detail FROM transitions \\")
    L.append("    WHERE entity='job' ORDER BY id;\"")
    L.append("```")
    L.append("")
    L.append(f"Event log: `{journal.log_path}` (one JSON line per event, appended as it happened). "
             f"Attempt ledger: `{journal.ledger_path}`. Prompts: `{state_dir / 'prompts'}`. "
             f"Raw envelopes: `{state_dir / 'raw'}`.")
    L.append("")
    return "\n".join(L)


def write_report(args, journal: Journal) -> Path:
    report_path = Path(args.report).expanduser()
    report_path.parent.mkdir(parents=True, exist_ok=True)
    text = scrub(render_report(args, journal))
    report_path.write_text(text, encoding="utf-8")
    journal.event("report_written", path=str(report_path), chars=len(text))
    return report_path


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def preflight_service(api: Api, journal: Journal) -> None:
    """The service must be up. Reachability is fatal; a red check is loud, not fatal."""
    try:
        hstatus, health = api.health()
    except ApiError as e:
        raise SystemExit(
            f"the job-queue service is not reachable at {api.base}: {e.body}\n"
            f"  start it ({serve_cmd('<--db>')}; QUEUE_MVP_SERVE_CMD sets this line) and check --base-url.\n"
            f"  nothing was seeded, claimed or spent.")
    status, ready = api.readyz()
    checks = ready.get("checks", [])
    failing = [c for c in checks if not c.get("ok")]
    journal.event("readyz", http_status=status, state=ready.get("status"),
                  failing=[c.get("name") for c in failing])
    if status == 200:
        return
    names = ", ".join(c.get("name", "?") for c in failing) or "(unnamed)"
    store_red = any(c.get("name") == "store" for c in failing)
    if store_red or hstatus != 200:
        raise SystemExit(
            f"the job-queue service at {api.base} is NOT ready and its store check is red: {names}\n"
            + "\n".join(f"    - {c.get('name')}: {c.get('error')}" for c in failing)
            + "\n  refusing to run: a queue whose database check fails cannot hold this run durably.")
    print(f"WARNING: {api.base}/readyz is {status} (not_ready). Failing checks: {names}", file=sys.stderr)
    for c in failing:
        print(f"    - {c.get('name')}: {one_line(c.get('error'), 300)}", file=sys.stderr)
    print("  /v1/jobs is served regardless of readiness (internal/api/api.go mounts routes "
          "independently of /readyz), and the store check is green, so this run continues. "
          "Fix the red checks before trusting anything beyond the queue.", file=sys.stderr)


def cmd_seed(args, journal: Journal) -> dict[str, int]:
    api = Api(args.base_url)
    preflight_service(api, journal)
    st = RunState(api=api, runner=AgentRunner(Path(args.state_dir).expanduser(), journal, args.dry_run),
                  journal=journal, max_api_usd=args.max_api_usd, dry_run=args.dry_run)
    ids = seed(st)
    print(f"seeded/adopted: " + ", ".join(f"{k}={v}" for k, v in ids.items()))
    return ids


def cmd_run(args, journal: Journal) -> None:
    state_dir = Path(args.state_dir).expanduser()
    api = Api(args.base_url)
    preflight_service(api, journal)
    runner = AgentRunner(state_dir, journal, args.dry_run)
    problem = runner.preflight()
    if problem:
        raise SystemExit(problem)

    st = RunState(api=api, runner=runner, journal=journal,
                  max_api_usd=args.max_api_usd, dry_run=args.dry_run)
    journal.rotate_if_completed_run()
    journal.ledger["runs"].append({"started_at": iso(utcnow()), "dry_run": args.dry_run,
                                   "base_url": args.base_url, "db": str(args.db)})
    journal.flush()
    journal.event("run_start", dry_run=args.dry_run, base_url=args.base_url,
                  max_api_usd=args.max_api_usd, db=str(args.db))

    ids = seed(st)   # idempotent; adopts

    for spec in SEEDED_JOBS:
        job_id = ids[spec.key]
        if st.budget_stopped:
            defer_remaining(st, spec, job_id, "mvp budget stop")
            continue
        try:
            summary = run_ladder(st, spec, job_id)
        except ApiError as e:
            journal.event("job_api_error", job_key=spec.key, job_id=job_id, detail=str(e))
            print(f"ERROR on job {spec.key} ({job_id}): {e}", file=sys.stderr)
            continue
        journal.event("job_summary", job_key=spec.key, **{
            k: v for k, v in summary.items() if k != "response"})
        if summary.get("outcome") == "budget_stopped":
            st.budget_stopped = True
            journal.ledger["budget_stopped"] = True
            journal.flush()

    if st.budget_stopped:
        print(f"budget stop: API spend ${st.spend:.4f} exceeded --max-api-usd {args.max_api_usd}; "
              f"remaining work was deferred for 24h.", file=sys.stderr)

    kb = kb_pass(st, state_dir) if not st.budget_stopped else {"outcome": "skipped_budget_stop"}

    report_path = Path(args.report).expanduser()
    corpus_path = Path(kb["corpus_path"]) if kb.get("corpus_path") else None
    create_human_review(st, report_path, corpus_path)

    journal.ledger["spend_api_usd"] = round(st.spend, 6)
    journal.flush()
    journal.event("run_complete", spend_api_usd=round(st.spend, 6),
                  budget_stopped=st.budget_stopped, kb_outcome=kb.get("outcome"))


def cmd_report(args, journal: Journal) -> None:
    path = write_report(args, journal)
    print(f"report: {path}")


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--base-url", default=DEFAULT_BASE_URL,
                        help=f"the job-queue service's base URL (default {DEFAULT_BASE_URL})")
    common.add_argument("--db", default=str(DEFAULT_DB),
                        help=f"SQLite file the service is using (default {DEFAULT_DB})")
    common.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR),
                        help=f"kb corpus, prompts, raw envelopes, orchestrator.log (default {DEFAULT_STATE_DIR})")
    common.add_argument("--report", default=str(DEFAULT_REPORT),
                        help=f"report path (default {DEFAULT_REPORT})")
    common.add_argument("--max-api-usd", type=float, default=5.0,
                        help="cumulative API-lane spend guard in dollars (default 5.0)")
    common.add_argument("--dry-run", action="store_true",
                        help="no claude-api-agent calls and no spend: replay canned responses "
                             "through the real acceptance checks")

    p = argparse.ArgumentParser(
        prog="queue_mvp.py",
        description="End-to-end MVP: agents working a durable job-queue service.",
        epilog="With no subcommand, `all` runs (seed + run + report).")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("seed", parents=[common], help="create the mock jobs (idempotent; 409 adopts)")
    sub.add_parser("run", parents=[common], help="orchestrate the seeded pending jobs")
    sub.add_parser("report", parents=[common], help="regenerate the report from the DB and state dir")
    sub.add_parser("all", parents=[common], help="seed + run + report (default)")
    return p


def main(argv: list[str]) -> int:
    args_in = list(argv)
    if not args_in or args_in[0].startswith("-"):
        args_in = ["all"] + args_in
    args = build_parser().parse_args(args_in)

    state_dir = Path(args.state_dir).expanduser()
    journal = Journal(state_dir)

    try:
        if args.cmd == "seed":
            cmd_seed(args, journal)
        elif args.cmd == "run":
            cmd_run(args, journal)
            cmd_report(args, journal)
        elif args.cmd == "report":
            cmd_report(args, journal)
        else:  # all
            cmd_run(args, journal)
            cmd_report(args, journal)
    except ApiError as e:
        journal.event("fatal_api_error", detail=str(e))
        print(f"FATAL: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        journal.event("interrupted", detail="SIGINT; leases will be reclaimed by the sweeper on expiry")
        print("\ninterrupted; state is durable — re-run `run` to resume.", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))