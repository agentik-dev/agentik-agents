# ---------------------------------------------------------------------------
# Canned responses for --dry-run (these exercise the REAL acceptance functions)
# ---------------------------------------------------------------------------

CANNED_C_PATCH = """--- a/tests/test_link_flap.py
+++ b/tests/test_link_flap.py
@@ -1,6 +1,20 @@
+import time
+
+
+def wait_until(predicate, timeout_s, interval_s=0.5):
+    \"\"\"Poll predicate until true or the deadline passes.\"\"\"
+    deadline = time.monotonic() + timeout_s
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        time.sleep(interval_s)
+    return predicate()
+
+
 def test_link_flap(dut):
     dut.shell("config interface shutdown Ethernet0")
-    time.sleep(30)   # wait for BGP to notice
+    assert wait_until(lambda: not dut.bgp_established(), timeout_s=30), \\
+        "BGP did not notice the shutdown within the 30s bound"
     dut.shell("config interface startup Ethernet0")
-    time.sleep(60)   # wait for reconvergence  <- flaky on loaded hosts
-    assert dut.bgp_established(), "BGP did not reconverge in 60s"
+    reconverged = wait_until(dut.bgp_established, timeout_s=60)
+    assert reconverged, "BGP did not reconverge within the 60s bound"
"""

