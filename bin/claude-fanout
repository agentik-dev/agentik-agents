#!/usr/bin/env python3
"""claude-fanout — run delegated claude-api-agent shards under one hard budget.

Why this exists
---------------
`--max-budget-usd` is per-process. Eight shards at the default $10 ceiling is an
$80 exposure, not $10. This orchestrator holds a single pool and refuses to
launch work it cannot pay for, so the aggregate is bounded by construction
rather than by hoping each shard behaves.

It also refuses to trust `is_error: false`. A measured fan-out produced two
shards that ran 8-10 turns, cost $1.02 combined, and returned schema-valid
placeholder output (`{"summary":"test","findings":[{"file":"a",...}]}`) while
the envelope reported success. `--json-schema` validates shape, not content, so
every result is checked for substance before it counts as an answer.

Budget accounting
-----------------
Each shard reserves from the pool before it launches and settles at its actual
cost when it finishes:

    available = budget - (sum of in-flight reserves) - (sum of settled costs)

so `settled + in-flight reserves <= budget` at all times. A shard that cannot
get a viable reserve is not launched at all -- it is reported as skipped, never
silently dropped.

The per-shard cap handed to the wrapper is deflated by OVERSHOOT_FACTOR because
the ceiling is evaluated *between* model requests: the request that crosses it
still completes, and a measured $0.01 cap spent $0.0117 (1.2x). Deflating keeps
the aggregate honest even when individual shards overshoot their own cap.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import pathlib
import re
import shlex
import signal
import subprocess
import sys
import threading
import time

# A shard's own ceiling is checked between requests, so the request that trips
# it still completes. Measured overshoot was 1.2x; carry margin above that.
OVERSHOOT_FACTOR = 1.35

# Below this ceiling a shard cannot do useful work, and a run that trips its
# ceiling returns nothing while still costing money -- so declining to launch
# is strictly cheaper than launching something doomed.
MIN_VIABLE_SHARD_USD = 0.05

# The pool grants reservations, but a shard's real ceiling is its reservation
# deflated by OVERSHOOT_FACTOR. Viability must be judged on the ceiling, so the
# floor is expressed as the reservation needed to fund a viable ceiling.
MIN_VIABLE_RESERVATION_USD = MIN_VIABLE_SHARD_USD * OVERSHOOT_FACTOR

# Measured cost range for `review` shards over an ~850-line file: $0.20-$0.71
# across eight runs, median ~$0.31. Used only to warn when a fan-out is funded
# below the level at which shards have historically completed. Other profiles
# have no comparable measurement, so no advisory is offered for them.
MEASURED_SHARD_USD = {"review": (0.20, 0.71)}

# Substance thresholds for the content check. A degenerate shard produced a
# 4-character summary, so these are set well above that but below anything a
# real answer has looked like.
MIN_SUMMARY_CHARS = 40
MIN_PROSE_CHARS = 80
MIN_ISSUE_CHARS = 25

PLACEHOLDER_TOKENS = {
    "test", "todo", "tbd", "example", "placeholder", "foo", "bar", "n/a",
    "none", "sample", "dummy", "xxx", "lorem ipsum", "summary", "string",
}

STATUS_OK = "ok"
STATUS_DEGENERATE = "degenerate"
STATUS_ERROR = "error"
STATUS_BUDGET = "budget_exhausted"
STATUS_SKIPPED = "skipped_budget"
STATUS_TIMEOUT = "timeout"
STATUS_UNPARSEABLE = "unparseable"
STATUS_INTERRUPTED = "interrupted"

# Statuses where the shard produced a usable answer.
GOOD = {STATUS_OK}


def eprint(msg: str = "") -> None:
    print(msg, file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
# Live subprocess registry.
#
# Without this, Ctrl-C tears down the thread pool but leaves every in-flight
# `claude` process running and billing -- the exact runaway this tool exists to
# prevent. Every child is registered so an interrupt can terminate all of them.
# ---------------------------------------------------------------------------
_procs: set[subprocess.Popen] = set()
_procs_lock = threading.Lock()
_shutdown = threading.Event()


def _register(proc: subprocess.Popen) -> bool:
    """Register a child, or refuse if shutdown has begun.

    kill_all() sets _shutdown and snapshots _procs under the same lock, so a
    child registered here is either in that snapshot (and will be killed) or
    refused (and the caller must kill it). There is no interleaving in which a
    child slips past the sweep and is left running -- the D4 race.
    """
    with _procs_lock:
        if _shutdown.is_set():
            return False
        _procs.add(proc)
        return True


def _unregister(proc: subprocess.Popen) -> None:
    with _procs_lock:
        _procs.discard(proc)


def kill_all(sig_desc: str = "interrupt") -> int:
    """Terminate every in-flight delegate. Returns how many were killed."""
    _shutdown.set()
    with _procs_lock:
        live = [p for p in _procs if p.poll() is None]
    for p in live:
        try:
            p.terminate()
        except Exception:
            pass
    deadline = time.time() + 5
    for p in live:
        try:
            p.wait(timeout=max(0.1, deadline - time.time()))
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
    if live:
        eprint(f"\nclaude-fanout: {sig_desc} — terminated {len(live)} in-flight "
               "delegate(s). Spend up to that point is forfeited and unreported.")
    return len(live)


# ---------------------------------------------------------------------------
# Budget pool
# ---------------------------------------------------------------------------
class BudgetPool:
    """Hard aggregate ceiling. Reserve before launch, settle after."""

    def __init__(self, total: float) -> None:
        self.total = total
        self._settled = 0.0
        self._reserved = 0.0
        self._lock = threading.Lock()

    @property
    def available(self) -> float:
        with self._lock:
            return self.total - self._settled - self._reserved

    @property
    def settled(self) -> float:
        with self._lock:
            return self._settled

    def reserve(self, want: float) -> float:
        """Take up to `want` from the pool. Returns 0.0 if nothing viable.

        The floor is applied to the RESERVATION, but a shard's real ceiling is
        the reservation deflated by OVERSHOOT_FACTOR. Judging viability on the
        reservation would launch a $0.06 grant -> $0.044 ceiling, below the
        floor whose whole justification is that such a shard returns nothing
        and still costs money (the D3 gap). So the floor is expressed as the
        reservation it takes to fund a viable ceiling.
        """
        with self._lock:
            free = self.total - self._settled - self._reserved
            grant = min(want, free)
            if grant < MIN_VIABLE_RESERVATION_USD:
                return 0.0
            self._reserved += grant
            return grant

    def settle(self, reserved: float, actual: float) -> None:
        """Release a reservation and book what was actually spent."""
        with self._lock:
            self._reserved -= reserved
            # Actual spend counts even when it exceeded the reservation; the
            # pool must reflect money that left, not money we intended to spend.
            self._settled += max(0.0, actual)


# ---------------------------------------------------------------------------
# Result validation
# ---------------------------------------------------------------------------
def _looks_placeholder(text: str) -> bool:
    """True if `text` is a filler non-answer rather than real content.

    Deliberately NOT length-based. The earlier rule -- "any token of 12 chars
    or fewer with no whitespace or punctuation" -- flagged legitimate terse
    answers ('deadlock', 'use-after-free', a git SHA, 'TOCTOU') as placeholder.
    Every genuinely degenerate case the validator exists for is a filler token
    ("test", "a", "ok") or a stock phrase, so match those directly:

      - empty after stripping
      - a known filler token ("test", "todo", "foo", ...)
      - a single very short token (<=2 chars: "a", "x", "ok")
      - nothing alphanumeric at all ("--", "...", "???")

    A real short word like "deadlock" is none of these and passes.
    """
    t = (text or "").strip().lower().rstrip(".!?")
    if not t:
        return True
    if t in PLACEHOLDER_TOKENS:
        return True
    if not re.search(r"[a-z0-9]", t):
        return True
    if len(t) <= 2:
        return True
    return False


def _resolve_finding_path(raw: str, roots: list[str]) -> bool:
    """True if `raw` names a real file at or under one of the roots.

    Tightened from the old "any string with a '/' longer than 4 chars, or any
    absolute path that exists anywhere": the former let arbitrary prose pass as
    a citation, the latter accepted /etc/passwd. A citation now counts only if
    it resolves to an existing file within a root the run was actually given, so
    "no finding cites a real file" is a signal worth acting on.
    """
    if not raw:
        return False
    # Strip a trailing :line[:col] suffix -- findings are often "path:123".
    raw = re.sub(r":\d+(:\d+)?$", "", raw.strip())
    if not raw:
        return False
    roots_res = [pathlib.Path(r).resolve() for r in roots]
    candidates = []
    p = pathlib.Path(raw)
    if p.is_absolute():
        candidates.append(p)
    else:
        candidates += [pathlib.Path(r) / p for r in roots]
    for c in candidates:
        try:
            rc = c.resolve()
        except Exception:
            continue
        if not rc.exists():
            continue
        # Must sit within a provided root -- an absolute /etc/passwd does not.
        for root in roots_res:
            try:
                rc.relative_to(root)
                return True
            except ValueError:
                continue
    return False


def validate_structured(obj: dict, roots: list[str]) -> tuple[bool, list[str]]:
    """Content check for --json-schema profiles. Returns (ok, reasons).

    Rejects only what is genuinely a non-answer: not an object, a
    missing/placeholder summary, findings that are not a list, or a non-empty
    findings list in which NO finding cites a file that exists. Character-count
    thresholds are gone -- they only ever destroyed short-but-real answers
    (e.g. "No actionable defects found."), and every real degenerate case is
    caught by the placeholder or citation checks instead. A single terse
    finding no longer poisons the whole shard (the old V2 bug): substance is
    judged over the findings as a set, not per finding.
    """
    reasons: list[str] = []
    if not isinstance(obj, dict):
        return False, ["structured_output is not an object"]

    summary = obj.get("summary")
    if not isinstance(summary, str) or not summary.strip():
        reasons.append("summary is missing or empty")
    elif _looks_placeholder(summary):
        reasons.append("summary is placeholder text")

    findings = obj.get("findings")
    if not isinstance(findings, list):
        reasons.append("findings is not a list")
        return (not reasons), reasons

    # An empty findings list is a legitimate answer ("nothing actionable"),
    # judged only through the summary above.
    if findings:
        real_paths = sum(
            1 for f in findings
            if isinstance(f, dict) and _resolve_finding_path(str(f.get("file") or ""), roots)
        )
        if real_paths == 0:
            reasons.append(
                f"none of the {len(findings)} findings cite a file that exists "
                "under the reviewed roots")

    return (not reasons), reasons


def validate_prose(text: str) -> tuple[bool, list[str]]:
    """Content check for prose profiles. Rejects only empty or placeholder
    output -- no length threshold, since a correct answer can be one line
    (e.g. an `explore` run answering "bin/claude-costs:78")."""
    t = (text or "").strip()
    if not t:
        return False, ["result is empty"]
    if _looks_placeholder(t):
        return False, ["result is placeholder text"]
    return True, []


def classify(envelope: dict | None, raw_rc: int, roots: list[str],
             structured: bool) -> tuple[str, list[str]]:
    """Map a finished shard onto a status plus human-readable reasons."""
    if envelope is None:
        return STATUS_UNPARSEABLE, [f"no JSON envelope (exit {raw_rc})"]

    terminal = envelope.get("terminal_reason")
    if terminal == "budget_exhausted":
        return STATUS_BUDGET, ["shard hit its own ceiling; result discarded"]

    # `subtype` reports "success" even on an API error, so it is never a
    # success signal. is_error and terminal_reason are the reliable ones.
    if envelope.get("is_error"):
        detail = str(envelope.get("result") or "").strip()[:200]
        return STATUS_ERROR, [f"{terminal or 'error'}: {detail}" if detail else str(terminal)]

    if structured:
        so = envelope.get("structured_output")
        if so is None:
            return STATUS_DEGENERATE, ["no structured_output in a --json-schema run"]
        ok, reasons = validate_structured(so, roots)
    else:
        ok, reasons = validate_prose(str(envelope.get("result") or ""))

    return (STATUS_OK if ok else STATUS_DEGENERATE), reasons


# ---------------------------------------------------------------------------
# Shard execution
# ---------------------------------------------------------------------------
class Shard:
    def __init__(self, index: int, label: str, prompt: str) -> None:
        self.index = index
        self.label = label
        self.prompt = prompt
        self.status = STATUS_SKIPPED
        self.reasons: list[str] = []
        self.cost = 0.0
        self.cost_is_estimate = False
        self.reserved = 0.0
        self.turns = 0
        self.duration_s = 0.0
        self.session_id = None
        self.denied_tools: list[str] = []
        self.findings: list[dict] = []
        self.result_text = ""
        self.envelope_path = None

    def to_dict(self) -> dict:
        return {
            "index": self.index,
            "label": self.label,
            "status": self.status,
            "reasons": self.reasons,
            "cost_usd": round(self.cost, 6),
            "cost_is_estimate": self.cost_is_estimate,
            "reserved_usd": round(self.reserved, 6),
            "turns": self.turns,
            "duration_s": round(self.duration_s, 1),
            "session_id": self.session_id,
            "denied_tools": self.denied_tools,
            "findings": self.findings,
            # Prose profiles (explore/analyze) return their answer here, not in
            # findings; without this the aggregate validated the answer and then
            # discarded it.
            "result_text": self.result_text,
            "envelope": self.envelope_path,
        }


def run_shard(shard: Shard, args, pool: BudgetPool, outdir: pathlib.Path,
              wrapper: str, roots: list[str], counter: dict) -> Shard:
    if _shutdown.is_set():
        shard.status = STATUS_INTERRUPTED
        shard.reasons = ["not launched: fan-out was interrupted"]
        return shard

    want = args.max_shard_usd if args.max_shard_usd else pool.total
    grant = pool.reserve(min(want, pool.total))
    if grant <= 0.0:
        shard.status = STATUS_SKIPPED
        shard.reasons = [
            f"only ${pool.available:.4f} left of ${pool.total:.2f}; a shard "
            f"needs a ${MIN_VIABLE_RESERVATION_USD:.4f} reservation to fund the "
            f"${MIN_VIABLE_SHARD_USD:.2f} minimum ceiling"
        ]
        with counter["lock"]:
            counter["done"] += 1
            eprint(f"  [{counter['done']}/{counter['total']}] SKIP  {shard.label}"
                   f"  — {shard.reasons[0]}")
        return shard

    shard.reserved = grant
    shard_cap = grant / OVERSHOOT_FACTOR

    # Stamp attribution before the profile so the wrapper's leading-option
    # parser sees it. Every shard carries the caller's id, so a fan-out's spend
    # can later be rolled up against whatever other runs share it -- a triage
    # step, a verify step, another fan-out.
    cmd = [wrapper]
    for k, v in (("id", args.id), ("phase", args.phase),
                 ("shard", shard.label)):
        if v:
            cmd += ["--tag", f"{k}={v}"]
    cmd += ["--profile", args.profile, "--no-stdin",
            "--max-budget-usd", f"{shard_cap:.4f}"]
    for d in args.add_dir:
        cmd += ["--add-dir", d]
    if args.model:
        cmd += ["--model", args.model]
    # args.claude_arg is already split and validated (no --max-budget-usd) by
    # split_claude_args() in main(), so a forwarded flag cannot contest the
    # per-shard ceiling and a quoting error cannot raise inside this thread.
    cmd += args.claude_arg
    cmd += ["-p", shard.prompt]

    env = dict(os.environ)
    # Overwrite, not setdefault: an operator who exported this for interactive
    # use would otherwise silently override every shard's ceiling (the D6 gap).
    # The authoritative cap is the --max-budget-usd on argv; this env var is
    # belt-and-braces and must agree with it.
    env["CLAUDE_API_AGENT_BUDGET_USD"] = f"{shard_cap:.4f}"
    # Each shard's run.json names this fan-out (claude-agents status reads it).
    # Overwrite, so a caller's own value never misattributes the shards.
    env["CLAUDE_FANOUT_RUN"] = args.fanout_run

    with counter["lock"]:
        eprint(f"  launch {shard.label}  cap=${shard_cap:.4f}  "
               f"pool_left=${pool.available:.4f}")

    started = time.time()
    stdout_path = outdir / f"shard-{shard.index:02d}-{_slug(shard.label)}.json"
    stderr_path = outdir / f"shard-{shard.index:02d}-{_slug(shard.label)}.err"

    envelope = None
    rc = -1
    timed_out = False
    interrupted = False
    launched = False          # a claude child process actually existed
    proc = None
    out = err = ""
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, env=env)
        launched = True       # Popen only returns on a successful exec
        if not _register(proc):
            # kill_all() already swept; this child is ours to terminate.
            interrupted = True
            try:
                proc.terminate()
                proc.wait(timeout=5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        else:
            try:
                out, err = proc.communicate(
                    timeout=args.timeout_sec if args.timeout_sec > 0 else None)
            except subprocess.TimeoutExpired:
                proc.kill()
                out, err = proc.communicate()
                timed_out = True
            rc = proc.returncode
            stdout_path.write_text(out or "")
            stderr_path.write_text(err or "")
            if not timed_out:
                try:
                    start = (out or "").find("{")
                    if start >= 0:
                        envelope = json.loads(out[start:], strict=False)
                except Exception:
                    envelope = None
            # A shard killed by kill_all() looks like a normal exit with no
            # envelope; distinguish it so it is not reported as a model failure.
            if _shutdown.is_set() and envelope is None and not timed_out:
                interrupted = True
    except Exception as exc:  # pragma: no cover - defensive
        shard.reasons = [f"failed to launch: {exc}"]
    finally:
        if proc is not None:
            _unregister(proc)

    shard.duration_s = time.time() - started
    shard.envelope_path = str(stdout_path) if stdout_path.exists() else None

    # Everything that charges the pool runs in one finally, so no path -- a
    # malformed cost field, a bug in classify(), a raising thread -- can return
    # from run_shard with the reservation still held. A leaked reservation is
    # permanent: nothing else ever releases it (the D2 gap).
    booked = None
    try:
        if timed_out or interrupted:
            shard.status = STATUS_TIMEOUT if timed_out else STATUS_INTERRUPTED
            shard.reasons = [
                (f"exceeded --timeout-sec {args.timeout_sec}; killed mid-run. "
                 if timed_out else "terminated by interrupt. ")
                + "Spend up to that point is forfeited and unreported."
            ]
            booked = shard.cost = grant
            shard.cost_is_estimate = True
        else:
            cost = _as_float(envelope.get("total_cost_usd"), default=None) \
                if envelope else None
            if envelope:
                shard.turns = _as_int(envelope.get("num_turns"))
                shard.session_id = envelope.get("session_id")
                denials = envelope.get("permission_denials")
                shard.denied_tools = sorted({
                    d.get("tool_name")
                    for d in (denials if isinstance(denials, list) else [])
                    if isinstance(d, dict) and d.get("tool_name")
                })

            if cost is not None:
                booked = shard.cost = cost
            elif not launched:
                # exec never happened, so no request was made -- the one case
                # where zero is a measurement, not an assumption.
                booked = shard.cost = 0.0
            else:
                # A child ran and left no usable cost figure. Charging the full
                # reservation is the only booking that cannot under-state: zero
                # would let a failed shard re-fund the pool with money that
                # already left (the D1 gap). Same rule as the timeout path.
                booked = shard.cost = grant
                shard.cost_is_estimate = True

            structured = args.profile in ("review",)
            shard.status, shard.reasons = classify(envelope, rc, roots, structured)
            if shard.cost_is_estimate:
                shard.reasons.append(
                    f"no usable total_cost_usd; charged the ${grant:.4f} "
                    "reservation as an upper-bound estimate of real spend")
            if envelope and structured:
                so = envelope.get("structured_output") or {}
                if isinstance(so, dict) and isinstance(so.get("findings"), list):
                    shard.findings = so["findings"]
                    shard.result_text = str(so.get("summary") or "")
            elif envelope:
                shard.result_text = str(envelope.get("result") or "")
    finally:
        # If we never got far enough to decide, book the reservation -- the
        # safe side of the one-way invariant.
        pool.settle(grant, grant if booked is None else booked)

    with counter["lock"]:
        counter["done"] += 1
        mark = "ok  " if shard.status in GOOD else shard.status.upper()
        extra = f"{len(shard.findings)} findings" if shard.findings else ""
        note = "" if shard.status in GOOD else f"  — {'; '.join(shard.reasons)[:160]}"
        eprint(f"  [{counter['done']}/{counter['total']}] {mark}  {shard.label}"
               f"  ${shard.cost:.4f}  {shard.turns}t  {shard.duration_s:.0f}s  "
               f"{extra}{note}")
    return shard


def _slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "shard"


def _as_float(value, default=0.0):
    """Coerce an envelope field to a FINITE float. Never raises.

    json.loads accepts NaN/Infinity literals by default; either would poison
    the pool permanently -- NaN makes every comparison in reserve() false, so
    every later shard launches with a `--max-budget-usd nan` ceiling.
    """
    try:
        f = float(value)
    except (TypeError, ValueError):
        return default
    if f != f or f in (float("inf"), float("-inf")):
        return default
    return f


def _as_int(value, default=0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


_BUDGET_FLAG_RE = re.compile(r"^--max-budget-usd(=|$)")


def split_claude_args(extras: list[str]) -> list[str]:
    """Split --claude-arg strings, rejecting anything that would contest the
    per-shard ceiling.

    Done here in main() for two reasons: shlex.split() raises on unbalanced
    quotes, which inside a worker thread would merely be printed while the
    reservation leaked; and a forwarded --max-budget-usd would put a second
    ceiling into the wrapper's argument list, leaving the per-shard cap
    dependent on how a repeated flag resolves (the D5 gap).
    """
    out: list[str] = []
    for extra in extras:
        try:
            toks = shlex.split(extra)
        except ValueError as exc:
            raise SystemExit(f"claude-fanout: cannot parse --claude-arg {extra!r}: {exc}")
        for tok in toks:
            if _BUDGET_FLAG_RE.match(tok):
                raise SystemExit(
                    "claude-fanout: --claude-arg may not carry --max-budget-usd; "
                    "the per-shard ceiling is derived from the pool. Use "
                    "--max-shard-usd or --budget-usd instead.")
        out.extend(toks)
    return out


# ---------------------------------------------------------------------------
# Task loading
# ---------------------------------------------------------------------------
def load_tasks(args) -> list[Shard]:
    shards: list[Shard] = []
    if args.tasks:
        raw = pathlib.Path(args.tasks).read_text()
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            data = [ln for ln in (l.strip() for l in raw.splitlines())
                    if ln and not ln.startswith("#")]
        if isinstance(data, dict):
            data = data.get("tasks", [])
        for i, item in enumerate(data):
            if isinstance(item, str):
                shards.append(Shard(i, f"task{i + 1}", item))
            elif isinstance(item, dict):
                if "prompt" not in item:
                    raise SystemExit(
                        f"claude-fanout: task {i} in {args.tasks} has no 'prompt' key")
                shards.append(Shard(i, str(item.get("label") or f"task{i + 1}"),
                                    str(item["prompt"])))
            else:
                raise SystemExit(
                    f"claude-fanout: task {i} in {args.tasks} is neither a string nor an object")
    for i, p in enumerate(args.prompt, start=len(shards)):
        shards.append(Shard(i, f"task{i + 1}", p))
    return shards


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> int:
    ap = argparse.ArgumentParser(
        prog="claude-fanout",
        description="Run claude-api-agent shards concurrently under one hard budget.",
        epilog="The budget is a ceiling on the whole fan-out, not per shard. "
               "Shards that cannot be funded are reported as skipped, never dropped.",
    )
    ap.add_argument("--budget-usd", type=float, required=True,
                    help="hard ceiling for the entire fan-out (required)")
    ap.add_argument("--max-shard-usd", type=float, default=0.0,
                    help="per-shard reservation cap (default: budget/ntasks)")
    ap.add_argument("--profile", default="review",
                    choices=("review", "explore", "analyze"))
    ap.add_argument("-j", "--jobs", type=int, default=4, help="concurrent shards")
    ap.add_argument("--tasks", help="JSON array / JSONL / plain-text prompts file")
    ap.add_argument("prompt", nargs="*", help="prompts given directly")
    ap.add_argument("--add-dir", action="append", default=[],
                    help="passed through to the delegate (repeatable)")
    ap.add_argument("--model", default="", help="override the profile's model")
    ap.add_argument("--claude-arg", action="append", default=[],
                    help="extra argument string forwarded verbatim (repeatable)")
    ap.add_argument("--timeout-sec", type=int, default=0,
                    help="kill a shard after N seconds (0 = no limit). "
                         "A killed shard forfeits its spend.")
    ap.add_argument("--stagger-sec", type=float, default=0.0,
                    help="delay between launches")
    ap.add_argument("--id", dest="id", metavar="VALUE",
                    help="correlation id stamped on every shard, so this "
                         "fan-out's spend can be rolled up with any other run "
                         "tagged the same. Pass whatever identifier the caller "
                         "already has (CI job, incident, ticket, experiment). "
                         "Default: the run stamp.")
    ap.add_argument("--phase", help="phase label for these shards "
                                    "(default: the profile name)")
    ap.add_argument("--out", help="run directory (default: ./fanout-runs/<stamp>)")
    ap.add_argument("--json", action="store_true",
                    help="write the aggregate JSON to stdout")
    ap.add_argument("--dry-run", action="store_true",
                    help="plan and budget only; launch nothing")
    args = ap.parse_args()

    if args.budget_usd <= 0:
        eprint("claude-fanout: --budget-usd must be positive")
        return 2

    shards = load_tasks(args)
    if not shards:
        eprint("claude-fanout: no tasks given (use --tasks FILE or positional prompts)")
        return 2

    # Split and validate --claude-arg now, in the main thread: a quoting error
    # or a forwarded --max-budget-usd must surface here as a clean exit, not
    # inside a worker where it would leak a reservation.
    args.claude_arg = split_claude_args(args.claude_arg)

    repo_root = pathlib.Path(__file__).resolve().parent.parent
    wrapper = os.environ.get("CLAUDE_FANOUT_WRAPPER") or str(repo_root / "bin" / "claude-api-agent")
    if not os.access(wrapper, os.X_OK):
        eprint(f"claude-fanout: wrapper not executable: {wrapper}")
        return 2

    if not args.max_shard_usd:
        args.max_shard_usd = args.budget_usd / len(shards)

    roots = [os.path.abspath(d) for d in args.add_dir] or [os.getcwd()]

    stamp = time.strftime("%Y%m%dT%H%M%S") + f"-{os.getpid()}"
    args.fanout_run = stamp
    if not args.id:
        args.id = stamp
    if not args.phase:
        args.phase = args.profile
    outdir = pathlib.Path(args.out or (repo_root / "fanout-runs" / stamp))
    outdir.mkdir(parents=True, exist_ok=True)

    eprint(f"claude-fanout: {len(shards)} shards, profile={args.profile}, "
           f"jobs={args.jobs}")
    eprint(f"  budget ${args.budget_usd:.2f} total, "
           f"${args.max_shard_usd:.4f}/shard reservation "
           f"(shard ceiling ${args.max_shard_usd / OVERSHOOT_FACTOR:.4f} after "
           f"{OVERSHOOT_FACTOR}x overshoot margin)")
    eprint(f"  run dir: {outdir}")
    eprint(f"  tagged:  id={args.id} phase={args.phase}")

    ceiling = args.max_shard_usd / OVERSHOOT_FACTOR
    lo = (MEASURED_SHARD_USD.get(args.profile) or (None, None))[0]
    if ceiling < MIN_VIABLE_SHARD_USD:
        eprint(f"  WARNING: per-shard ceiling ${ceiling:.4f} is below the "
               f"${MIN_VIABLE_SHARD_USD:.2f} minimum. A shard that trips its "
               "ceiling returns NOTHING and still costs money, so this is "
               "likely to waste the whole budget. Raise --budget-usd, reduce "
               "the task count, or set --max-shard-usd deliberately.")
    elif lo is not None and ceiling < lo:
        eprint(f"  NOTE: per-shard ceiling ${ceiling:.4f} is below the ${lo:.2f} "
               f"low end of measured {args.profile} shard cost. Shards that trip "
               "it return nothing, so consider funding fewer shards well rather "
               "than many poorly.")

    if args.dry_run:
        eprint("  --dry-run: launching nothing")
        plan = {"shards": [{"label": s.label, "prompt": s.prompt} for s in shards],
                "budget_usd": args.budget_usd,
                "per_shard_reservation_usd": args.max_shard_usd,
                "per_shard_ceiling_usd": args.max_shard_usd / OVERSHOOT_FACTOR}
        print(json.dumps(plan, indent=2))
        return 0

    pool = BudgetPool(args.budget_usd)
    counter = {"lock": threading.Lock(), "done": 0, "total": len(shards)}
    started = time.time()

    # Signal handling, not `except KeyboardInterrupt`.
    #
    # Two reasons the exception route does not work here. The worker threads
    # block in Popen.communicate(), which no exception in the main thread can
    # interrupt, and ThreadPoolExecutor's context manager joins those threads
    # on the way out -- so the handler would not run until every delegate had
    # finished anyway. And the signal reaches only this process; the delegates
    # are separate children and keep billing regardless.
    #
    # Killing the children from the handler makes communicate() return, the
    # pool drains on its own, and the run reports what actually completed.
    state = {"interrupted": False}

    def _on_signal(signum, _frame):
        if state["interrupted"]:
            return  # a second signal: the first kill sweep is already running
        state["interrupted"] = True
        kill_all(f"signal {signal.Signals(signum).name}")

    prev_int = signal.signal(signal.SIGINT, _on_signal)
    prev_term = signal.signal(signal.SIGTERM, _on_signal)
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as ex:
            futures = []
            for s in shards:
                futures.append(ex.submit(run_shard, s, args, pool, outdir,
                                         wrapper, roots, counter))
                if args.stagger_sec and not state["interrupted"]:
                    time.sleep(args.stagger_sec)
            done = []
            for f in futures:
                try:
                    done.append(f.result())
                except Exception as exc:  # pragma: no cover - defensive
                    eprint(f"  shard raised (this is a claude-fanout bug; the "
                           f"reservation was released in run_shard's finally): {exc}")
    finally:
        signal.signal(signal.SIGINT, prev_int)
        signal.signal(signal.SIGTERM, prev_term)

    # Every task is accounted for even on an abort: a shard whose future never
    # produced a result still appears, with whatever status it reached.
    seen = {id(s) for s in done}
    done += [s for s in shards if id(s) not in seen]
    interrupted = state["interrupted"]

    elapsed = time.time() - started

    by_status: dict[str, int] = {}
    for s in done:
        by_status[s.status] = by_status.get(s.status, 0) + 1

    usable = [s for s in done if s.status in GOOD]
    all_findings = [dict(f, _shard=s.label) for s in usable for f in s.findings]
    wasted = sum(s.cost for s in done if s.status not in GOOD)

    aggregate = {
        "profile": args.profile,
        "id": args.id,
        "phase": args.phase,
        "budget_usd": args.budget_usd,
        "spent_usd": round(pool.settled, 6),
        # spent_usd includes reservation-based estimates for shards that ran
        # without a usable cost figure, so it is an upper bound, not a
        # measurement, whenever any shard was charged an estimate.
        "spent_usd_is_upper_bound": any(s.cost_is_estimate for s in done),
        "estimated_usd": round(sum(s.cost for s in done if s.cost_is_estimate), 6),
        "wasted_usd": round(wasted, 6),
        "elapsed_s": round(elapsed, 1),
        "shards_total": len(done),
        "shards_by_status": by_status,
        "findings_total": len(all_findings),
        "run_dir": str(outdir),
        "shards": [s.to_dict() for s in done],
        "findings": all_findings,
    }
    (outdir / "fanout.json").write_text(json.dumps(aggregate, indent=2))

    if interrupted:
        eprint("  INTERRUPTED — results below cover only what completed.")

    eprint("")
    eprint(f"  spent ${pool.settled:.4f} of ${args.budget_usd:.2f} "
           f"({100 * pool.settled / args.budget_usd:.0f}%) in {elapsed:.0f}s")
    if wasted > 0:
        eprint(f"  ${wasted:.4f} of that produced no usable answer "
               f"({100 * wasted / max(pool.settled, 1e-9):.0f}% of spend)")
    eprint("  " + "  ".join(f"{k}={v}" for k, v in sorted(by_status.items())))
    denials = sorted({t for s in done for t in s.denied_tools})
    if denials:
        eprint(f"  delegates attempted disallowed tools: {', '.join(denials)}")
    eprint(f"  aggregate: {outdir / 'fanout.json'}")

    if args.json:
        print(json.dumps(aggregate, indent=2))

    # Non-zero when any shard failed to produce a usable answer, so a caller
    # can gate on it without parsing.
    if interrupted:
        return 130
    return 0 if len(usable) == len(done) else 1


if __name__ == "__main__":
    sys.exit(main())
