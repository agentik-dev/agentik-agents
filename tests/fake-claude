#!/usr/bin/python3
"""fake-claude: a stand-in for the CLI in the API lane's suites (row al1, R10).

It never makes a request. A suite puts it first on a PATH built from nothing (a link
named `claude` to this file) and reads its scripted mode and its record path from the
prompt on stdin, since the lane hands the child an allow-listed environment that carries
no test variable. Two prompt lines steer it:

    fake-mode: cost | nocost | empty | placeholder | abort | echo | sleep | garbage |
               crash | error | nan
    fake-record: /absolute/path.json

It writes the record (its argv, its environment, its stdin, its cwd, pid and process
group, and in `sleep` mode its grandchild's pid) before it answers, then prints a
result envelope the way `--output-format json` does. With `--json-schema` in its argv it
answers with a `structured_output`, citing the first file under its first `--add-dir`.
"""
import json
import os
import subprocess
import sys
import time

COST = 0.0421
BILLED_AT_ABORT = 0.0117


def directive(text, name):
    for line in text.splitlines():
        if line.startswith(name + ":"):
            return line.split(":", 1)[1].strip()
    return None


def first_file(argv):
    for i, a in enumerate(argv):
        if a == "--add-dir" and i + 1 < len(argv):
            root = argv[i + 1]
            for name in sorted(os.listdir(root)):
                if os.path.isfile(os.path.join(root, name)):
                    return name
    return "missing.py"


def main():
    argv = sys.argv[1:]
    stdin = sys.stdin.read()
    mode = directive(stdin, "fake-mode") or "cost"
    record = directive(stdin, "fake-record")
    structured = "--json-schema" in argv
    rec = {"argv": sys.argv, "env": dict(os.environ), "stdin": stdin,
           "cwd": os.getcwd(), "pid": os.getpid(), "pgid": os.getpgid(0),
           "mode": mode, "grandchild": None}
    if mode == "sleep":
        child = subprocess.Popen(["/bin/sleep", "300"])
        rec["grandchild"] = child.pid
    if record:
        with open(record, "w") as f:
            json.dump(rec, f)
    if mode == "sleep":
        time.sleep(300)
        return 0
    if mode == "crash":
        return 3
    if mode == "garbage":
        sys.stdout.write("not json at all\n")
        return 7
    env = {"type": "result", "subtype": "success", "is_error": False,
           "terminal_reason": "completed", "session_id": "fake-session",
           "total_cost_usd": COST, "num_turns": 3, "permission_denials": [],
           "usage": {}, "modelUsage": {}}
    rc = 0
    if mode == "nocost":
        del env["total_cost_usd"]
    if mode in ("cost", "nocost"):
        if structured:
            env["structured_output"] = {
                "summary": "One defect: the reader closes its file twice on the error path.",
                "findings": [{"file": first_file(argv), "line": 1, "severity": "low",
                              "issue": "the file handle is closed twice on the error path"}]}
        else:
            env["result"] = "The answer is in a.py at line 1, where the reader opens it."
    elif mode == "empty":
        env["result"] = ""
    elif mode == "placeholder":
        if structured:
            env["structured_output"] = {"summary": "test", "findings": [
                {"file": "a", "severity": "low", "issue": "test"}]}
        else:
            env["result"] = "test"
    elif mode == "abort":
        env.update(is_error=True, subtype="error_max_budget_usd",
                   terminal_reason="budget_exhausted", result="",
                   total_cost_usd=BILLED_AT_ABORT)
        rc = 1
    elif mode == "echo":
        env["result"] = "Here is what I found: " + os.environ.get("ANTHROPIC_API_KEY", "")
    elif mode == "error":
        env.update(is_error=True, terminal_reason="api_error", result="Invalid API key")
        rc = 1
    if mode == "nan":
        sys.stdout.write('{"total_cost_usd": NaN, "num_turns": 3, "is_error": false, '
                         '"terminal_reason": "completed", "result": "A real answer, '
                         'with a.py cited at line 1."}\n')
        return 0
    sys.stdout.write(json.dumps(env) + "\n")
    sys.stderr.write("fake-claude: mode %s\n" % mode)
    return rc


if __name__ == "__main__":
    sys.exit(main())
