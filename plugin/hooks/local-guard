#!/bin/sh
# local-guard: the PreToolUse hook on the Agent tool (packet p1). An agents:local-* type runs on
# model local/default, which only the local router answers, so in a session not started by
# `agentik agents local` its call is denied here with one plain sentence instead of failing at
# the API. A loopback http ANTHROPIC_BASE_URL is such a session and passes at once; elsewhere
# the event is read only when it names agents:local-. Every other call passes with no output.
# Exit 0 always.
case ${ANTHROPIC_BASE_URL:-} in
http://127.0.0.1:* | http://localhost:* | http://\[::1\]:*) exit 0 ;;
esac
input=$(cat)
case $input in
*agents:local-*) ;;
*) exit 0 ;;
esac
py=/usr/bin/python3
[ -x "$py" ] || py=python3
printf '%s' "$input" | "$py" -I -c '
import json, sys
try:
    kind = json.load(sys.stdin)["tool_input"]["subagent_type"]
except Exception:
    sys.exit(0)
if isinstance(kind, str) and kind.startswith("agents:local-"):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": kind + " runs on the local model, which answers only in a "
        "session started by `agentik agents local`; this session was not, so nothing ran. "
        "Use a Claude model, or start the session with `agentik agents local`."}}))
' 2>/dev/null
exit 0
