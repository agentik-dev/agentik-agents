#!/bin/sh
# agentik-agents: the one command for the agents tools (agentik-r1 section 4.2).
#
#   agentik agents <verb> [args...]    through the agentik front door, or
#   agentik-agents <verb> [args...]    directly
#
# Each verb execs one of the tools beside this file, its args unchanged (the table
# in `--help`). The tools are found in this file's resolved directory (readlink -f),
# so the installed link runs the checkout's own copies. Exit: the tool's own code on
# dispatch; 0 for --help, help, --version and doctor (it reports, it does not gate);
# 2 for usage, no verb or an unknown one. POSIX sh, no interpreter. The API lane's verbs
# left with packet a-s17; design/04-api-lane.md says what they were.
VERSION=1.4.0

self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
here=$(CDPATH= cd -P -- "$(dirname -- "$self")" >/dev/null && pwd -P) || exit 2

usage() {
	echo "usage: agentik agents <verb> [args...] | agentik agents --help | --version" >&2
	echo "verbs: local status rig route doctor help" >&2
	exit 2
}

table() {
	cat <<EOF
usage: agentik agents <verb> [args...]

  verb                runs (beside this file)
  local ...           claude-local ...
  status ...          claude-agents status ...
  rig ...             localrig ...
  route ...           agentroute ...
  doctor              each tool on PATH, python3, the local lane's check

The old names on the right stay on PATH as aliases until 2026-12-31.
EOF
	exit 0
}

run() {
	tool=$1 && shift
	exec "$here/$tool" "$@"
}

# The interpreter row (portfolio entry 26): PATH's python3, its version against the floor
# (3.9), and the gate's pin, .python-version at the checkout's root above plugin/lib/, when the
# two differ. -I keeps a
# platform.py in the caller's directory or on PYTHONPATH out; the compare is sh. The pin is
# read as pyenv reads it: the first word of the first line not blank or a comment, CRs dropped.
python_row() {
	p=$(command -v python3 2>/dev/null) || { echo "NOT ON PATH"; return 0; }
	v=$(python3 -I -c 'import platform; print(platform.python_version())' 2>/dev/null) || v=
	maj=${v%%.*} min=${v#*.}
	min=${min%%[!0-9]*}
	case $maj in '' | *[!0-9]*) v= ;; esac
	case $v in [0-9]*.[0-9]*) ;; *) v= ;; esac
	[ -n "$v" ] || { echo "$p does not run"; return 0; }
	if [ "$maj" -lt 3 ] || { [ "$maj" -eq 3 ] && [ "$min" -lt 9 ]; }; then
		note="below 3.9"
	else
		note="3.9 or later"
	fi
	pin= vf=${here%/*/*}/.python-version
	if [ -r "$vf" ]; then
		while IFS=" 	$(printf '\r')" read -r w rest || [ -n "$w" ]; do
			case $w in '' | '#'*) continue ;; esac
			pin=$w && break
		done <"$vf"
	fi
	[ -z "$pin" ] || [ "$pin" = "$v" ] || note="$note; the gate pins $pin"
	echo "$p $v ($note)"
}

doctor() {
	for t in agentroute claude-local localrig claude-agents agentik-agents agentik; do
		p=$(command -v "$t" 2>/dev/null) || p=
		printf '  %-18s %s\n' "$t" "${p:-NOT ON PATH}"
	done
	printf '  %-18s %s\n' python3 "$(python_row)"
	echo ""
	echo "  Local lane:"
	"$here/agentroute" --check 2>&1 | sed 's/^/    /'
	echo ""
	echo "  doctor reports; it does not gate. For a script, use the verb that returns a"
	echo "  status: 'agentik agents route --check' exits non-zero on a FAIL row."
	exit 0
}

[ $# -gt 0 ] || usage
verb=$1 && shift
case $verb in
help | -h | --help)
	case $#:${1-} in
	0:) table ;;
	*) usage ;;
	esac
	;;
--version)
	[ $# -eq 0 ] || usage
	echo "agentik-agents $VERSION"
	exit 0
	;;
local) run claude-local "$@" ;;
status) run claude-agents status "$@" ;;
rig) run localrig "$@" ;;
route) run agentroute "$@" ;;
doctor)
	[ $# -eq 0 ] || usage
	doctor
	;;
*) usage ;;
esac
