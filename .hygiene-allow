# .hygiene-allow: <path-glob>: <group>[,<group>]; `*` stays inside one path segment.
# Read by scripts/hygiene (vendored from agentik-commons). No row excepts the owner's own
# terms except where public-r1 keeps them; a `sibling` row names a sibling tool, a `home`
# row a placeholder path, and a `renamed` row (agentik-r1 6.1) an old name kept on purpose.
# LICENSE's copyright line and plugin.json's author field carry the owner's name.
LICENSE: person
plugin/.claude-plugin/plugin.json: person
# The open items cite the session plugin's conventions doc by name.
NICE_TO_HAVE.md: sibling
# The README renderer's config path names the plugin that renders it.
.claude/respeak/config.yaml: sibling
# This file names the old names its rows except, and the sibling tools.
.hygiene-allow: renamed,sibling
# The Makefile's alias install lines: the eight tools keep their names until 2026-12-31;
# its readme lines find the renderer plugin that renders the README (a-s8).
Makefile: renamed,sibling
# The README renderer drives that plugin's scripts and names its install line (a-s8).
scripts/readme-render: sibling
# The tools: the eight are the aliases (their own names, usage, the files they run), the
# readers keep the old folders as fallbacks (6.3), and the dispatcher maps each verb to one.
plugin/lib/*: renamed
# The router forwards Claude Code's x-claude-code-session-id header, a name not ours, and
# the status tool falls back to the session plugin's old state folder (c1).
plugin/lib/agentroute: renamed,sibling
plugin/lib/claude-agents: renamed,sibling
# A local agent's description names a task kind, design decisions.
plugin/agents/local-implement.md: sibling

# The design records name the plugin and the siblings they read, one row per file.
design/01-local-agent-lane.md: sibling
design/02-local-rig.md: sibling
design/03-review-2026-09.md: sibling
design/03-review-2026-09/raw-findings.md: sibling
design/03-review-2026-09/raw-local-keys-setup.md: sibling
# Run records: they name the plugin's path, and the logs and the reminder dump carry the
# placeholder home of the stand-in user `you` (public-r1; no real user name).
design/01-local-agent-lane/e2e-live5.sh: sibling
design/01-local-agent-lane/live-e2e-2026-09-04.log: home,sibling
design/01-local-agent-lane/reminder-dump-summary-2026-09-04.json: home,sibling
design/01-local-agent-lane/wire-ledger-2026-09-04.jsonl: sibling
design/02-local-rig/rig-honest-2026-09-05.log: home,sibling
design/02-local-rig/rig-honest3-2026-09-05.log: home
design/02-local-rig/rig-llama-2026-09-05.log: home
design/02-local-rig/rig-mlx-2026-09-05.log: home
design/02-local-rig/rig-unsloth-misrouted-2026-09-05.log: home
# Each packet names the sibling plugins it reads or follows, one row per file; the spent
# ones are records, moved whole to design/packets/spent/ (a-s8).
design/packets/spent/a-s3-status.md: sibling
design/packets/spent/a-s4-layout.md: sibling
design/packets/spent/a-s5-status-api.md: sibling
design/packets/a-s8-conventions-two.md: sibling
# a-s14's section 4 names the two sibling tools the scan's sibling group finds.
design/packets/a-s14-scribe.md: sibling
# The doc gate, copied byte for byte from the session plugin, names the relay by its old
# repo name in a comment (pinned by DOCLINT_SHA in the Makefile; never edited here).
scripts/doclint: renamed
# Tests: they drive the tools under their alias names, cover the old folders as fallbacks,
# and the router's fixtures carry Claude Code's session header; the status fixtures put
# their session cwds in the home of an invented user, `x`.
tests/*: renamed
tests/test-route.py: renamed,sibling
tests/test-status.py: home,renamed,sibling
# The renderer's test fakes that plugin's scripts by their names (a-s8).
tests/test-readme.sh: sibling
# The API lane's note names the tools it records, at the commit they last stood (a-s17).
design/04-api-lane.md: renamed
# a-s17's section 1 quotes a review naming a sibling's verb; ruling 8 names the ledger file.
design/packets/a-s17-cut.md: sibling
# a-s18 names the sibling repos whose shape it follows.
design/packets/a-s18-plugin.md: sibling
